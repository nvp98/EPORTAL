            @{
                            PhanQuyenHTEntities dbP = new PhanQuyenHTEntities();
                            EPORTAL_REGISTEREntities db_dk = new EPORTAL_REGISTEREntities();
                            int IDQuyenHT = EPORTAL.Models.MyAuthentication.IDQuyenHT;
                            var ListQuyen = EPORTAL.Models.MyAuthentication.GroupQuyen;

                            // Cache listControll trong Session - permission hiem doi trong 1 session login.
                            // Key gom IDQuyenHT + GroupQuyen -> neu admin doi quyen, key thay, recompute.
                            // Default ASP.NET session expire 20 phut. Logout/relogin se reset.
                            var permCacheKey = "v360_listControll_" + IDQuyenHT + "_" + (ListQuyen ?? "");
                            var listControll = Session[permCacheKey] as List<string>;
                            if (listControll == null)
                            {
                                listControll = dbP.A_QuyenCT.Where(x => x.IDQuyenHT == IDQuyenHT)
                                    .Select(x => x.A_ListController.Controller).ToList();
                                if (!String.IsNullOrEmpty(ListQuyen))
                                {
                                    var grQuyen = ListQuyen.Split(',');
                                    foreach (var item in grQuyen)
                                    {
                                        int idq = Convert.ToInt32(item);
                                        var listControll2 = dbP.A_QuyenCT.Where(x => x.IDQuyenHT == idq)
                                            .Select(x => x.A_ListController.Controller).ToList();
                                        if (listControll2.Count > 0) { listControll.AddRange(listControll2); }
                                    }
                                }
                                Session[permCacheKey] = listControll;
                            }

                            var showquanTri = 0;
                            var showKH_REPORT = 0;
                            var showSoDoToChuc = 0;
                            var showsdtc = 0;
                            var showQuanLyTB = 0;
                            var showQuanLyPT = 0;
