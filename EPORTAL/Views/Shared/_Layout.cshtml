    <script>
        $(document).ready(function () {
            // Tooltip cho sidebar collapsed - copy text noi dung menu sang data-tooltip
            // de CSS hien thi tooltip khi user hover icon (layout-modern.css).
            $('.vertical-nav-menu li > a').each(function () {
                var $a = $(this);
                // Lay text noi (loai bo icon + caret), trim de tooltip sach
                var txt = $a.clone().children('i').remove().end().text().trim();
                if (txt) $a.attr('data-tooltip', txt);
            });

            // User profile pill: click outside anchor (vd name area) -> trigger native
            // click() tren anchor. PHAI stopPropagation cua original event de tranh
            // double-toggle (synthetic click bubble + original click bubble = 2 toggles).
            $('.app-header-right .header-btn-lg .widget-content-wrapper').on('click', function (e) {
                var trigger = $(this).find('a.btn[data-toggle="dropdown"]')[0];
                if (!trigger) return;
                // Click TRONG trigger anchor (avatar/img) - de BS xu ly tu nhien, no-op
                if (trigger === e.target || trigger.contains(e.target)) return;
                // Click ngoai trigger -> chan original event va fire native click tren trigger
                e.preventDefault();
                e.stopPropagation();
                trigger.click();
            });

            // Sync 'is-open' class voi dropdown state - cho phep CSS animate chevron rotate
