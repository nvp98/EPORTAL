            // === Generic fallback: neu chain o tren khong match route hien tai,
            // tu dong match menu item theo href. 2-pass algorithm:
            //   Pass 1: Tim FULL PREFIX MATCH (moi segment cua href = segment tuong ung cua URL)
            //           -> highlight item co duong dan dai nhat khop het.
            //   Pass 2: Neu khong co full match, fallback controller-level (3 segments khop)
            //           va CHI chap nhan item co action='Index' (main listing).
            //           Tranh false-positive nhu: tren /Intro/1 lai highlight /CalibrateIndex
            //           chi vi cung controller ListVirtual. ===
            if ($('.vertical-nav-menu a.mm-active').length === 0) {
                var currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '');
                var curParts = currentPath.split('/').filter(Boolean);

                // === Override: admin tool actions (Featured/{id}, Calibrate/{id}) map ve
                // menu listing tuong ung (FeaturedIndex, CalibrateIndex) thay vi parent
                // Index (vd ListVirtual/Index) ===
                var adminActionToIndex = {
                    'featured':  'featuredindex',
                    'calibrate': 'calibrateindex'
                };
                if (curParts.length >= 4 && adminActionToIndex[curParts[3]]) {
                    var targetAct = adminActionToIndex[curParts[3]];
                    // Tim menu item co href ket thuc bang /Controller/TargetAction
                    var $forcePick = $('.vertical-nav-menu a[href]').filter(function () {
                        var h = ($(this).attr('href') || '').toLowerCase().replace(/\/+$/, '').split('?')[0].split('#')[0];
                        var hp = h.split('/').filter(Boolean);
                        return hp.length === curParts.length - 1
                            && hp[0] === curParts[0]
                            && hp[1] === curParts[1]
                            && hp[2] === curParts[2]
                            && hp[3] === targetAct;
                    }).first();
                    if ($forcePick.length) {
                        $forcePick.addClass('mm-active');
                        $forcePick.closest('ul').addClass('mm-collapse mm-show');
                        $forcePick.closest('li').parent('ul').prev('a').addClass('mm-active');
                        $('.vertical-nav-menu').css('visibility', 'visible');
                        return; // skip generic matching
                    }
                }

                var fullMatch = null,   fullLen   = 0;
                var ctrlMatch = null,   ctrlLen   = 0;
                $('.vertical-nav-menu a[href]').each(function () {
                    var href = ($(this).attr('href') || '').toLowerCase().replace(/\/+$/, '');
                    if (!href || href === '#' || href.indexOf('http') === 0) return;
                    href = href.split('?')[0].split('#')[0];
                    if (!href) return;
                    var hrefParts = href.split('/').filter(Boolean);
                    if (hrefParts.length < 3) return;

                    // Pass 1: full prefix - ALL hrefParts phai match curParts cung index
                    var isFullPrefix = hrefParts.length <= curParts.length;
                    if (isFullPrefix) {
                        for (var i = 0; i < hrefParts.length; i++) {
                            if (hrefParts[i] !== curParts[i]) { isFullPrefix = false; break; }
                        }
                    }
                    if (isFullPrefix && hrefParts.length > fullLen) {
                        fullLen = hrefParts.length;
                        fullMatch = $(this);
                        return;
                    }

                    // Pass 2: controller-level (3 first segments match) + action=Index
                    var ctrlOk = curParts.length >= 3
                              && hrefParts[0] === curParts[0]
                              && hrefParts[1] === curParts[1]
                              && hrefParts[2] === curParts[2]
                              && hrefParts.length >= 4
                              && hrefParts[3] === 'index';
                    if (ctrlOk && hrefParts.length > ctrlLen) {
                        ctrlLen = hrefParts.length;
                        ctrlMatch = $(this);
                    }
                });
                var picked = fullMatch || ctrlMatch;
                if (picked) {
                    picked.addClass('mm-active');
                    picked.closest('ul').addClass('mm-collapse mm-show');
                    picked.closest('li').parent('ul').prev('a').addClass('mm-active');
                }
            }

            // Hide menu lan dau tien de tranh flicker giua hardcoded state va JS-set
            // state. Sidebar visibility hidden o init, show sau khi active state da set.
            $('.vertical-nav-menu').css('visibility', 'visible');
