
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model EPORTAL.ModelsResidency.ResidencyViewModel

<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-portfolio icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        PHIẾU BỔ TÚC THÔNG TIN CÁ NHÂN
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="tab-content">
            @if (ViewBag.HetHan == true)
            {
                <div class="alert alert-danger text-center">
                    <h5>Đã qua thời hạn khai báo.</h5>
                </div>
            }
            else
            {
                if (ViewBag.NgayDenHan != null)
                {
                    <strong class="bg-light text-danger">Hạn khai báo: Hết ngày @(((DateTime)ViewBag.NgayDenHan).ToString("dd/MM/yyyy"))</strong>
                }
                <div class="card mb-4 p-3">
                    <label class="fw-bold d-block mb-2">Tình trạng khai báo:</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="changeOption" id="noChange" value="nochange" checked>
                        <label class="form-check-label fw-bold text-secondary" for="noChange">
                            Không thay đổi thông tin so với app nhân sự
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="changeOption" id="change" value="change">
                        <label class="form-check-label fw-bold" for="change">
                            Thay đổi thông tin so với app nhân sự
                        </label>
                    </div>
                </div>
                <form id="formResidency" onsubmit="return validateAndSave(event)">
                    <div id="residencyFormSection">
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light fw-bold">
                                Thông tin nơi thường trú
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="provincePermanent" class="form-label fw-bold">Tỉnh/Thành phố</label>
                                        <select id="provincePermanent" class="form-control">
                                            <option value="">-- Chọn tỉnh/thành phố --</option>
                                            @foreach (var p in Model.Provinces)
                                            {
                                                <option value="@p.code">@p.name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="communePermanent" class="form-label fw-bold">Xã/Phường</label>
                                        <select id="communePermanent" class="form-control">
                                            <option value="">-- Chọn xã/phường --</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label for="addressPermanent01" class="form-label fw-bold">Xóm / Số nhà</label>
                                        <input type="text" id="addressPermanent01" class="form-control"
                                               placeholder="Nhập Xóm / Số nhà ở nơi thường trú" />
                                    </div>
                                    <div class="col-6">
                                        <label for="addressPermanent02" class="form-label fw-bold">Thôn / Phố</label>
                                        <input type="text" id="addressPermanent02" class="form-control"
                                               placeholder="Nhập Thôn / Phố ở nơi thường trú" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light fw-bold">
                                Thông tin nơi ở hiện tại
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="provinceCurrent" class="form-label fw-bold">Tỉnh/Thành phố</label>
                                        <select id="provinceCurrent" class="form-control">
                                            <option value="">-- Chọn tỉnh/thành phố --</option>
                                            @foreach (var p in Model.Provinces)
                                            {
                                                <option value="@p.code">@p.name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="communeCurrent" class="form-label fw-bold">Xã/Phường</label>
                                        <select id="communeCurrent" class="form-control">
                                            <option value="">-- Chọn xã/phường --</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label for="addressCurrent01" class="form-label fw-bold">Xóm / Số nhà</label>
                                        <input type="text" id="addressCurrent01" class="form-control"
                                               placeholder="Nhập Xóm / Số nhà hiện tại" />
                                    </div>
                                    <div class="col-6">
                                        <label for="addressCurrent02" class="form-label fw-bold">Thôn / Phố</label>
                                        <input type="text" id="addressCurrent02" class="form-control"
                                               placeholder="Nhập Thôn / Phố hiện tại" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light fw-bold">
                                Thông tin liên lạc
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label for="phonePersonal" class="form-label fw-bold">SĐT cá nhân</label>
                                        <input type="text" id="phonePersonal" class="form-control"
                                               placeholder="Nhập số điện thoại cá nhân" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="relativeName" class="form-label fw-bold">Họ tên người thân</label>
                                        <input type="text" id="relativeName" class="form-control"
                                               placeholder="Nhập họ tên người thân" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="relativeRelation" class="form-label fw-bold">Mối quan hệ</label>
                                        <input type="text" id="relativeRelation" class="form-control"
                                               placeholder="Mối quan hệ với người thân" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="relativePhone" class="form-label fw-bold">SĐT người thân</label>
                                        <input type="text" id="relativePhone" class="form-control"
                                               placeholder="Nhập số điện thoại người thân" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light fw-bold">
                                Thông tin nhân thân
                            </div>

                            <div class="card-body">
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Họ tên Bố</label>
                                        <input type="text" id="fatherName" class="form-control" placeholder="Nhập họ tên bố">
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">Năm sinh Bố</label>
                                        <select id="fatherYob" class="form-control"></select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Họ tên Mẹ</label>
                                        <input type="text" id="motherName" class="form-control" placeholder="Nhập họ tên mẹ">
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">Năm sinh Mẹ</label>
                                        <select id="motherYob" class="form-control"></select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Họ tên Vợ/Chồng</label>
                                        <input type="text" id="spouseName" class="form-control" placeholder="Nhập họ tên vợ/chồng">
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">Năm sinh Vợ/Chồng</label>
                                        <select id="spouseYob" class="form-control"></select>
                                    </div>

                                </div>

                                <div class="row g-3">
                                    <div class="col-12 d-flex justify-content-between align-items-center">
                                        <button type="button" class="btn btn-primary btn-sm" id="addChildBtn">
                                            + Thêm con
                                        </button>
                                    </div>

                                    <div id="childrenContainer" class="mt-2"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="text-center">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Lưu thông tin
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">
                <div class="footer_content d-flex justify-content-between">
                    <div class="footer_item web_name">
                        <span>Công ty cổ phần thép Hòa Phát Dung Quất</span>
                    </div>

                    <div class="footer_item_copy d-flex">
                        <span class="copyright">Copyright</span>
                        <ul class="copyright_ul">
                            <li>Ban công nghệ thông tin</li>
                            <li>Hòa Phát Dung Quất</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<script>

    let childIndex = 0;

    function addChildRow(name = "", yob = "") {
        childIndex++;

        let html = `
        <div class="row g-3 align-items-end mb-2 child-row" data-child-id="${childIndex}">
            <div class="col-md-6">
                <input type="text" name="Children[${childIndex}].HoTen"
                       class="form-control" value="${name}" placeholder="Nhập họ tên con">
            </div>

            <div class="col-md-4">
                <select name="Children[${childIndex}].NamSinh" class="form-control">
                    <option value="">--Chọn năm--</option>
                    ${generateYearOptionsForChildren(yob)}
                </select>
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-danger btn-sm remove-child">Xóa</button>
            </div>
        </div>`;

        $("#childrenContainer").append(html);
    }

    $(document).ready(function () {
        addChildRow();
    });

    function generateYearOptionsForChildren(selectedYear) {
        const currentYear = new Date().getFullYear();
        let html = "";

        for (let year = currentYear; year >= 1980; year--) {
            html += `<option value="${year}" ${selectedYear == year ? "selected" : ""}>${year}</option>`;
        }

        return html;
    }

    $("#addChildBtn").on("click", function () {
        addChildRow();
    });

    $(document).on("click", ".remove-child", function () {
        $(this).closest(".child-row").remove();
    });

    function validatePair(nameSelector, yobSelector, fieldLabel) {
        let name = $(nameSelector).val().trim();
        let yob = $(yobSelector).val();

        if ((name !== "" && yob === "") || (name === "" && yob !== "")) {
            alert(`Vui lòng nhập đầy đủ Họ tên và Năm sinh của ${fieldLabel}.`);
            $(nameSelector).focus();
            return false;
        }
        return true;
    }

    function validateAndSave(e) {
        e.preventDefault();

        const form = $("#formResidency")[0];
        const changeOption = $('input[name="changeOption"]:checked').val();

        if (changeOption === "nochange") {

        } else {

            // Validate form
            if (!form.checkValidity()) {
                form.reportValidity();
                return false;
            }

            const permanentFields = [
                '#provincePermanent',
                '#communePermanent',
                '#addressPermanent01',
                '#addressPermanent02'
            ];

            const hasPermanentValue = permanentFields.some(id => $(id).val() && $(id).val().trim() !== "");

            if (hasPermanentValue) {
                for (let id of permanentFields) {
                    if (!$(id).val() || $(id).val().trim() === "") {
                        alert("Vui lòng nhập đầy đủ thông tin nơi thường trú.");
                        $(id).focus();
                        return false;
                    }
                }
            }

            const currentFields = [
                '#provinceCurrent',
                '#communeCurrent',
                '#addressCurrent01',
                '#addressCurrent02'
            ];

            const hasCurrentValue = currentFields.some(id => $(id).val() && $(id).val().trim() !== "");

            if (hasCurrentValue) {
                for (let id of currentFields) {
                    if (!$(id).val() || $(id).val().trim() === "") {
                        alert("Vui lòng nhập đầy đủ thông tin nơi ở hiện tại.");
                        $(id).focus();
                        return false;
                    }
                }
            }
        }

        const relativeName = $("#relativeName").val().trim();
        const relativeRelation = $("#relativeRelation").val().trim();
        const relativePhone = $("#relativePhone").val().trim();

        const hasAnyRelativeInfo =
            relativeName !== "" ||
            relativeRelation !== "" ||
            relativePhone !== "";

        if (hasAnyRelativeInfo) {
            if (relativeName === "" || relativeRelation === "" || relativePhone === "") {
                alert("Vui lòng nhập đầy đủ Họ tên người thân, Mối quan hệ và SĐT người thân.");

                if (relativeName === "") $("#relativeName").focus();
                else if (relativeRelation === "") $("#relativeRelation").focus();
                else $("#relativePhone").focus();

                return false;
            }
        }

        if (!validatePair("#fatherName", "#fatherYob", "Bố")) {
            return false;
        }

        if (!validatePair("#motherName", "#motherYob", "Mẹ")) {
            return false;
        }

        if (!validatePair("#spouseName", "#spouseYob", "Vợ/Chồng")) {
            return false;
        }

        let validChildren = true;

        $(".child-row").each(function () {
            let name = $(this).find("input[name*='HoTen']").val().trim();
            let yob = $(this).find("select[name*='NamSinh']").val().trim();

            if ((name !== "" && yob === "") || (name === "" && yob !== "")) {
                alert("Vui lòng nhập đầy đủ Họ tên và Năm sinh cho mỗi con.");
                $(this).find("input, select").first().focus();
                validChildren = false;
                return false;
            }
        });

        if (!validChildren) {
            return false;
        }

        // Data
        var data = {
            ChangeOption: changeOption,
            PermanentProvinceCode: $('#provincePermanent').val(),
            PermanentProvinceName: $('#provincePermanent option:selected').text(),
            PermanentCommuneCode: $('#communePermanent').val(),
            PermanentCommuneName: $('#communePermanent option:selected').text(),
            PermanentAddress01: $('#addressPermanent01').val(),
            PermanentAddress02: $('#addressPermanent02').val(),
            CurrentProvinceCode: $('#provinceCurrent').val(),
            CurrentProvinceName: $('#provinceCurrent option:selected').text(),
            CurrentCommuneCode: $('#communeCurrent').val(),
            CurrentCommuneName: $('#communeCurrent option:selected').text(),
            CurrentAddress01: $('#addressCurrent01').val(),
            CurrentAddress02: $('#addressCurrent02').val(),

            PhonePersonal: $('#phonePersonal').val(),
            RelativeName: $('#relativeName').val(),
            RelativePhone: $('#relativePhone').val(),
            RelativeRelation: $('#relativeRelation').val(),

            FatherName: $('#fatherName').val(),
            FatherYob: $('#fatherYob').val(),
            MotherName: $('#motherName').val(),
            MotherYob: $('#motherYob').val(),
            SpouseName: $('#spouseName').val(),
            SpouseYob: $('#spouseYob').val(),

            Children: []
        };

        const pairs = [
            ["PermanentProvinceCode", "PermanentProvinceName"],
            ["PermanentCommuneCode", "PermanentCommuneName"],
            ["CurrentProvinceCode", "CurrentProvinceName"],
            ["CurrentCommuneCode", "CurrentCommuneName"]
        ];

        pairs.forEach(([codeField, nameField]) => {
            if (data[codeField] === "") {
                data[nameField] = "";
            }
        });

        $(".child-row").each(function () {
            let name = $(this).find("input[name*='HoTen']").val();
            let yob = $(this).find("select[name*='NamSinh']").val();

            if (name.trim() !== "") {
                data.Children.push({
                    HoTen: name,
                    NamSinh: yob
                });
            }
        });

        $.ajax({
            url: '/Residency/Save',
            type: 'POST',
            data: data,
            success: function (res) {
                if (res.ok) {
                    alert(res.message);
                    if (res.redirectUrl) {
                        window.location.href = res.redirectUrl;
                    } else {
                        window.location.href = "/Residency/Details";
                    }
                } else {
                    alert('Không lưu được: ' + res.message);
                }
            },
            error: function () {
                alert('Có lỗi khi gửi yêu cầu.');
            }
        });

        return false;
    }

    $(document).ready(function () {

        // Radio
        const $formSection = $('#residencyFormSection');
        const $noChange = $('#noChange');
        const $change = $('#change');

        // Hide form
        if ($noChange.is(':checked')) {
            $formSection.hide();
        }

        $('input[name="changeOption"]').on('change', function () {
            if ($change.is(':checked')) {
                $formSection.slideDown(200);
            } else {
                $formSection.slideUp(200);
            }
        });

        let PermanentProvinceName = "";
        let PermanentCommuneName = "";
        let CurrentProvinceName = "";
        let CurrentCommuneName = "";

        $('#provincePermanent').on('change', function () {
            var provinceCode = $(this).val();
            var provinceText = $('#provincePermanent option:selected').text();
            PermanentProvinceName = provinceText !== "-- Chọn tỉnh/thành phố --" ? provinceText : "";

            var communeSelect = $('#communePermanent');
            communeSelect.prop('disabled', true).empty().append('<option>Đang tải...</option>');

            if (provinceCode) {
                $.getJSON(`/Residency/GetCommunes?provinceId=${provinceCode}`, function (res) {
                    communeSelect.empty().append('<option value="">-- Chọn xã/phường --</option>');
                    $.each(res.data, function (i, c) {
                        communeSelect.append(`<option value="${c.code}">${c.name}</option>`);
                    });
                    communeSelect.prop('disabled', false);

                    if (communeSelect.data('chosen')) {
                        communeSelect.trigger("chosen:updated");
                    } else {
                        communeSelect.chosen({ width: "100%" });
                    }

                    PermanentCommuneName = "";
                });
            } else {
                communeSelect.empty().append('<option value="">-- Chọn xã/phường --</option>');
                if (communeSelect.data('chosen')) {
                    communeSelect.trigger("chosen:updated");
                }
                PermanentCommuneName = "";
            }
        });

        $('#communePermanent').on('change', function () {
            var communeText = $('#communePermanent option:selected').text();
            PermanentCommuneName = communeText !== "-- Chọn xã/phường --" ? communeText : "";
        });

        $('#provinceCurrent').on('change', function () {
            var provinceCode = $(this).val();
            var provinceText = $('#provinceCurrent option:selected').text();
            CurrentProvinceName = provinceText !== "-- Chọn tỉnh/thành phố --" ? provinceText : "";

            var communeSelect = $('#communeCurrent');
            communeSelect.prop('disabled', true).empty().append('<option>Đang tải...</option>');

            if (provinceCode) {
                $.getJSON(`/Residency/GetCommunes?provinceId=${provinceCode}`, function (res) {
                    communeSelect.empty().append('<option value="">-- Chọn xã/phường --</option>');
                    $.each(res.data, function (i, c) {
                        communeSelect.append(`<option value="${c.code}">${c.name}</option>`);
                    });
                    communeSelect.prop('disabled', false);

                    if (communeSelect.data('chosen')) {
                        communeSelect.trigger("chosen:updated");
                    } else {
                        communeSelect.chosen({ width: "100%" });
                    }

                    CurrentCommuneName = "";
                });
            } else {
                communeSelect.empty().append('<option value="">-- Chọn xã/phường --</option>');
                if (communeSelect.data('chosen')) {
                    communeSelect.trigger("chosen:updated");
                }
                CurrentCommuneName = "";
            }
        });

        $('#communeCurrent').on('change', function () {
            var communeText = $('#communeCurrent option:selected').text();
            CurrentCommuneName = communeText !== "-- Chọn xã/phường --" ? communeText : "";
        });

        function generateYears(selectId) {
            let currentYear = new Date().getFullYear();
            let html = '<option value="">-- Chọn năm --</option>';

            for (let year = currentYear; year >= 1930; year--) {
                html += `<option value="${year}">${year}</option>`;
            }

            $(selectId).html(html);
        }

        generateYears("#fatherYob");
        generateYears("#motherYob");
        generateYears("#spouseYob");
    });
</script>
<script type="text/javascript">
    $("#provincePermanent, #provinceCurrent, #communePermanent, #communeCurrent").chosen({
        width: "100%"
    });
</script>
