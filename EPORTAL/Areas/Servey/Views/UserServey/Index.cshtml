@{
    ViewBag.Title = "Danh sách đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using EPORTAL.ModelsServey
@model List<UserServeyValidation>

@if (TempData["msgSuccess"] != null)
{@Html.Raw(TempData["msgSuccess"])}
@if (TempData["msgError"] != null)
{@Html.Raw(TempData["msgError"])}

<style>
    .sv-page-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

        .sv-page-header h4 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #2d3a4a;
            margin: 0;
        }

    .sv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 22px;
    }

    .sv-card {
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #eef0f4;
    }

        .sv-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 32px rgba(0,0,0,0.13);
        }

    /* ── Header strip ── */
    .sv-card-top {
        padding: 14px 18px 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .sv-card-top.done {
            background: linear-gradient(135deg, #1d8348, #27ae60);
        }

        .sv-card-top.todo {
            background: linear-gradient(135deg, #154360, #1a6fa8);
        }

        .sv-card-top.locked {
            background: linear-gradient(135deg, #616a6b, #909497);
        }

        .sv-card-top .sv-index {
            font-size: 0.78rem;
            font-weight: 600;
            color: rgba(255,255,255,0.75);
            letter-spacing: 0.5px;
        }

    .sv-reg-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 600;
    }

        .sv-reg-pill.done {
            background: rgba(255,255,255,0.25);
            color: #fff;
        }

        .sv-reg-pill.todo {
            background: rgba(255,255,255,0.18);
            color: rgba(255,255,255,0.9);
        }

    /* ── Body ── */
    .sv-card-body {
        padding: 16px 18px 10px;
        flex: 1;
    }

        .sv-card-body .sv-title {
            font-size: 1rem;
            font-weight: 700;
            color: #1a2535;
            margin: 0 0 10px;
            line-height: 1.4;
        }

    .sv-meta {
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-size: 0.84rem;
        color: #5d6778;
    }

        .sv-meta i {
            width: 16px;
            text-align: center;
            color: #8a95a3;
            margin-right: 4px;
        }

    .sv-status-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 10px;
        padding: 3px 10px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
    }

        .sv-status-chip.active {
            background: #d5f5e3;
            color: #1e8449;
        }

        .sv-status-chip.locked {
            background: #f2f3f4;
            color: #717d7e;
        }

    /* ── Footer ── */
    .sv-card-footer {
        padding: 12px 18px 16px;
        border-top: 1px solid #f0f2f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .sv-stats {
        display: flex;
        flex-direction: column;
        gap: 3px;
        font-size: 0.8rem;
        color: #7f8c9a;
    }

        .sv-stats i {
            width: 14px;
            text-align: center;
            margin-right: 4px;
        }

    .sv-days {
        font-weight: 700;
        color: #c0392b;
    }

    .sv-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.18s;
        white-space: nowrap;
    }

        .sv-btn:hover {
            text-decoration: none;
            opacity: 0.88;
            transform: scale(1.03);
        }

        .sv-btn.register {
            background: #1a6fa8;
            color: #fff;
        }

        .sv-btn.registered {
            background: #eafaf1;
            color: #1e8449;
            border: 1.5px solid #82e0aa;
        }

        .sv-btn.locked-btn {
            background: #f2f3f4;
            color: #909497;
            pointer-events: none;
            cursor: default;
        }

    .sv-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        color: #a0aab4;
        font-size: 1rem;
    }
</style>

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="sv-page-header">
            <i class="fa fa-list-alt fa-lg text-primary"></i>
            <h4>Danh sách chương trình đăng ký</h4>
        </div>

        <div class="sv-grid">
            @{ int RowNo = 1; }
            @if (!Model.Any())
            {
                <div class="sv-empty">
                    <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
                    Hiện chưa có chương trình nào đang hoạt động.
                </div>
            }
            @foreach (var item in Model)
            {
                bool locked = !item.StatusSV;
                bool done = item.IsRegistered;
                int daysLeft = item.Exp.Add(-TimeSpan.FromDays(1)).Days;

                string topClass = locked ? "locked" : (done ? "done" : "todo");
                string regText = done ? "Đã đăng ký" : "Chưa đăng ký";
                string regIcon = done ? "fa-check-circle" : "fa-circle-o";

                bool isPickleball = item.IDSV != 12 && item.IDSV != 13
                    && (item.ContentSV ?? "").IndexOf("Pickleball", StringComparison.OrdinalIgnoreCase) >= 0;
                string actionUrl = isPickleball
                    ? Url.Action("IndexDongDoi", "ServeyID", new { IDSV = item.IDSV })
                    : Url.Action("Index", "ServeyID", new { IDSV = item.IDSV });

                string btnClass = locked ? "locked-btn" : (done ? "registered" : "register");
                string btnText = locked ? "Đã khóa" : (done ? "Xem / Chỉnh sửa" : "Đăng ký ngay");
                string btnIcon = locked ? "fa-lock" : (done ? "fa-eye" : "fa-arrow-right");
                string chipClass = item.StatusSV ? "active" : "locked";
                string chipIcon = item.StatusSV ? "fa-unlock-alt" : "fa-lock";
                string chipText = item.StatusSV ? "Đang hoạt động" : "Khóa đăng ký";

                <div class="sv-card">
                    <div class="sv-card-top @topClass">
                        <span class="sv-index">
                            <i class="fa fa-hashtag"></i> @RowNo@{ RowNo++; }
                        </span>
                        <span class="sv-reg-pill @(done ? "done" : "todo")">
                            <i class="fa @regIcon"></i> @regText
                        </span>
                    </div>

                    <div class="sv-card-body">
                        <p class="sv-title">@item.ContentSV</p>
                        <div class="sv-meta">
                            <span>
                                <i class="fa fa-calendar"></i>
                                @item.StartTime.ToString("dd/MM/yyyy") &nbsp;–&nbsp; @item.EndTime.AddDays(-1).ToString("dd/MM/yyyy")
                            </span>
                        </div>
                        <span class="sv-status-chip @chipClass">
                            <i class="fa @chipIcon"></i>
                            @chipText
                        </span>
                    </div>

                    <div class="sv-card-footer">
                        <div class="sv-stats">
                            <span>
                                <i class="fa fa-clock-o"></i>
                                Còn&nbsp;<span class="sv-days">@daysLeft</span>&nbsp;ngày
                            </span>
                            <span>
                                <i class="fa fa-users"></i>
                                @item.CountSV người đã đăng ký
                            </span>
                        </div>
                        <a href="@actionUrl" class="sv-btn @btnClass">
                            <i class="fa @btnIcon"></i> @btnText
                        </a>
                    </div>
                </div>
            }
        </div>

    </div>
</div>
