@{
    ViewBag.Title = "Dự án 360°";
    Layout = "~/Views/Shared/_LayoutV360Showcase.cshtml";
    // Body class controlled boi page state - viewport-fit cho grid + da chon folder.
    // (Home view + List view: natural scroll, khong fit.)
    bool _isHome = Convert.ToBoolean(ViewBag.IsHomeView ?? false);
    var _viewMode = (string)ViewBag.View ?? "grid";
    if (!_isHome && _viewMode == "grid")
    {
        ViewBag.BodyClass = "v360-sc-fit";
    }
}
@using EPORTAL.ModelsView360
@using EPORTAL.Common
@using PagedList.Mvc
@model PagedList.IPagedList<ProjectValidation>

@{
    var hierarchy = ViewBag.Hierarchy as List<ProjectGroupNode> ?? new List<ProjectGroupNode>();
    var search = (string)ViewBag.search ?? "";
    ViewBag.SearchPlaceholder = "Tìm dự án theo tên...";
    // Logo clickable -> ve home cua module (chi rieng trang nay).
    ViewBag.LogoLink = Url.Action("Index", "ListProject", new { area = "View360" });
    var fallbackImg = Url.Content("~/Content/assets/images/bg2.jpg");
    var activeParent = hierarchy.FirstOrDefault(p => p.Active);
    var activeSub = activeParent != null ? activeParent.Children.FirstOrDefault(c => c.Active) : null;
    var currentSort = (string)ViewBag.Sort ?? "date-desc";
    var currentView = (string)ViewBag.View ?? "grid";
    var folderCounts = ViewBag.FolderCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    int? currentId = ViewBag.CurrentId as int?;
    int? currentSid = ViewBag.CurrentSid as int?;
    bool isHomeView = ViewBag.IsHomeView == true;
    var newCutoff = DateTime.Now.Date.AddDays(-7); // Du an Date >= 7 ngay truoc = "Moi cap nhat"
    var seenIds = ViewBag.SeenIds as HashSet<int> ?? new HashSet<int>(); // Project IDs user da view

    // Icon map cho parent tabs - theo keyword trong GroupName
    Func<string, string> getTabIcon = name =>
    {
        var n = (name ?? "").ToLowerInvariant();
        if (n.Contains("hpdq"))    return "fa-industry";        // Khu công nghiệp HPDQ
        if (n.Contains("phú yên") || n.Contains("phu yen")) return "fa-map-marker-alt"; // Khu vực địa lý
        if (n.Contains("camera") || n.Contains("cổng") || n.Contains("cong")) return "fa-video"; // Cổng-Camera
        if (n.Contains("3d") || n.Contains("vr"))           return "fa-vr-cardboard";   // 3D / VR
        if (n.Contains("thép") || n.Contains("thep") || n.Contains("ray")) return "fa-train"; // DA.ThépRay
        if (n.Contains("kho"))                              return "fa-warehouse";      // KHO
        if (n.Contains("cth"))                              return "fa-anchor";         // Cảng / Cảng thủy
        if (n.Contains("ksmb"))                             return "fa-cogs";           // Khu sản xuất Minh Bằng
        return "fa-building"; // fallback
    };

    // "Tien do" sub-tab count: lay tu ViewBag (controller da tinh tu `all` da loc permission)
    // de match Model.TotalItemCount. KHONG dung activeParent.ProjectCount vi do la DB-wide
    // count, gom ca project user khong co quyen xem -> inflate (vd 171 vs 169 actual).
    int tienDoCount = Convert.ToInt32(ViewBag.TienDoCount ?? 0);

    // URL builder cho subtab
    Func<int?, string> subTabUrl = sid => sid.HasValue
        ? Url.Action("Index", "ListProject", new { id = activeParent.IDGroup, sid = sid.Value, view = currentView, sort = currentSort })
        : Url.Action("Index", "ListProject", new { id = activeParent.IDGroup, view = currentView, sort = currentSort });
}

<link href="~/Content/PagedList.css" rel="stylesheet" />

<div class="v360-sc-fit__head">
@* ====================================================================
   HÀNG 1: PARENT TABS
   ==================================================================== *@
@if (hierarchy.Count > 0)
{
    <div class="v360-tabs-wrap" data-v360-tabs data-visible="8">
        <button type="button" class="v360-tabs-arrow v360-tabs-arrow--prev" aria-label="Trước">
            <i class="fa fa-chevron-left"></i>
        </button>
        <nav class="v360-sc-tabs" aria-label="Nhóm dự án">
            @foreach (var parent in hierarchy)
            {
                <a class="v360-sc-tab @(parent.Active ? "active" : "")"
                   href="@Url.Action("Index", "ListProject", new { id = parent.IDGroup, view = currentView, sort = currentSort })"
                   title="@parent.GroupName">
                    <i class="fa @getTabIcon(parent.GroupName) v360-sc-tab__icon"></i>
                    @parent.GroupName
                </a>
            }
        </nav>
        <button type="button" class="v360-tabs-arrow v360-tabs-arrow--next" aria-label="Sau">
            <i class="fa fa-chevron-right"></i>
        </button>
    </div>
}

@* ====================================================================
   HÀNG 2: SUB-TABS (chỉ khi parent active có children)
   ==================================================================== *@
@if (activeParent != null && activeParent.Children.Count > 0)
{
    <div class="v360-tabs-wrap v360-tabs-wrap--sub" data-v360-tabs data-visible="7">
        <button type="button" class="v360-tabs-arrow v360-tabs-arrow--prev" aria-label="Trước">
            <i class="fa fa-chevron-left"></i>
        </button>
        <nav class="v360-sc-subtabs" aria-label="Nhóm con">
            <a class="v360-sc-subtab v360-sc-subtab--all @(activeSub == null ? "active" : "")"
               href="@subTabUrl(null)"
               title="Báo cáo tiến độ trực tiếp của @activeParent.GroupName">
                <i class="fa fa-tasks v360-sc-subtab__icon"></i>
                Tiến độ
                <span class="v360-sc-subtab__count">@tienDoCount</span>
            </a>
            @foreach (var child in activeParent.Children)
            {
                var cnt = folderCounts.ContainsKey(child.IDGroup) ? folderCounts[child.IDGroup] : 0;
                <a class="v360-sc-subtab @(child.Active ? "active" : "")"
                   href="@subTabUrl(child.IDGroup)"
                   title="@child.GroupName">
                    <i class="fa fa-folder v360-sc-subtab__icon"></i>
                    @child.GroupName
                    <span class="v360-sc-subtab__count">@cnt</span>
                </a>
            }
        </nav>
        <button type="button" class="v360-tabs-arrow v360-tabs-arrow--next" aria-label="Sau">
            <i class="fa fa-chevron-right"></i>
        </button>
    </div>
}

@* ====================================================================
   HOME VIEW: Banner "Kho tư liệu" + section header "Dự án mới cập nhật"
   ==================================================================== *@
@if (isHomeView)
{
    <section class="v360-sc-banner">
        <div class="v360-sc-banner__bg"></div>
        <div class="v360-sc-banner__overlay"></div>
        <div class="v360-sc-banner__content">
            <div class="v360-sc-banner__eyebrow">KHO TƯ LIỆU</div>
            <h2 class="v360-sc-banner__title">360 FLYCAM HIỆN TRẠNG DỰ ÁN HPDQ</h2>
            <p class="v360-sc-banner__desc">
                Cập nhật hình ảnh flycam 360° chất lượng cao theo tiến độ thực tế.<br />
                Theo dõi toàn cảnh – Chính xác – Liên tục – Minh bạch.
            </p>
            <div class="v360-sc-banner__chips">
                <span class="v360-sc-banner__chip"><i class="fa fa-globe"></i> 360° Toàn cảnh</span>
                <span class="v360-sc-banner__chip"><i class="fa fa-clock"></i> Cập nhật liên tục</span>
                <span class="v360-sc-banner__chip"><i class="fa fa-shield-alt"></i> Dữ liệu tin cậy</span>
            </div>
        </div>
    </section>

    <div class="v360-sc-section">
        <h3 class="v360-sc-section__title">
            <span class="v360-sc-section__title__icon"><i class="fa fa-sliders-h"></i></span>
            Dự án mới cập nhật
        </h3>
        <a href="@Url.Action("Index", "ListProject", new { page = 1, sort = "date-desc", view = "grid" })" class="v360-sc-section__more">
            Xem tất cả <i class="fa fa-arrow-right"></i>
        </a>
    </div>
}
else
{
    @* ============================================================
       FILTER BAR: breadcrumb + sort + view toggle (khi da chon tab)
       ============================================================ *@
    <div class="v360-sc-filterbar">
        <div class="v360-sc-filterbar__left">
            @if (activeParent != null)
            {
                <span class="v360-sc-crumb">
                    <span>@activeParent.GroupName</span>
                    <span class="v360-sc-crumb__sep">/</span>
                    @if (activeSub != null)
                    {
                        <span class="v360-sc-crumb__current">@activeSub.GroupName</span>
                    }
                    else
                    {
                        @* Dong bo: parent KHONG co children van hien "Tien do" (cung la projects truc tiep) *@
                        <span class="v360-sc-crumb__current">Tiến độ</span>
                    }
                </span>
                <span class="v360-sc-crumb__meta">· @Model.TotalItemCount dự án</span>
            }
            else
            {
                <span class="v360-sc-crumb__current">@(string.IsNullOrEmpty(search) ? "Tất cả dự án" : "Kết quả tìm kiếm")</span>
                <span class="v360-sc-crumb__meta">· @Model.TotalItemCount dự án</span>
            }
            @if (!string.IsNullOrEmpty(search))
            {
                var clearSearchUrl = Url.Action("Index", "ListProject", new {
                    id = currentId, sid = currentSid, sort = currentSort, view = currentView, ps = ViewBag.PageSize
                });
                <a href="@clearSearchUrl" class="v360-sc-searchchip" title="Bỏ từ khoá tìm kiếm này">
                    <i class="fa fa-search v360-sc-searchchip__icon"></i>
                    <span>Tìm: <b>@search</b></span>
                    <span class="v360-sc-searchchip__close" aria-label="Xoá tìm kiếm">×</span>
                </a>
            }
        </div>
        <div class="v360-sc-controls">
            @{
                var baseUrl = Url.Action("Index", "ListProject", new {
                    id = currentId, sid = currentSid
                });
                var sep = baseUrl.Contains("?") ? "&" : "?";
            }
            <select id="v360-sort-select" class="v360-sc-sort" data-base-url="@baseUrl" data-view="@currentView">
                <option value="date-desc" @(currentSort == "date-desc" ? "selected" : "")>Mới nhất</option>
                <option value="date-asc"  @(currentSort == "date-asc"  ? "selected" : "")>Cũ nhất</option>
                <option value="name-asc"  @(currentSort == "name-asc"  ? "selected" : "")>Tên A → Z</option>
                <option value="name-desc" @(currentSort == "name-desc" ? "selected" : "")>Tên Z → A</option>
            </select>
            <div class="v360-sc-viewtoggle">
                <a class="@(currentView == "grid" ? "active" : "")"
                   href="#" data-vsc-view="grid"
                   title="Lưới"><i class="fa fa-th-large"></i></a>
                <a class="@(currentView == "list" ? "active" : "")"
                   href="#" data-vsc-view="list"
                   title="Danh sách"><i class="fa fa-list"></i></a>
            </div>
        </div>
    </div>
}

@* /v360-sc-fit__head - dong wrapper tabs + filter *@
</div>

<div class="v360-sc-fit__body">

@* ====================================================================
   CONTENT: pure file grid - KHÔNG còn folder cards
   ==================================================================== *@
@if (Model.Count == 0)
{
    <div class="v360-sc-empty">
        <i class="fa fa-folder-open"></i>
        <h3>Chưa có dự án</h3>
        <p>
            @if (!string.IsNullOrEmpty(search))
            {
                <text>Không tìm thấy kết quả cho "@search". Thử từ khóa khác hoặc đổi nhóm.</text>
            }
            else
            {
                <text>Nhóm này chưa có dự án nào. Chọn nhóm khác trên thanh tab phía trên.</text>
            }
        </p>
    </div>
}
else if (currentView == "list")
{
    <div class="v360-listview">
        <div class="v360-listview__head">
            <span class="v360-listview__col v360-listview__col--name">Tên</span>
            <span class="v360-listview__col v360-listview__col--desc">Mô tả</span>
            <span class="v360-listview__col v360-listview__col--date">Ngày</span>
        </div>
        @foreach (var item in Model)
        {
            var detailsUrl = Url.Action("Details", "ListProject", new { id = item.ID });
            <a class="v360-listview__row" href="@detailsUrl" style="content-visibility:auto;contain-intrinsic-size:0 56px">
                <span class="v360-listview__col v360-listview__col--name">
                    <i class="fa fa-image v360-listview__icon"></i>
                    @item.Title
                </span>
                <span class="v360-listview__col v360-listview__col--desc">@item.Note</span>
                <span class="v360-listview__col v360-listview__col--date">@item.Date.ToString("dd/MM/yyyy")</span>
            </a>
        }
    </div>

    if (Model.TotalItemCount > 0)
    {
        <div style="text-align:center;color:#94a3b8;font-size:12px;padding:14px 0">
            Hiển thị tất cả @Model.TotalItemCount dự án
        </div>
    }
}
else
{
    <div class="v360-grid">
        @foreach (var item in Model)
        {
            var imgUrl = string.IsNullOrEmpty(item.Images)
                ? fallbackImg
                : Url.Content("~/Images/" + System.IO.Path.GetFileName(item.Images));
            var detailsUrl = Url.Action("Details", "ListProject", new { id = item.ID });
            var isSeen = seenIds.Contains(item.ID);
            <a class="v360-card @(isSeen ? "is-seen" : "is-unseen")" href="@detailsUrl">
                <div class="v360-card__media">
                    <img src="@imgUrl" alt="@item.Title"
                         width="400" height="275"
                         loading="lazy" decoding="async" />
                    <span class="v360-card__badge">360°</span>
                    @if (item.Date >= newCutoff)
                    {
                        <span class="v360-card__badge v360-card__badge--new" title="Cập nhật trong 7 ngày qua">
                            Mới cập nhật
                        </span>
                    }
                    <div class="v360-card__overlay">
                        <span class="v360-card__overlay-action">
                            Khám phá <i class="fa fa-arrow-right"></i>
                        </span>
                    </div>
                </div>
                <div class="v360-card__body">
                    <h3 class="v360-card__title">@item.Title</h3>
                    @{
                        var displayNote = (item.Note ?? "").Trim();
                        // Skip note placeholder rac (".", "-", " ", ...)
                        if (displayNote.Length < 2) { displayNote = ""; }
                    }
                    @if (!string.IsNullOrEmpty(displayNote))
                    {
                        <p class="v360-card__desc">@displayNote</p>
                    }
                    <div class="v360-card__meta">
                        <span><i class="fa fa-calendar"></i> @item.Date.ToString("dd/MM/yyyy")</span>
                        <span class="v360-card__seen @(isSeen ? "is-seen" : "is-unseen")"
                              title="@(isSeen ? "Bạn đã xem dự án này" : "Bạn chưa xem dự án này")">
                            <i class="fa @(isSeen ? "fa-eye" : "fa-eye-slash")"></i>
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>

}

@* /v360-sc-fit__body - dong wrapper grid area *@
</div>

@* Pagination chi render khi co tu 2 trang tro len *@
@if (!isHomeView && Model.Count > 0 && currentView == "grid" && Model.PageCount > 1)
{
    <div class="v360-sc-fit__pager v360-pagination">
        @Html.PagedListPager(Model,
            page => Url.Action("Index", "ListProject", new { area = "View360", page, id = currentId, sid = currentSid, search, view = currentView, sort = currentSort }),
            new PagedList.Mvc.PagedListRenderOptions {
                DisplayLinkToPreviousPage = PagedList.Mvc.PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedList.Mvc.PagedListDisplayMode.Always
            })
    </div>
}

<script>
    // Sort dropdown change - giu nguyen URL params hien tai (id/sid/search/page),
    // chi update sort + view. Tranh quay ve home view khi dang o "Xem tat ca".
    (function () {
        var sel = document.getElementById('v360-sort-select');
        if (!sel) return;
        sel.addEventListener('change', function () {
            var url = new URL(window.location.href);
            url.searchParams.set('sort', sel.value);
            url.searchParams.set('view', sel.getAttribute('data-view') || 'grid');
            // Reset to page 1 khi sort thay doi - giu page param de KHONG trigger home view
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        });

        // View toggle (Grid/List) - cung giu URL params, tranh quay ve home
        document.querySelectorAll('.v360-sc-viewtoggle a[data-vsc-view]').forEach(function (a) {
            a.addEventListener('click', function (e) {
                e.preventDefault();
                var url = new URL(window.location.href);
                url.searchParams.set('view', a.getAttribute('data-vsc-view'));
                url.searchParams.set('page', '1');
                window.location.href = url.toString();
            });
        });
    })();
</script>
