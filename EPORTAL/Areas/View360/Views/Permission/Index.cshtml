        '</div>' +
        '<div id="d1-preview"></div>';

    openModal('🏢 Cấp quyền cho cả phòng ban', body, 'Cấp 0 quyền mới', function () {
        var c = buildGrantContent(groupSel);
        execGrant({
            UserIds: deptUsers.map(function (u) { return u.id; }),
            Groups: c.Groups, Items: c.Items
        });
    });
    updateModalConfirm('Cấp 0 quyền mới', true);

    groupSel.onChange = updatePreview;
    function updatePreview() {
        if (deptUsers.length === 0) return;
        var c = buildGrantContent(groupSel);
        runPreview({
            UserIds: deptUsers.map(function (u) { return u.id; }),
            Groups: c.Groups, Items: c.Items
        }, function (p) {
            $('#d1-preview').innerHTML = renderPreview(p);
            if (p && !p.error) updateModalConfirm('+ Cấp ' + fmt(p.notExisting) + ' quyền mới', !canGrant || p.notExisting === 0);
        });
    }

    // Populate dept
    loadPhongBans().then(function (rows) {
        var $sel = $('#d1-sel');
        rows.forEach(function (r) {
            var o = document.createElement('option');
            o.value = r.id; o.textContent = r.name;
            $sel.appendChild(o);
        });
