@{
    ViewBag.Title = "Quản lý phân quyền";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool canGrant  = (bool)(ViewBag.CanGrant  ?? false);
    bool canRevoke = (bool)(ViewBag.CanRevoke ?? false);
}

<style>
:root {
    --pm-blue: #2563eb; --pm-blue-d: #1d4ed8; --pm-blue-l: #eff6ff;
    --pm-border: #e2e8f0; --pm-text: #0f172a; --pm-muted: #64748b; --pm-bg: #f8fafc;
}
.pm { padding: 18px; background: var(--pm-bg); min-height: calc(100vh - 60px); }

/* Header */
.pm-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; gap: 12px; flex-wrap: wrap; }
.pm-hd h2 { font-size: 19px; font-weight: 700; color: var(--pm-text); margin: 0; display: inline-flex; align-items: center; gap: 8px; }
.pm-hd__sub { color: var(--pm-muted); font-size: 12px; margin-top: 2px; }
.pm-hd__actions { display: flex; gap: 8px; flex-wrap: wrap; }

/* Buttons */
.pm-btn { padding: 8px 14px; border-radius: 7px; font-size: 13px; font-weight: 600; cursor: pointer;
          border: 1px solid; transition: all .15s ease; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; }
.pm-btn--ghost { background: #fff; color: var(--pm-muted); border-color: var(--pm-border); }
.pm-btn--ghost:hover { color: var(--pm-blue); border-color: var(--pm-blue); text-decoration: none; }
.pm-btn--primary { background: var(--pm-blue); color: #fff; border-color: var(--pm-blue); }
.pm-btn--primary:hover:not(:disabled) { background: var(--pm-blue-d); border-color: var(--pm-blue-d); text-decoration: none; color: #fff; }
.pm-btn--danger { background: #dc2626; color: #fff; border-color: #dc2626; }
.pm-btn--danger:hover:not(:disabled) { background: #b91c1c; border-color: #b91c1c; }
.pm-btn:disabled { opacity: .4; cursor: not-allowed; }

/* Toolbar */
.pm-toolbar { background: #fff; border: 1px solid var(--pm-border); border-radius: 10px; padding: 12px 16px;
              display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
.pm-toolbar__filter { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; flex: 1; min-width: 0; }
.pm-toolbar__actions { display: flex; gap: 6px; flex-wrap: wrap; }
.pm-input { padding: 8px 12px; border: 1px solid var(--pm-border); border-radius: 6px; font-size: 13px; min-width: 220px; }
.pm-input:focus { outline: none; border-color: var(--pm-blue); box-shadow: 0 0 0 2px rgba(37,99,235,.1); }
.pm-select { padding: 8px 10px; border: 1px solid var(--pm-border); border-radius: 6px; font-size: 13px; background: #fff; min-width: 140px; }
.pm-select:focus { outline: none; border-color: var(--pm-blue); }

/* Action bar (3 main workflows) */
.pm-actions { background: linear-gradient(135deg, #eff6ff, #f8fafc); border: 1px solid #bfdbfe; border-radius: 10px;
              padding: 14px 16px; margin-bottom: 14px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.pm-actions__label { font-size: 12px; color: var(--pm-muted); font-weight: 600; text-transform: uppercase;
                      letter-spacing: .04em; margin-right: 6px; }
.pm-action-btn { padding: 10px 16px; background: #fff; border: 1px solid var(--pm-blue); color: var(--pm-blue);
                  border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;
                  display: inline-flex; align-items: center; gap: 8px; transition: all .15s ease; }
.pm-action-btn:hover { background: var(--pm-blue); color: #fff; box-shadow: 0 4px 10px rgba(37,99,235,.25); }
.pm-action-btn__icon { font-size: 16px; }

/* Table */
.pm-tablewrap { background: #fff; border: 1px solid var(--pm-border); border-radius: 10px; overflow: hidden; }
.pm-table-head { padding: 10px 16px; border-bottom: 1px solid var(--pm-border); display: flex;
                  justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
.pm-table-info { font-size: 13px; color: var(--pm-text); }
.pm-table-info b { color: var(--pm-blue); }
.pm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.pm-table th { text-align: left; padding: 11px 14px; background: #f8fafc; color: var(--pm-muted);
                font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
                border-bottom: 1px solid var(--pm-border); }
.pm-table td { padding: 10px 14px; border-bottom: 1px solid #f1f5f9; color: var(--pm-text); vertical-align: middle; }
.pm-table tbody tr:hover td { background: #fafbfc; }
.pm-table input[type=checkbox] { cursor: pointer; }
.pm-table__noname { color: var(--pm-muted); font-style: italic; }
.pm-table small { color: var(--pm-muted); }

/* Hierarchy path styling */
.pm-grouppath { color: var(--pm-muted); font-size: 12px; }
.pm-grouppath__leaf { color: var(--pm-text); font-weight: 600; font-size: 13px; }
.pm-grouppath__sep { color: #cbd5e1; margin: 0 4px; }

.pm-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; }
.pm-badge--p { background: #dbeafe; color: #1d4ed8; }
.pm-badge--v { background: #ede9fe; color: #6d28d9; }
.pm-badge--vd { background: #fee2e2; color: #b91c1c; }

.pm-revoke-btn { padding: 5px 10px; background: #fff; border: 1px solid #fecaca; color: #dc2626;
                  border-radius: 5px; font-size: 11px; font-weight: 600; cursor: pointer; }
.pm-revoke-btn:hover { background: #fef2f2; border-color: #f87171; }

.pm-pager { padding: 12px 16px; display: flex; justify-content: space-between; align-items: center;
            border-top: 1px solid var(--pm-border); gap: 10px; flex-wrap: wrap; }
.pm-pager__info { font-size: 12px; color: var(--pm-muted); }
.pm-pager__nav { display: flex; gap: 4px; align-items: center; font-size: 13px; }
.pm-pager__nav button { padding: 5px 12px; border: 1px solid var(--pm-border); background: #fff;
                         color: var(--pm-muted); border-radius: 6px; font-size: 12px; cursor: pointer; }
.pm-pager__nav button:hover:not(:disabled) { color: var(--pm-blue); border-color: var(--pm-blue); }
.pm-pager__nav button:disabled { opacity: .4; cursor: not-allowed; }

/* Loading / empty */
.pm-loading { padding: 50px; text-align: center; color: var(--pm-muted); font-size: 13px; }
.pm-loading::before { content:''; display:inline-block; width:14px; height:14px;
    border: 2px solid var(--pm-border); border-top-color: var(--pm-blue); border-radius: 50%;
    animation: pm-spin .8s linear infinite; margin-right: 10px; vertical-align: middle; }
@@keyframes pm-spin { to { transform: rotate(360deg); } }
.pm-empty { padding: 60px 20px; text-align: center; color: #94a3b8; }
.pm-empty__icon { font-size: 42px; opacity: .4; margin-bottom: 12px; }
.pm-empty__title { font-weight: 600; color: var(--pm-muted); margin-bottom: 4px; }
.pm-empty__hint { font-size: 12px; }

/* Modal - z-index cao hon global header (thuong 999), padding-top de tranh header */
.pm-modal-bg { position: fixed; inset: 0; background: rgba(15,23,42,.6); z-index: 99999;
               display: none; align-items: flex-start; justify-content: center;
               padding: 80px 20px 40px; overflow-y: auto; }
.pm-modal-bg.show { display: flex; }
.pm-modal { background: #fff; border-radius: 14px; max-width: 700px; width: 100%;
            box-shadow: 0 20px 50px rgba(0,0,0,.3); margin-bottom: 40px; }
.pm-modal__hd { padding: 16px 22px; border-bottom: 1px solid var(--pm-border);
                display: flex; justify-content: space-between; align-items: center; }
.pm-modal__title { font-size: 16px; font-weight: 700; color: var(--pm-text); margin: 0; }
.pm-modal__close { background: transparent; border: 0; font-size: 22px; color: var(--pm-muted);
                    cursor: pointer; padding: 0; width: 28px; height: 28px; border-radius: 50%; }
.pm-modal__close:hover { background: #f1f5f9; color: var(--pm-text); }
.pm-modal__body { padding: 18px 22px; max-height: calc(100vh - 220px); overflow-y: auto; }
.pm-modal__ft { padding: 14px 22px; border-top: 1px solid var(--pm-border);
                display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }

/* Form fields */
.pm-fld { margin-bottom: 16px; }
.pm-fld__lbl { display: block; font-size: 12px; font-weight: 600; color: var(--pm-text);
               margin-bottom: 6px; }
.pm-fld__lbl b { color: var(--pm-blue); }
.pm-fld input[type=text], .pm-fld input[type=search], .pm-fld select, .pm-fld textarea {
    width: 100%; padding: 9px 12px; border: 1px solid var(--pm-border); border-radius: 7px;
    font-size: 13px; box-sizing: border-box; font-family: inherit;
}
.pm-fld input:focus, .pm-fld select:focus, .pm-fld textarea:focus {
    outline: none; border-color: var(--pm-blue); box-shadow: 0 0 0 2px rgba(37,99,235,.12);
}
.pm-fld textarea { resize: vertical; min-height: 90px; font-family: monospace; font-size: 12px; }
.pm-fld__hint { font-size: 11px; color: var(--pm-muted); margin-top: 4px; line-height: 1.4; }

/* Step indicator inside modal */
.pm-steps { display: flex; gap: 4px; margin-bottom: 16px; }
.pm-step { flex: 1; padding: 8px 10px; border-radius: 6px; background: #f1f5f9; font-size: 12px;
            color: var(--pm-muted); text-align: center; font-weight: 600; }
.pm-step.active { background: var(--pm-blue); color: #fff; }
.pm-step.done { background: #dcfce7; color: #166534; }

/* User/content picker inside modals */
.pm-pick { border: 1px solid var(--pm-border); border-radius: 8px; max-height: 220px; overflow-y: auto;
            background: #fff; margin-bottom: 10px; }
.pm-pick__item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; cursor: pointer;
                  font-size: 13px; border-bottom: 1px solid #f1f5f9; }
.pm-pick__item:last-child { border-bottom: 0; }
.pm-pick__item:hover { background: var(--pm-blue-l); }
.pm-pick__item input { flex-shrink: 0; cursor: pointer; }
.pm-pick__item__main { flex: 1; min-width: 0; overflow: hidden; }
.pm-pick__item__name { font-weight: 600; color: var(--pm-text); }
.pm-pick__item__meta { font-size: 11px; color: var(--pm-muted); }

.pm-pick-toolbar { padding: 6px 10px; background: #f8fafc; border-bottom: 1px solid var(--pm-border);
                    font-size: 11px; color: var(--pm-muted); display: flex; justify-content: space-between; align-items: center; }
.pm-pick-toolbar a { color: var(--pm-blue); cursor: pointer; }

.pm-mode-radio { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
.pm-mode-radio label { display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px;
                       border: 1px solid var(--pm-border); border-radius: 8px; cursor: pointer;
                       transition: all .12s ease; }
.pm-mode-radio label:hover { background: #f8fafc; }
.pm-mode-radio input { margin-top: 2px; }
.pm-mode-radio input:checked + .pm-mode-radio__main { color: var(--pm-blue); }
.pm-mode-radio label:has(input:checked) { background: var(--pm-blue-l); border-color: var(--pm-blue); }
.pm-mode-radio__main b { font-size: 13px; color: var(--pm-text); }
.pm-mode-radio__main small { display: block; color: var(--pm-muted); font-size: 11px; margin-top: 2px; }

/* Preview result inside modal */
.pm-preview { background: #f8fafc; border: 1px solid var(--pm-border); border-radius: 8px;
              padding: 12px 14px; margin: 12px 0; }
.pm-preview__title { font-size: 12px; color: var(--pm-muted); font-weight: 600;
                      text-transform: uppercase; letter-spacing: .04em; margin-bottom: 6px; }
.pm-preview__nums { display: flex; gap: 18px; flex-wrap: wrap; }
.pm-preview__num { text-align: center; }
.pm-preview__num__n { font-size: 22px; font-weight: 700; }
.pm-preview__num__lbl { font-size: 11px; color: var(--pm-muted); }
.pm-preview__num--new .pm-preview__num__n { color: #16a34a; }
.pm-preview__num--exist .pm-preview__num__n { color: #94a3b8; }
.pm-preview__num--total .pm-preview__num__n { color: var(--pm-blue); }
.pm-warn { background: #fef3c7; border: 1px solid #fde68a; border-radius: 6px; padding: 8px 12px;
            margin-top: 8px; font-size: 12px; color: #78350f; }

.pm-result-msg { margin-top: 14px; padding: 12px 14px; border-radius: 8px; font-size: 13px; }
.pm-result-msg--ok { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
.pm-result-msg--err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

/* Resolve preview */
.pm-resolve { margin-top: 10px; font-size: 12px; }
.pm-resolve__sec { padding: 4px 8px; border-radius: 6px; margin-bottom: 6px; }
.pm-resolve__ok { background: #dcfce7; color: #166534; }
.pm-resolve__err { background: #fef2f2; color: #b91c1c; }
</style>

<div class="app-main__outer">
<div class="app-main__inner">
<div class="pm">

    <div class="pm-hd">
        <div>
            <h2>🔐 Quản lý phân quyền View360</h2>
            <div class="pm-hd__sub">Xem toàn bộ quyền đã cấp · Cấp mới qua 3 cách phổ biến · Rà soát bất thường.</div>
        </div>
        <div class="pm-hd__actions">
            <a href="@Url.Action("Audit", "Permission")" class="pm-btn pm-btn--ghost">⚠ Rà soát</a>
            <a href="@Url.Action("Index", "Projects")" class="pm-btn pm-btn--ghost">← Quản lý dự án</a>
        </div>
    </div>

    @* ===== 3 ACTION BUTTONS ===== *@
    <div class="pm-actions">
        <span class="pm-actions__label">Cấp quyền mới:</span>
        <button type="button" class="pm-action-btn" id="pm-act-user" @(canGrant ? "" : "disabled")>
            <span class="pm-action-btn__icon">👤</span> Cho 1 người dùng
        </button>
        <button type="button" class="pm-action-btn" id="pm-act-dept" @(canGrant ? "" : "disabled")>
            <span class="pm-action-btn__icon">🏢</span> Cho cả phòng ban
        </button>
        <button type="button" class="pm-action-btn" id="pm-act-copy" @(canGrant ? "" : "disabled")>
            <span class="pm-action-btn__icon">📋</span> Sao chép từ người dùng khác
        </button>
        <button type="button" class="pm-action-btn" id="pm-act-paste" @(canGrant ? "" : "disabled")>
            <span class="pm-action-btn__icon">📎</span> Dán mã NV (Excel)
        </button>
    </div>

    @* ===== FILTER TOOLBAR ===== *@
    <div class="pm-toolbar">
        <div class="pm-toolbar__filter">
            <input type="text" id="pm-q" class="pm-input" placeholder="🔎 Tìm tên NV / mã NV / tên nhóm..." />
            <select id="pm-f-dept" class="pm-select">
                <option value="">Tất cả phòng ban</option>
            </select>
            <select id="pm-f-type" class="pm-select">
                <option value="">Tất cả loại</option>
                <option value="1">Project</option>
                <option value="2">Virtual</option>
                <option value="3">Video</option>
            </select>
            <select id="pm-f-pgroup" class="pm-select" title="Lọc theo nhóm Project (gồm nhóm con)">
                <option value="">Tất cả nhóm Project</option>
            </select>
            <button type="button" class="pm-btn pm-btn--ghost" id="pm-f-apply">Lọc</button>
            <button type="button" class="pm-btn pm-btn--ghost" id="pm-f-reset">Đặt lại</button>
        </div>
    </div>

    @* ===== TABLE ===== *@
    <div class="pm-tablewrap">
        <div class="pm-table-head">
            <div class="pm-table-info">
                Đang có <b id="pm-total">—</b> nhóm quyền (đã lọc) — mỗi dòng = 1 người dùng × 1 nhóm.
                <span id="pm-selected-info" style="display:none;color:#dc2626;margin-left:10px;">
                    Đã chọn: <b id="pm-selected-count">0</b>
                </span>
            </div>
            <div>
                <button type="button" class="pm-btn pm-btn--danger" id="pm-bulk-revoke" disabled @(canRevoke ? "" : "style=display:none")>
                    ✕ Gỡ <span id="pm-bulk-count">0</span> đã chọn
                </button>
            </div>
        </div>
        <div style="overflow-x:auto;">
            <table class="pm-table" id="pm-table">
                <thead>
                    <tr>
                        <th style="width:36px;"><input type="checkbox" id="pm-check-all" /></th>
                        <th style="width:90px;">Loại</th>
                        <th>Người được cấp</th>
                        <th>Phòng ban</th>
                        <th>Nhóm nội dung</th>
                        <th style="width:90px;text-align:right;">Số nội dung</th>
                        <th style="width:130px;">Cấp lúc (mới nhất)</th>
                        <th style="width:80px;"></th>
                    </tr>
                </thead>
                <tbody id="pm-tbody">
                    <tr><td colspan="8"><div class="pm-loading">Đang tải...</div></td></tr>
                </tbody>
            </table>
        </div>
        <div class="pm-pager" id="pm-pager"></div>
    </div>

</div>
</div>
</div>

@* ===== MODAL CONTAINER ===== *@
<div class="pm-modal-bg" id="pm-mb">
    <div class="pm-modal">
        <div class="pm-modal__hd">
            <h3 class="pm-modal__title" id="pm-m-title"></h3>
            <button type="button" class="pm-modal__close" data-close>✕</button>
        </div>
        <div class="pm-modal__body" id="pm-m-body"></div>
        <div class="pm-modal__ft" id="pm-m-ft">
            <span id="pm-m-ft-left"></span>
            <span>
                <button type="button" class="pm-btn pm-btn--ghost" data-close>Hủy</button>
                <button type="button" class="pm-btn pm-btn--primary" id="pm-m-confirm">Xác nhận</button>
            </span>
        </div>
    </div>
</div>

<script>
(function () {
'use strict';

var base = '@Url.Content("~/")' + 'View360/Permission/';
var canGrant = @(canGrant ? "true" : "false");
var canRevoke = @(canRevoke ? "true" : "false");

var state = {
    page: 1, pageSize: 50,
    filter: { search: '', phongBanId: '', type: '', rootGroupId: '' },
    selected: new Set(),  // key = type-userId-groupId
    cachedDepts: null
};

// ========== utils ==========
function $(s, c) { return (c || document).querySelector(s); }
function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }
function escapeHtml(s) {
    return (s == null ? '' : String(s)).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmt(n) { return (n == null ? '0' : String(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

// Render hierarchy path "HPDQ 2 / Cán 4" with parent crumbs muted + leaf bold
function renderGroupPath(fullPath, leafName) {
    if (!fullPath) return '<span class="pm-grouppath__leaf">' + escapeHtml(leafName || '') + '</span>';
    var parts = fullPath.split(' / ');
    if (parts.length <= 1) {
        return '<span class="pm-grouppath__leaf">' + escapeHtml(fullPath) + '</span>';
    }
    var crumbs = parts.slice(0, -1).map(function (p) { return escapeHtml(p); }).join('<span class="pm-grouppath__sep">/</span>');
    return '<span class="pm-grouppath">' + crumbs + '</span>' +
           '<span class="pm-grouppath__sep">/</span>' +
           '<span class="pm-grouppath__leaf">' + escapeHtml(parts[parts.length - 1]) + '</span>';
}
function debounce(fn, ms) { var t; return function () { var a = arguments, s = this;
    clearTimeout(t); t = setTimeout(function () { fn.apply(s, a); }, ms); }; }

function api(path, opts) {
    return fetch(base + path, opts || {}).then(function (r) {
        return r.text().then(function (t) {
            if (!t) return null;
            try { var d = JSON.parse(t); if (d && d.error === true) throw new Error(d.message); return d; }
            catch (e) { throw e instanceof Error ? e : new Error('Lỗi máy chủ'); }
        });
    });
}
function jsonPost(path, body) {
    return api(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
}

// ========== Modal ==========
function openModal(title, bodyHtml, confirmLabel, onConfirm, leftFooter) {
    $('#pm-m-title').textContent = title;
    $('#pm-m-body').innerHTML = bodyHtml;
    $('#pm-m-confirm').textContent = confirmLabel || 'Xác nhận';
    $('#pm-m-ft-left').innerHTML = leftFooter || '';
    $('#pm-m-confirm').onclick = function () { onConfirm($('#pm-m-body')); };
    $('#pm-mb').classList.add('show');
}
function closeModal() {
    $('#pm-mb').classList.remove('show');
    $('#pm-m-confirm').disabled = false;
    $('#pm-m-confirm').textContent = 'Xác nhận';
}
$$('#pm-mb [data-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
$('#pm-mb').addEventListener('click', function (e) { if (e.target === this) closeModal(); });
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

function updateModalConfirm(label, disabled) {
    $('#pm-m-confirm').textContent = label;
    $('#pm-m-confirm').disabled = !!disabled;
}

// ========== Load PhongBans cache ==========
function loadPhongBans() {
    if (state.cachedDepts) return Promise.resolve(state.cachedDepts);
    return api('PhongBans').then(function (rows) { state.cachedDepts = rows; return rows; });
}

// Populate dept dropdown in main filter
loadPhongBans().then(function (rows) {
    var $sel = $('#pm-f-dept');
    rows.forEach(function (r) {
        var o = document.createElement('option');
        o.value = r.id; o.textContent = r.name;
        $sel.appendChild(o);
    });
});

// Populate Project group dropdown (with hierarchy indent)
api('Groups?type=1').then(function (rows) {
    var $sel = $('#pm-f-pgroup');
    rows.forEach(function (g) {
        var o = document.createElement('option');
        o.value = g.id;
        o.textContent = (g.depth > 0 ? '— '.repeat(g.depth) + ' ' : '') + g.name;
        $sel.appendChild(o);
    });
});

// ========== Main table ==========
function loadTable() {
    var f = state.filter;
    var qs = 'page=' + state.page + '&pageSize=' + state.pageSize;
    if (f.search) qs += '&search=' + encodeURIComponent(f.search);
    if (f.phongBanId) qs += '&phongBanId=' + f.phongBanId;
    if (f.type) qs += '&type=' + f.type;
    if (f.rootGroupId) qs += '&rootGroupId=' + f.rootGroupId;
    // Selection theo PHẠM VI TRANG hiện tại: rowData được dựng lại mỗi lần render nên key
    // ở trang/bộ lọc khác sẽ thành "mồ côi" -> đếm sai (vd 16 chọn / 15 dòng) và bulk revoke
    // rơi vào nhánh fallback. Clear khi tải lại bảng để selection luôn khớp dòng đang thấy.
    state.selected.clear();
    $('#pm-tbody').innerHTML = '<tr><td colspan="8"><div class="pm-loading">Đang tải...</div></td></tr>';
    return api('ListGrants?' + qs).then(function (d) {
        $('#pm-total').textContent = fmt(d.total);
        renderRows(d.rows || []);
        renderPager(d.page, d.totalPages, d.total);
        updateSelectedUI();
    }).catch(function (err) {
        $('#pm-tbody').innerHTML = '<tr><td colspan="8"><div class="pm-empty">' +
            '<div class="pm-empty__icon">⚠</div><div class="pm-empty__title">Lỗi tải dữ liệu</div>' +
            '<div class="pm-empty__hint">' + escapeHtml(err.message) + '</div></div></td></tr>';
    });
}

function renderRows(rows) {
    if (rows.length === 0) {
        $('#pm-tbody').innerHTML = '<tr><td colspan="8"><div class="pm-empty">' +
            '<div class="pm-empty__icon">📭</div>' +
            '<div class="pm-empty__title">Không có quyền nào khớp bộ lọc</div>' +
            '<div class="pm-empty__hint">Đổi bộ lọc hoặc bấm "Đặt lại" để xem hết.</div>' +
            '</div></td></tr>';
        return;
    }
    // Cache row data for bulk revoke
    state.rowData = {};
    $('#pm-tbody').innerHTML = rows.map(function (r) {
        // Key = type-userId-groupId-grantType (group-grant vs file-grants có thể trùng group → 2 rows)
        var key = r.type + '-' + r.nhanVienId + '-' + r.groupId + '-' + (r.grantType || 0);
        state.rowData[key] = r;
        var typeCls = r.type === 1 ? 'p' : (r.type === 2 ? 'v' : 'vd');
        var unit = r.type === 1 ? 'dự án' : (r.type === 2 ? 'tour' : 'video');

        // Grant type badge: 📂 Group-grant (auto-inherit) vs 📄 File-grants legacy
        var grantBadge;
        if (r.grantType === 1) {
            grantBadge = '<span title="Cấp ở mức NHÓM — tự kế thừa nội dung mới khi admin thêm vào nhóm" ' +
                'style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;margin-left:4px;">' +
                '📂 Nhóm' + (r.isRecursive ? ' (gồm nhóm con)' : '') + '</span>';
        } else {
            grantBadge = '<span title="Quyền lẻ từng nội dung (cũ) — KHÔNG kế thừa nội dung mới" ' +
                'style="background:#fef3c7;color:#78350f;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;margin-left:4px;">' +
                '📄 Lẻ</span>';
        }

        return '<tr data-key="' + key + '">' +
            '<td><input type="checkbox" class="pm-row-check"' +
                (state.selected.has(key) ? ' checked' : '') + ' /></td>' +
            '<td><span class="pm-badge pm-badge--' + typeCls + '">' + r.typeName + '</span>' + grantBadge + '</td>' +
            '<td><b>' + escapeHtml(r.hoTen) + '</b> <small>· ' + escapeHtml(r.maNV || '') + '</small></td>' +
            '<td>' + escapeHtml(r.phongBan || '—') + '</td>' +
            '<td>' + renderGroupPath(r.groupName, r.groupNameLeaf) + '</td>' +
            '<td style="text-align:right"><span style="background:#f1f5f9;color:#475569;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:600;">' +
                fmt(r.contentCount) + ' ' + unit + '</span></td>' +
            '<td><small>' + escapeHtml(r.lastCreatedate) + '</small></td>' +
            '<td>' + (canRevoke ? '<button class="pm-revoke-btn" data-revoke-key="' + key + '">✕ Gỡ</button>' : '') + '</td>' +
            '</tr>';
    }).join('');

    // Wire checkboxes
    $$('.pm-row-check').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var key = cb.closest('tr').dataset.key;
            if (cb.checked) state.selected.add(key);
            else state.selected.delete(key);
            updateSelectedUI();
        });
    });
    // Wire single revoke
    $$('[data-revoke-key]').forEach(function (b) {
        b.addEventListener('click', function () {
            var key = b.dataset.revokeKey;
            var r = state.rowData[key];
            if (!r) return;
            var unit = r.type === 1 ? 'dự án' : (r.type === 2 ? 'tour' : 'video');
            var msg = r.grantType === 1
                ? 'Gỡ quyền NHÓM "' + r.groupName + '" của người dùng ' + r.hoTen +
                  '? (người dùng sẽ không còn tự kế thừa ' + unit + ' mới)'
                : 'Gỡ ' + r.contentCount + ' ' + unit + ' lẻ trong nhóm "' + r.groupName + '" của người dùng ' + r.hoTen + '?';
            if (!confirm(msg)) return;
            b.disabled = true; b.textContent = '...';

            var payload;
            if (r.grantType === 1) {
                // Revoke group-grant
                payload = { Groups: [{ UserId: r.nhanVienId, Type: r.type, GroupId: r.groupId, Recursive: false }] };
            } else {
                // Revoke ALL file-grants for this user in this group
                // Backend: dùng Items + expand server-side... thực tế client cần list content IDs.
                // Đơn giản: gửi Groups với cờ "ScopeFileOnly" — nhưng schema chưa hỗ trợ.
                // Workaround: client query content IDs trong group rồi pass Items.
                // Tạm: dùng Groups - server sẽ expand file-grants matching group.
                payload = { Groups: [{ UserId: r.nhanVienId, Type: r.type, GroupId: r.groupId, Recursive: false, ScopeFileOnly: true }] };
            }

            jsonPost('Revoke', payload).then(function (d) {
                alert('Đã gỡ ' + d.deleted + ' bản ghi quyền.');
                state.selected.delete(key);
                loadTable();
            }).catch(function (err) {
                alert('Lỗi: ' + err.message);
                b.disabled = false; b.textContent = '✕ Gỡ';
            });
        });
    });
}

function renderPager(page, totalPages, total) {
    var $p = $('#pm-pager');
    if (!total) { $p.innerHTML = ''; return; }
    var info = 'Trang ' + page + '/' + Math.max(1, totalPages) + ' · ' + fmt(total) + ' quyền';
    var nav = '';
    if (totalPages > 1) {
        nav =
            '<button type="button" data-page="1"' + (page <= 1 ? ' disabled' : '') + '>«</button>' +
            '<button type="button" data-page="' + (page - 1) + '"' + (page <= 1 ? ' disabled' : '') + '>‹ Trước</button>' +
            '<button type="button" data-page="' + (page + 1) + '"' + (page >= totalPages ? ' disabled' : '') + '>Sau ›</button>' +
            '<button type="button" data-page="' + totalPages + '"' + (page >= totalPages ? ' disabled' : '') + '>»</button>';
    }
    $p.innerHTML = '<div class="pm-pager__info">' + info + '</div><div class="pm-pager__nav">' + nav + '</div>';
    $p.querySelectorAll('[data-page]').forEach(function (b) {
        b.onclick = function () {
            var p = parseInt(b.dataset.page, 10);
            if (p >= 1 && p <= totalPages) { state.page = p; loadTable(); }
        };
    });
}

function updateSelectedUI() {
    var n = state.selected.size;
    var $cnt = $('#pm-bulk-count');
    if ($cnt) $cnt.textContent = n;   // span có thể tạm mất khi nút đang "Đang xử lý..."
    $('#pm-bulk-revoke').disabled = n === 0;
    $('#pm-selected-info').style.display = n > 0 ? '' : 'none';
    $('#pm-selected-count').textContent = n;
    // Sync check-all
    var visible = $$('.pm-row-check');
    var allChecked = visible.length > 0 && visible.every(function (cb) { return cb.checked; });
    $('#pm-check-all').checked = allChecked;
}

// Check-all
$('#pm-check-all').addEventListener('change', function () {
    var on = this.checked;
    $$('.pm-row-check').forEach(function (cb) {
        cb.checked = on;
        var key = cb.closest('tr').dataset.key;
        if (on) state.selected.add(key);
        else state.selected.delete(key);
    });
    updateSelectedUI();
});

// Bulk revoke
$('#pm-bulk-revoke').addEventListener('click', function () {
    if (state.selected.size === 0) return;
    if (!confirm('Gỡ ' + state.selected.size + ' nhóm quyền đã chọn?')) return;
    // Key = "type-userId-groupId-grantType". Phải phân biệt grantType giống nút Gỡ từng dòng:
    //   grantType 1 = group-grant -> xoá row trong AuthorizationUSER_Group
    //   grantType 0 = file-grant lẻ -> ScopeFileOnly=true để xoá file-grants trong nhóm
    // (Bug cũ: luôn gửi group-revoke -> với quyền Lẻ backend xoá 0 bản ghi.)
    var groups = Array.from(state.selected).map(function (k) {
        var r = state.rowData[k];
        if (r) {
            return { UserId: r.nhanVienId, Type: r.type, GroupId: r.groupId,
                     Recursive: false, ScopeFileOnly: r.grantType !== 1 };
        }
        var p = k.split('-');
        return { UserId: parseInt(p[1], 10), Type: parseInt(p[0], 10), GroupId: parseInt(p[2], 10),
                 Recursive: false, ScopeFileOnly: parseInt(p[3], 10) !== 1 };
    });
    var btn = this;
    btn.disabled = true; btn.textContent = 'Đang xử lý...';
    jsonPost('Revoke', { Groups: groups }).then(function (d) {
        alert('Đã gỡ ' + d.deleted + ' quyền (từ ' + groups.length + ' nhóm đã chọn).');
        state.selected.clear();
        loadTable();
    }).catch(function (err) {
        alert('Lỗi: ' + err.message);
    }).then(function () {
        // Khôi phục lại cấu trúc nút (tạo lại <span id="pm-bulk-count">) rồi đồng bộ trạng thái.
        // Bug cũ: gán textContent làm mất span -> số đếm trên nút kẹt ở 0, lệch với "Đã chọn".
        btn.innerHTML = '✕ Gỡ <span id="pm-bulk-count">0</span> đã chọn';
        updateSelectedUI();
    });
});

// Filter handlers
function applyFilter() {
    state.filter.search = $('#pm-q').value.trim();
    state.filter.phongBanId = $('#pm-f-dept').value;
    state.filter.type = $('#pm-f-type').value;
    state.filter.rootGroupId = $('#pm-f-pgroup').value;
    state.page = 1;
    state.selected.clear();
    updateSelectedUI();
    loadTable();
}
$('#pm-f-apply').addEventListener('click', applyFilter);
$('#pm-q').addEventListener('keydown', function (e) { if (e.key === 'Enter') applyFilter(); });
$('#pm-f-dept').addEventListener('change', applyFilter);
$('#pm-f-type').addEventListener('change', applyFilter);
$('#pm-f-pgroup').addEventListener('change', applyFilter);
$('#pm-f-reset').addEventListener('click', function () {
    $('#pm-q').value = ''; $('#pm-f-dept').value = ''; $('#pm-f-type').value = '';
    $('#pm-f-pgroup').value = '';
    applyFilter();
});

