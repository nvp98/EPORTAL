                '✓ <b>' + escapeHtml(name) + '</b> — ' + deptUsers.length + ' NV đang hoạt động sẽ được cấp.</div>';
            $('#d1-step2').style.display = 'block';
            wireGroupPicker(groupSel);
            updatePreview();
        });
    });
});

// ========== Modal: Copy từ user ==========
$('#pm-act-copy').addEventListener('click', function () {
    var sourceUser = null, copyItems = [];
    var targetUsers = new Map(); // id -> user

    var body =
        '<div class="pm-fld">' +
            '<label class="pm-fld__lbl">① Người dùng <b>nguồn</b> (sẽ sao chép quyền của người dùng này)</label>' +
            '<input type="text" id="c1-src" placeholder="Tên hoặc mã NV..." />' +
            '<div class="pm-pick" id="c1-src-list" style="display:none;"></div>' +
            '<div id="c1-src-info" style="margin-top:8px;"></div>' +
        '</div>' +
        '<div id="c1-step2" style="display:none;">' +
            '<label class="pm-fld__lbl">② Người dùng <b>đích</b> (1 hoặc nhiều, sẽ nhận cùng quyền)</label>' +
            '<input type="text" id="c1-tgt" placeholder="Gõ tên / mã NV để thêm..." />' +
            '<div class="pm-pick" id="c1-tgt-list" style="display:none;"></div>' +
            '<div id="c1-tgt-chips" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px;"></div>' +
        '</div>' +
        '<div id="c1-preview"></div>';

    openModal('📋 Sao chép quyền từ người dùng khác', body, 'Cấp 0 quyền mới', function () {
        execGrant({
            UserIds: Array.from(targetUsers.keys()),
            Items: copyItems.map(function (it) { return { Type: it.type, Id: it.id }; })
        });
    });
    updateModalConfirm('Cấp 0 quyền mới', true);

    function updatePreview() {
        var ids = Array.from(targetUsers.keys());
        if (ids.length === 0 || copyItems.length === 0) {
            $('#c1-preview').innerHTML = '';
            updateModalConfirm('Cấp 0 quyền mới', true);
            return;
        }
        runPreview({
            UserIds: ids,
            Items: copyItems.map(function (it) { return { Type: it.type, Id: it.id }; })
        }, function (p) {
            $('#c1-preview').innerHTML = renderPreview(p);
            if (p && !p.error) updateModalConfirm('+ Cấp ' + fmt(p.notExisting) + ' quyền mới', !canGrant || p.notExisting === 0);
        });
    }

    function searchAndShowList(input, listEl, onPick) {
        input.addEventListener('input', debounce(function () {
            if (!input.value.trim()) { listEl.style.display = 'none'; return; }
            api('Users?limit=20&search=' + encodeURIComponent(input.value.trim())).then(function (rows) {
                listEl.style.display = 'block';
                if (!rows || rows.length === 0) {
                    listEl.innerHTML = '<div class="pm-empty"><div class="pm-empty__hint">Không tìm thấy</div></div>';
                    return;
                }
                listEl.innerHTML = rows.map(function (r) {
                    return '<div class="pm-pick__item" data-uid="' + r.id +
                        '" data-name="' + escapeHtml(r.hoTen) +
                        '" data-manv="' + escapeHtml(r.maNV || '') +
                        '" data-pb="' + escapeHtml(r.phongBan || '') + '">' +
                        '<span class="pm-pick__item__main">' +
                            '<div class="pm-pick__item__name">' + escapeHtml(r.hoTen) + '</div>' +
                            '<div class="pm-pick__item__meta">' + escapeHtml(r.maNV || '') + ' · ' + escapeHtml(r.phongBan || '—') + '</div>' +
                        '</span></div>';
                }).join('');
                listEl.querySelectorAll('[data-uid]').forEach(function (el) {
                    el.onclick = function () {
                        onPick({
                            id: parseInt(el.dataset.uid, 10),
                            hoTen: el.dataset.name, maNV: el.dataset.manv, phongBan: el.dataset.pb
                        });
                    };
                });
            });
        }, 250));
    }

    // Source picker
    searchAndShowList($('#c1-src'), $('#c1-src-list'), function (u) {
        sourceUser = u;
        $('#c1-src').value = '';
        $('#c1-src-list').style.display = 'none';
        $('#c1-src-info').innerHTML = '<div class="pm-loading">Đang lấy quyền người dùng nguồn...</div>';
        api('CopyFromUser?userId=' + u.id).then(function (d) {
            if (!d.items || d.items.length === 0) {
                $('#c1-src-info').innerHTML = '<div class="pm-warn">⚠ Người dùng <b>' + escapeHtml(u.hoTen) +
                    '</b> chưa có quyền nội dung nào. Chọn người dùng khác.</div>';
                return;
            }
            copyItems = d.items;
            $('#c1-src-info').innerHTML = '<div style="background:#dcfce7;padding:8px 12px;border-radius:6px;font-size:13px;">' +
                '✓ <b>' + escapeHtml(u.hoTen) + '</b> có <b>' + d.items.length + '</b> quyền (Project/Virtual/Video). ' +
                'Sẽ sao chép y hệt cho (các) người dùng đích bên dưới.</div>';
            $('#c1-step2').style.display = 'block';
            updatePreview();
        });
    });

    // Target picker
    function refreshTargetChips() {
        $('#c1-tgt-chips').innerHTML = Array.from(targetUsers.values()).map(function (u) {
            return '<span style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:999px;padding:4px 10px;font-size:12px;display:inline-flex;align-items:center;gap:5px;">' +
                escapeHtml(u.hoTen) + ' <small style="color:#94a3b8;">· ' + escapeHtml(u.maNV) + '</small> ' +
                '<button type="button" data-rm="' + u.id + '" style="background:none;border:0;color:#dc2626;font-size:14px;cursor:pointer;padding:0;">✕</button></span>';
        }).join('');
        $('#c1-tgt-chips').querySelectorAll('[data-rm]').forEach(function (b) {
            b.onclick = function () { targetUsers.delete(parseInt(b.dataset.rm, 10)); refreshTargetChips(); updatePreview(); };
        });
    }
    searchAndShowList($('#c1-tgt'), $('#c1-tgt-list'), function (u) {
        if (sourceUser && u.id === sourceUser.id) { alert('Không sao chép cho chính người dùng nguồn'); return; }
        targetUsers.set(u.id, u);
        $('#c1-tgt').value = '';
        $('#c1-tgt-list').style.display = 'none';
        refreshTargetChips();
        updatePreview();
    });
});

// ========== Modal: Paste MaNV ==========
$('#pm-act-paste').addEventListener('click', function () {
    var matchedUsers = [];
    var groupSel = {};
    groupSel._selected = new Map();

    var body =
        '<div class="pm-fld">' +
            '<label class="pm-fld__lbl">① Dán danh sách mã NV</label>' +
            '<textarea id="p1-input" placeholder="HPDQ001\nHPDQ002\n..."></textarea>' +
            '<div class="pm-fld__hint">Sao chép cột mã NV từ Excel dán vào đây. Mã không tìm thấy sẽ được liệt kê.</div>' +
            '<button type="button" class="pm-btn pm-btn--ghost" id="p1-resolve" style="margin-top:8px;">🔍 Kiểm tra mã NV</button>' +
            '<div id="p1-result"></div>' +
        '</div>' +
        '<div id="p1-step2" style="display:none;">' +
            '<label class="pm-fld__lbl">② Chọn nhóm nội dung</label>' +
            buildGroupPickerHtml() +
        '</div>' +
        '<div id="p1-preview"></div>';

    openModal('📎 Dán mã NV (kiểu Excel)', body, 'Cấp 0 quyền mới', function () {
        var c = buildGrantContent(groupSel);
        execGrant({
            UserIds: matchedUsers.map(function (u) { return u.id; }),
            Groups: c.Groups, Items: c.Items
        });
    });
    updateModalConfirm('Cấp 0 quyền mới', true);

    groupSel.onChange = updatePreview;
    function updatePreview() {
        if (matchedUsers.length === 0) return;
        var c = buildGrantContent(groupSel);
        runPreview({
            UserIds: matchedUsers.map(function (u) { return u.id; }),
            Groups: c.Groups, Items: c.Items
        }, function (p) {
            $('#p1-preview').innerHTML = renderPreview(p);
            if (p && !p.error) updateModalConfirm('+ Cấp ' + fmt(p.notExisting) + ' quyền mới', !canGrant || p.notExisting === 0);
        });
    }

    $('#p1-resolve').addEventListener('click', function () {
        var raw = $('#p1-input').value;
        var manvs = raw.split(/[\s,;\r\n]+/).filter(function (s) { return s.trim(); });
        if (manvs.length === 0) { alert('Chưa dán mã nào'); return; }
        $('#p1-result').innerHTML = '<div class="pm-loading">Đang kiểm tra...</div>';
        jsonPost('ResolveMaNV', { MaNVs: manvs }).then(function (d) {
            matchedUsers = d.matched || [];
            var html = '';
            if (matchedUsers.length > 0) {
                html += '<div class="pm-resolve__sec pm-resolve__ok">' +
                    '✓ Tìm thấy <b>' + matchedUsers.length + '</b>: ' +
                    matchedUsers.slice(0, 30).map(function (m) {
                        return escapeHtml(m.maNV) + ' (' + escapeHtml(m.hoTen) + ')';
                    }).join(', ') +
                    (matchedUsers.length > 30 ? ', +' + (matchedUsers.length - 30) + ' khác' : '') +
                    '</div>';
            }
            if (d.unmatched && d.unmatched.length > 0) {
                html += '<div class="pm-resolve__sec pm-resolve__err">' +
                    '⚠ Không tìm thấy <b>' + d.unmatched.length + '</b>: ' + d.unmatched.join(', ') +
                    '</div>';
            }
            $('#p1-result').innerHTML = '<div class="pm-resolve">' + html + '</div>';
            if (matchedUsers.length > 0) {
                $('#p1-step2').style.display = 'block';
                wireGroupPicker(groupSel);
                updatePreview();
            }
        });
    });
});

// ========== Execute grant (shared) ==========
// payload = { UserIds, Items?, Groups? }
function execGrant(payload) {
    if (!payload.UserIds || payload.UserIds.length === 0) return;
    var $btn = $('#pm-m-confirm');
    $btn.disabled = true; $btn.textContent = 'Đang xử lý...';
    jsonPost('Grant', payload).then(function (d) {
        alert('✓ Đã cấp ' + d.created + ' quyền mới' +
            (d.skipped > 0 ? '. Bỏ qua ' + d.skipped + ' đã tồn tại.' : '.'));
        closeModal();
        loadTable();
    }).catch(function (err) {
        alert('Lỗi: ' + err.message);
        $btn.disabled = false; $btn.textContent = 'Thử lại';
    });
}

// ========== Init ==========
loadTable();

})();
</script>
