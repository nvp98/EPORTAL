function wireGroupPicker(getSelected) {
    var currentType = 1;
    var $q = $('#gp-q'), $list = $('#gp-list'), $sum = $('#gp-summary');

    // Hide global "Recursive" checkbox - giờ per-folder
    if ($('#gp-rec-wrap')) $('#gp-rec-wrap').style.display = 'none';

    // ===== State =====
    // _folders: Map<"type-groupId", {type, groupId, recursive, name, contentCount}>
    // _files:   Map<"f-type-fileId", {type, id, title}>
    if (!getSelected._folders) getSelected._folders = new Map();
    if (!getSelected._files)   getSelected._files   = new Map();
    var expandedFolders = new Set();   // key="type-gid"
    var folderFilesCache = {};         // "type-gid" -> [files]
    var folderCountCache = {};         // "type-gid-rec" -> count
    var allGroupsByType = {};          // type -> rows

    function key(type, gid) { return type + '-' + gid; }
    function keyf(type, fid) { return 'f-' + type + '-' + fid; }

    function refreshSummary() {
        var fSize = getSelected._folders.size, sSize = getSelected._files.size;
        if (fSize === 0 && sSize === 0) {
            $sum.textContent = 'Chưa chọn gì.';
            return;
        }
        // Folders breakdown by type
        var folderByType = { 1: 0, 2: 0, 3: 0 };
        var contentByType = { 1: 0, 2: 0, 3: 0 };
        getSelected._folders.forEach(function (f) {
            folderByType[f.type]++;
            contentByType[f.type] += (f.contentCount || 0);
        });
        var fileByType = { 1: 0, 2: 0, 3: 0 };
        getSelected._files.forEach(function (f) { fileByType[f.type]++; });

        var html = '';
        if (fSize > 0) {
            var parts = [];
            if (folderByType[1] > 0) parts.push('📁 ' + folderByType[1] + ' nhóm Project (' + contentByType[1] + ' DA)');
            if (folderByType[2] > 0) parts.push('🌐 ' + folderByType[2] + ' nhóm Virtual (' + contentByType[2] + ' tour)');
            if (folderByType[3] > 0) parts.push('🎬 ' + folderByType[3] + ' album Video (' + contentByType[3] + ' video)');
            html += '<div style="margin-bottom:4px;"><b style="color:#16a34a;">📂 Cấp NHÓM</b> (tự kế thừa):<br>' +
                '<span style="color:#475569;">' + parts.join(' · ') + '</span></div>';
        }
        if (sSize > 0) {
            var fparts = [];
            if (fileByType[1] > 0) fparts.push('📄 ' + fileByType[1] + ' Project');
            if (fileByType[2] > 0) fparts.push('📄 ' + fileByType[2] + ' Virtual');
            if (fileByType[3] > 0) fparts.push('📄 ' + fileByType[3] + ' Video');
            html += '<div><b style="color:#78350f;">📄 Cấp LẺ</b> (quyền lẻ, không kế thừa):<br>' +
                '<span style="color:#475569;">' + fparts.join(' · ') + '</span></div>';
        }
        $sum.innerHTML = html;
    }

    function fetchFolderCount(type, gid, recursive) {
        var k = key(type, gid) + '-' + (recursive ? '1' : '0');
        if (folderCountCache[k] != null) return Promise.resolve(folderCountCache[k]);
        var qs = 'type=' + type + '&groupId=' + gid + '&limit=10000';
        if (type === 1 && recursive) qs += '&recursive=true';
        return api('Contents?' + qs).then(function (rows) {
            var n = (rows || []).length;
            folderCountCache[k] = n;
            return n;
        });
    }

    function loadFilesInFolder(type, gid) {
        var k = key(type, gid);
        if (folderFilesCache[k]) return Promise.resolve(folderFilesCache[k]);
        // Direct content only (không recursive, file picker chỉ show direct)
        var qs = 'type=' + type + '&groupId=' + gid + '&limit=2000';
        return api('Contents?' + qs).then(function (rows) {
            folderFilesCache[k] = rows || [];
            return folderFilesCache[k];
        });
    }

    function loadGroupsForType(type) {
        if (allGroupsByType[type]) return Promise.resolve(allGroupsByType[type]);
        return api('Groups?type=' + type).then(function (rows) {
            allGroupsByType[type] = rows || [];
            return allGroupsByType[type];
        });
    }

    function renderTree() {
        var rows = (allGroupsByType[currentType] || []).slice();
        var q = ($q.value || '').toLowerCase().trim();
        if (q) rows = rows.filter(function (g) { return (g.name || '').toLowerCase().indexOf(q) >= 0; });

        if (rows.length === 0) {
            $list.innerHTML = '<div class="pm-empty"><div class="pm-empty__hint">Không có nhóm nào.</div></div>';
            return;
        }

        $list.innerHTML = rows.map(renderFolderRow).join('');
        wireRowHandlers();

        // Pre-fetch counts for visible groups
        rows.forEach(function (g) {
            var k = key(currentType, g.id);
            var folder = getSelected._folders.get(k);
            var rec = folder ? !!folder.recursive : false;
            fetchFolderCount(currentType, g.id, rec).then(function (cnt) {
                var $c = $list.querySelector('[data-cnt="' + k + '"]');
                if ($c) {
                    var unit = currentType === 1 ? 'DA' : (currentType === 2 ? 'tour' : 'video');
                    $c.textContent = cnt + ' ' + unit;
                }
                // Update folder.contentCount nếu selected
                if (folder) {
                    folder.contentCount = cnt;
                    refreshSummary();
                }
            });
        });
    }

    function renderFolderRow(group) {
        var k = key(currentType, group.id);
        var expanded = expandedFolders.has(k);
        var folder = getSelected._folders.get(k);
        var selected = !!folder;
        var recursive = folder ? folder.recursive : false;
        var depth = group.depth || 0;
        var indent = '';
        for (var i = 0; i < depth; i++) indent += '<span style="display:inline-block;width:14px;color:#cbd5e1;font-family:monospace;">│ </span>';
        if (depth > 0) indent = indent.substring(0, indent.length - '<span style="display:inline-block;width:14px;color:#cbd5e1;font-family:monospace;">│ </span>'.length) +
            '<span style="display:inline-block;width:14px;color:#cbd5e1;font-family:monospace;">└─</span>';

        var html = '<div class="gp-folder' + (selected ? ' gp-folder--selected' : '') + '" data-fkey="' + k + '">' +
            indent +
            '<button type="button" class="gp-expand" data-toggle="' + k + '">' + (expanded ? '▼' : '▶') + '</button>' +
            '<input type="checkbox" class="gp-folder-cb"' + (selected ? ' checked' : '') + ' />' +
            '<span class="gp-row__icon">' + (depth === 0 ? '📂' : '📁') + '</span>' +
            '<span class="gp-folder__name" title="' + escapeHtml(group.name) + '">' + escapeHtml(group.name) + '</span>' +
            '<span class="gp-row__count" data-cnt="' + k + '">…</span>' +
            (currentType === 1
                ? '<label class="gp-rec" title="Tự kế thừa cả nhóm con (cấp dưới)">' +
                  '<input type="checkbox" class="gp-rec-cb"' + (recursive ? ' checked' : '') + ' /> R</label>'
                : '') +
            '</div>';

        // Files inside (when expanded)
        if (expanded) {
            var files = folderFilesCache[k];
            if (!files) {
                html += '<div class="gp-files-loading">⏳ Đang tải nội dung...</div>';
            } else if (files.length === 0) {
                html += '<div class="gp-files"><div class="gp-row__hint">(Nhóm trống — không có nội dung trực tiếp)</div></div>';
            } else {
                html += '<div class="gp-files">';
                html += files.map(function (f) {
                    var fk = keyf(currentType, f.id);
                    var fchecked = getSelected._files.has(fk);
                    var coveredByFolder = selected;
                    var rowClass = 'gp-file' + (coveredByFolder ? ' gp-file--covered' : '') + (fchecked ? ' gp-file--selected' : '');
                    return '<div class="' + rowClass + '" data-filekey="' + fk + '">' +
                        '<input type="checkbox" class="gp-file-cb"' +
                            (fchecked ? ' checked' : '') +
                            (coveredByFolder ? ' disabled' : '') +
                            ' data-fid="' + f.id + '" data-title="' + escapeHtml(f.title || '') + '" />' +
                        '<span class="gp-row__icon">📄</span>' +
                        '<span class="gp-file__name" title="' + escapeHtml(f.title || '') + '">' +
                            escapeHtml(f.title || '(không tiêu đề)') + '</span>' +
                        (coveredByFolder ? '<small style="color:#16a34a;flex-shrink:0;">✓ qua nhóm</small>' : '') +
                        '</div>';
                }).join('');
                html += '</div>';
            }
        }
        return html;
    }

    function wireRowHandlers() {
        // Expand toggle
        $list.querySelectorAll('.gp-expand').forEach(function (b) {
            b.addEventListener('click', function (e) {
                e.stopPropagation();
                var k = b.dataset.toggle;
                if (expandedFolders.has(k)) {
                    expandedFolders.delete(k);
                    renderTree();
                } else {
                    expandedFolders.add(k);
                    var parts = k.split('-');
                    var type = parseInt(parts[0], 10);
                    var gid = parseInt(parts[1], 10);
                    if (folderFilesCache[k]) {
                        renderTree();
                    } else {
                        renderTree();  // show loading state
                        loadFilesInFolder(type, gid).then(function () { renderTree(); });
                    }
                }
            });
        });

        // Folder checkbox
        $list.querySelectorAll('.gp-folder-cb').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var k = cb.closest('.gp-folder').dataset.fkey;
                var parts = k.split('-');
                var type = parseInt(parts[0], 10);
                var gid = parseInt(parts[1], 10);
                if (cb.checked) {
                    var groupInfo = (allGroupsByType[type] || []).find(function (g) { return g.id === gid; });
                    var name = groupInfo ? groupInfo.name : '';
                    fetchFolderCount(type, gid, false).then(function (cnt) {
                        getSelected._folders.set(k, {
                            type: type, groupId: gid, recursive: false,
                            name: name, contentCount: cnt
                        });
                        refreshSummary();
                        renderTree();
                        if (typeof getSelected.onChange === 'function') getSelected.onChange();
                    });
                } else {
                    getSelected._folders.delete(k);
                    refreshSummary();
                    renderTree();
                    if (typeof getSelected.onChange === 'function') getSelected.onChange();
                }
            });
        });

        // Recursive checkbox (per folder)
        $list.querySelectorAll('.gp-rec-cb').forEach(function (cb) {
            cb.addEventListener('change', function (e) {
                e.stopPropagation();
                var k = cb.closest('.gp-folder').dataset.fkey;
                var parts = k.split('-');
                var type = parseInt(parts[0], 10);
                var gid = parseInt(parts[1], 10);
                var folder = getSelected._folders.get(k);
                if (!folder) {
                    // Auto-select folder when recursive ticked
                    if (cb.checked) {
                        var groupInfo = (allGroupsByType[type] || []).find(function (g) { return g.id === gid; });
                        var name = groupInfo ? groupInfo.name : '';
                        fetchFolderCount(type, gid, true).then(function (cnt) {
                            getSelected._folders.set(k, {
                                type: type, groupId: gid, recursive: true,
                                name: name, contentCount: cnt
                            });
                            refreshSummary();
                            renderTree();
                            if (typeof getSelected.onChange === 'function') getSelected.onChange();
                        });
                    }
                } else {
                    folder.recursive = cb.checked;
                    // Re-fetch count for new recursive state
                    fetchFolderCount(type, gid, folder.recursive).then(function (cnt) {
                        folder.contentCount = cnt;
                        refreshSummary();
                        renderTree();
                        if (typeof getSelected.onChange === 'function') getSelected.onChange();
                    });
                }
            });
        });

        // File checkbox
        $list.querySelectorAll('.gp-file-cb').forEach(function (cb) {
            cb.addEventListener('change', function () {
                if (cb.disabled) return;
                var $row = cb.closest('.gp-file');
                var fk = $row.dataset.filekey;
                var parts = fk.split('-');  // ['f', type, fid]
                var type = parseInt(parts[1], 10);
                var fid = parseInt(cb.dataset.fid, 10);
                if (cb.checked) {
                    getSelected._files.set(fk, {
                        type: type, id: fid, title: cb.dataset.title
                    });
                    $row.classList.add('gp-file--selected');
                } else {
                    getSelected._files.delete(fk);
                    $row.classList.remove('gp-file--selected');
                }
                refreshSummary();
                if (typeof getSelected.onChange === 'function') getSelected.onChange();
            });
        });
    }

    // Type tabs
    $$('.gp-type-btn').forEach(function (b) {
        b.addEventListener('click', function () {
            $$('.gp-type-btn').forEach(function (x) { x.classList.toggle('active', x === b); });
            currentType = parseInt(b.dataset.type, 10);
            expandedFolders = new Set();  // reset expansion when switch type
            $list.innerHTML = '<div class="pm-loading">Đang tải nhóm...</div>';
            loadGroupsForType(currentType).then(function () { renderTree(); });
        });
    });

    // Search filter
    $q.addEventListener('input', debounce(renderTree, 200));

    // Init
    refreshSummary();
    $list.innerHTML = '<div class="pm-loading">Đang tải nhóm...</div>';
    loadGroupsForType(currentType).then(function () { renderTree(); });
}

// Helper: build payload from selectedHelper for Grant/PreviewGrant
function buildGrantContent(selectedHelper) {
    var groups = Array.from(selectedHelper._folders.values()).map(function (f) {
        return { Type: f.type, GroupId: f.groupId, Recursive: !!f.recursive };
    });
    var items = Array.from(selectedHelper._files.values()).map(function (f) {
        return { Type: f.type, Id: f.id };
    });
    return { Groups: groups, Items: items };
}

// Backward-compat helper - old code expected groupsPayload
function groupsPayload(selectedMap) {
    // selectedMap may be _folders Map directly OR old _selected Map
    if (!selectedMap) return [];
    return Array.from(selectedMap.values()).map(function (g) {
        return { Type: g.type, GroupId: g.groupId, Recursive: !!g.recursive };
    });
}

// ========== Preview (shared) ==========
// payload = { UserIds, Items?, Groups? }
function runPreview(payload, onResult) {
    if (!payload.UserIds || payload.UserIds.length === 0) { onResult(null); return; }
    var hasContent = (payload.Items && payload.Items.length > 0) || (payload.Groups && payload.Groups.length > 0);
    if (!hasContent) { onResult(null); return; }
    jsonPost('PreviewGrant', payload)
        .then(onResult)
        .catch(function (err) { onResult({ error: err.message }); });
}

function renderPreview(p) {
    if (!p) return '<div class="pm-fld__hint">Chưa đủ thông tin để xem trước.</div>';
    if (p.error) return '<div class="pm-warn">⚠ ' + escapeHtml(p.error) + '</div>';

    // Đơn vị cấp = NHÓM (group-grant auto-inherit) + LẺ (file-grant per-content).
    // Phải đếm cùng đơn vị với action Grant, nếu không số ở Preview sẽ lệch số ở thông báo.
    var unitParts = [];
    if (p.groupCount > 0) {
        var gByType = [];
        if (p.groupProjectCount > 0) gByType.push(p.groupProjectCount + ' Project');
        if (p.groupVirtualCount > 0) gByType.push(p.groupVirtualCount + ' Virtual');
        if (p.groupVideoCount > 0) gByType.push(p.groupVideoCount + ' Video');
        unitParts.push(fmt(p.groupCount) + ' nhóm' + (gByType.length ? ' (' + gByType.join(' + ') + ')' : ''));
    }
    if (p.itemCount > 0) {
        var iByType = [];
        if (p.fileProjectCount > 0) iByType.push(p.fileProjectCount + ' Project');
        if (p.fileVirtualCount > 0) iByType.push(p.fileVirtualCount + ' Virtual');
        if (p.fileVideoCount > 0) iByType.push(p.fileVideoCount + ' Video');
        unitParts.push(fmt(p.itemCount) + ' nội dung lẻ' + (iByType.length ? ' (' + iByType.join(' + ') + ')' : ''));
    }
    var unitDesc = unitParts.join(' + ');

    var html = '<div class="pm-preview">' +
        '<div class="pm-preview__title">Xem trước — kết quả sẽ xảy ra khi bấm "Cấp"</div>' +

        // Phép tính rõ ràng: U user × (nhóm + lẻ) = T quyền sẽ được kiểm tra
        '<div style="background:#fff;border:1px solid #e2e8f0;border-radius:6px;padding:10px 12px;margin-bottom:10px;font-size:13px;color:#0f172a;">' +
            '<b>' + fmt(p.userCount) + '</b> người dùng × <b>' + fmt(p.unitCount) + '</b> mục' +
            (unitDesc ? ' [' + escapeHtml(unitDesc) + ']' : '') +
            ' = <b style="color:#2563eb;">' + fmt(p.total) + ' quyền</b> sẽ được kiểm tra' +
            (p.groupContentCount > 0
                ? '<div style="margin-top:6px;font-size:12px;color:#16a34a;">📂 ' + fmt(p.groupCount) +
                  ' nhóm sẽ tự động phủ ~<b>' + fmt(p.groupContentCount) + '</b> nội dung (tự kế thừa).</div>'
                : '') +
        '</div>' +

        // Breakdown: đã có / sẽ cấp mới (đơn vị nhóm/lẻ, khớp với thông báo sau khi cấp)
        '<div class="pm-preview__nums">' +
            '<div class="pm-preview__num pm-preview__num--exist" title="Mục (người dùng × nhóm/nội dung) đã có sẵn - sẽ giữ nguyên, không cấp lại">' +
                '<div class="pm-preview__num__n">' + fmt(p.existing) + '</div>' +
                '<div class="pm-preview__num__lbl">⊘ Đã có (giữ nguyên)</div>' +
            '</div>' +
            '<div class="pm-preview__num pm-preview__num--new" title="Mục (người dùng × nhóm/nội dung) chưa có - sẽ tạo mới">' +
                '<div class="pm-preview__num__n">' + fmt(p.notExisting) + '</div>' +
                '<div class="pm-preview__num__lbl">+ Cần cấp mới</div>' +
            '</div>' +
        '</div>' +

        // Note: existing == total → tất cả đã có
        (p.existing === p.total && p.total > 0
            ? '<div style="margin-top:10px;padding:8px 12px;background:#dcfce7;border:1px solid #86efac;border-radius:6px;font-size:12px;color:#166534;">' +
              '✓ Tất cả ' + fmt(p.total) + ' quyền này đã được cấp từ trước. Không cần thao tác thêm.' +
              '</div>'
            : '') +
        // Note: existing = 0
        (p.existing === 0 && p.total > 0
            ? '<div style="margin-top:10px;padding:8px 12px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;font-size:12px;color:#1d4ed8;">' +
              'ℹ Toàn bộ ' + fmt(p.total) + ' quyền sẽ được cấp mới (chưa người dùng nào trong danh sách có quyền với nội dung này).' +
              '</div>'
            : '');

    if (p.warnings && p.warnings.length > 0) {
        html += p.warnings.map(function (w) { return '<div class="pm-warn" style="margin-top:8px;">⚠ ' + escapeHtml(w.message) + '</div>'; }).join('');
    }
    html += '</div>';
    return html;
}

// ========== Modal: Cấp 1 user ==========
$('#pm-act-user').addEventListener('click', function () {
    var pickedUser = null;
    var groupSel = {};
    groupSel._selected = new Map();

    var body =
        '<div class="pm-fld">' +
            '<label class="pm-fld__lbl">① Tìm người dùng</label>' +
            '<input type="text" id="u1-q" placeholder="Gõ tên hoặc mã NV..." />' +
            '<div class="pm-pick" id="u1-list" style="display:none;"></div>' +
            '<div id="u1-picked" style="margin-top:8px;"></div>' +
        '</div>' +
        '<div id="u1-step2" style="display:none;">' +
            '<label class="pm-fld__lbl">② Chọn nhóm nội dung (cấp ở mức NHÓM, hệ thống tự mở rộng thành nội dung trong nhóm)</label>' +
            buildGroupPickerHtml() +
        '</div>' +
        '<div id="u1-preview"></div>';

    openModal('👤 Cấp quyền cho 1 người dùng', body, 'Cấp 0 quyền mới', function () {
        var c = buildGrantContent(groupSel);
        execGrant({ UserIds: [pickedUser.id], Groups: c.Groups, Items: c.Items });
    });

    groupSel.onChange = updatePreview;
    function updatePreview() {
        if (!pickedUser) return;
        var c = buildGrantContent(groupSel);
        runPreview({ UserIds: [pickedUser.id], Groups: c.Groups, Items: c.Items }, function (p) {
            $('#u1-preview').innerHTML = renderPreview(p);
            if (p && !p.error) updateModalConfirm('+ Cấp ' + fmt(p.notExisting) + ' quyền mới', !canGrant || p.notExisting === 0);
        });
    }
    updateModalConfirm('Cấp 0 quyền mới', true);

    var $q = $('#u1-q'), $list = $('#u1-list'), $picked = $('#u1-picked');
    $q.addEventListener('input', debounce(function () {
        if (!$q.value.trim()) { $list.style.display = 'none'; return; }
        api('Users?limit=20&search=' + encodeURIComponent($q.value.trim())).then(function (rows) {
            $list.style.display = 'block';
            if (!rows || rows.length === 0) {
                $list.innerHTML = '<div class="pm-empty"><div class="pm-empty__hint">Không tìm thấy</div></div>';
                return;
            }
            $list.innerHTML = rows.map(function (r) {
                return '<div class="pm-pick__item" data-uid="' + r.id +
                    '" data-name="' + escapeHtml(r.hoTen) +
                    '" data-manv="' + escapeHtml(r.maNV || '') +
                    '" data-pb="' + escapeHtml(r.phongBan || '') + '">' +
                    '<span class="pm-pick__item__main">' +
                        '<div class="pm-pick__item__name">' + escapeHtml(r.hoTen) + '</div>' +
                        '<div class="pm-pick__item__meta">' + escapeHtml(r.maNV || '') + ' · ' + escapeHtml(r.phongBan || '—') + '</div>' +
                    '</span></div>';
            }).join('');
            $list.querySelectorAll('[data-uid]').forEach(function (el) {
                el.onclick = function () {
                    pickedUser = {
                        id: parseInt(el.dataset.uid, 10),
                        hoTen: el.dataset.name, maNV: el.dataset.manv, phongBan: el.dataset.pb
                    };
                    $picked.innerHTML = '<div style="background:#dcfce7;padding:8px 12px;border-radius:6px;font-size:13px;">✓ <b>' +
                        escapeHtml(pickedUser.hoTen) + '</b> · ' + escapeHtml(pickedUser.maNV) + ' · ' + escapeHtml(pickedUser.phongBan) + '</div>';
                    $list.style.display = 'none';
                    $q.value = '';
                    $('#u1-step2').style.display = 'block';
                    wireGroupPicker(groupSel);
                    updatePreview();
                };
            });
        });
    }, 250));
});

