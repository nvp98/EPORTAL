                                            @if (!string.IsNullOrEmpty(item.TenPhongBan))
                                            {
                                                <span class="fx-file__chip">@item.TenPhongBan</span>
                                            }
                                            @if (item.FilePDF != null && item.FilePDF.Length > 0)
                                            {
                                                <a href="@Url.Content("~/UploadedFiles/" + System.IO.Path.GetFileName(item.FilePDF))" target="_blank" class="fx-file__chip" style="background:#fee2e2;color:#b91c1c;text-decoration:none"><i class="fa fa-file-pdf"></i> PDF</a>
                                            }
