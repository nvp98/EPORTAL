                    }

                    @* ---------- Projects section ---------- *@
                    @{
                        var sectionLabel = isSearching
                            ? "Dự án khớp với \"" + searchText + "\""
                            : (currentFolder != null ? "Dự án trong " + currentFolder.GroupName : "Dự án (chưa phân nhóm)");
