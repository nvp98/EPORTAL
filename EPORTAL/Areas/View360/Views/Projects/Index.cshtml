                                    </div>
                                </div>
                                <script type="text/javascript">
                                    (function () {
                                        var b = document.getElementById('btn-edit_@item.ID');
                                        if (!b) return;
                                        b.addEventListener('click', function (e) {
                                            e.preventDefault();
                                            var url = document.getElementById('myModaleEdit_@item.ID').getAttribute('data-url');
                                            jQuery.get(url, function (data) {
                                                jQuery("#myModal").html(data);
                                                jQuery("#ModalTitle").html("Cập nhật dự án");
                                                jQuery("#myModal").modal('show');
                                            });
                                        });
                                    })();
                                </script>
                            }
                        </div>
                    }

                    @* Pagination chi cho grid view. List view: lazy scroll, render het. *@
                    @if (viewMode != "list")
                    {
                        <div class="fx-pager">
                            @Html.PagedListPager(Model, page => Url.Action("Index", "Projects", new { area = "View360", page, search = searchText, gid = currentGid, sort = sortKey, view = viewMode }))
                            @if (Model.PageCount > 0)
                            {
                                <span class="pageoff">Trang @Model.PageNumber / @Model.PageCount</span>
                            }
                        </div>
                    }
                    else if (Model.TotalItemCount > 0)
                    {
                        <div style="text-align:center;color:#9ca3af;font-size:12px;padding:16px 0">
                            Hiển thị tất cả @Model.TotalItemCount dự án
                        </div>
                    }

                </main>
            </div>
        </div>
    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner"></div>
        </div>
    </div>
</div>

@* ============================================================
   Context menu (right-click) - dung chung cho folder/file
