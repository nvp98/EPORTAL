@* ============================================================
   Move modal - folder picker, dung chung folder/file
   ============================================================ *@
<div class="modal" id="fx-move-modal" role="dialog" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="fx-move-title">Di chuyển đến…</h5>
                <a href="#" class="close" data-dismiss="modal">&times;</a>
            </div>
            <div class="modal-body">
                <div style="margin-bottom:10px;color:#6b7c93;font-size:13px">
                    Đang di chuyển: <strong id="fx-move-source">—</strong>
                </div>
                <input type="text" id="fx-move-filter" class="form-control" placeholder="Lọc nhóm…" style="margin-bottom:10px" />
                <div class="fx-move-tree" id="fx-move-tree">
                    @{
                        var moveTreeFlat = ViewBag.HierarchyFlat as List<ProjectGroupNode> ?? new List<ProjectGroupNode>();
                    }
                    <div class="fx-move-node" data-target-id="" data-target-name="(gốc)">
                        <span class="ic"><i class="fa fa-home"></i></span>
                        <span><strong>Nhóm gốc</strong> (không thuộc nhóm nào)</span>
                    </div>
                    @foreach (var n in moveTreeFlat)
                    {
                        <div class="fx-move-node" data-target-id="@n.IDGroup" data-target-name="@n.GroupName"
                             style="padding-left:@(10 + n.Depth * 18)px">
                            <span class="ic"><i class="fa fa-folder"></i></span>
                            <span>@n.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" id="fx-move-confirm" class="btn btn-primary" disabled>Di chuyển</button>
            </div>
        </div>
    </div>
</div>

@helper SidebarNode(ProjectGroupNode node, int? currentGid, HashSet<int> expandedSet)
{
    var isActive = currentGid.HasValue && currentGid.Value == node.IDGroup;
    var hasChildren = node.Children != null && node.Children.Count > 0;
    var indentPx = node.Depth * 14;
    var isExpanded = expandedSet.Contains(node.IDGroup);
    <div class="fx-tree-item">
        <div class="fx-tree-row @(isActive ? "is-active" : "")" style="padding-left:@(indentPx)px">
            <button type="button"
                    class="fx-tree-toggle @(hasChildren ? "" : "is-leaf") @(isExpanded ? "" : "is-collapsed")"
                    data-toggle-tree="@node.IDGroup"
                    title="@(isExpanded ? "Đóng" : "Mở")">
                <i class="fa fa-caret-down"></i>
            </button>
            @{
                var subtreeMap = ViewBag.SubtreeCount as Dictionary<int, int>;
                int subtreeC = subtreeMap != null && subtreeMap.ContainsKey(node.IDGroup) ? subtreeMap[node.IDGroup] : node.ProjectCount;
                bool hasSubtreeMore = subtreeC > node.ProjectCount;
                // C# 5 (Razor MVC 5) khong support $"..." interpolation - dung string.Format
                var tooltipExtra = hasSubtreeMore
                    ? string.Format(" — {0} trực tiếp · {1} cả cây con", node.ProjectCount, subtreeC)
                    : "";
            }
            <a href="@Url.Action("Index", "Projects", new { gid = node.IDGroup })"
               class="fx-tree-node"
               title="@(node.GroupName + tooltipExtra)">
                <span class="ic"><i class="fa fa-folder"></i></span>
                <span style="overflow:hidden;text-overflow:ellipsis">@node.GroupName</span>
                @if (node.ProjectCount > 0 || subtreeC > 0)
                {
                    if (hasSubtreeMore)
                    {
                        <span class="count" style="background:rgba(37,99,235,.08);color:#2563eb;">@node.ProjectCount<span style="opacity:.5">/@subtreeC</span></span>
                    }
                    else
                    {
                        <span class="count">@node.ProjectCount</span>
                    }
                }
            </a>
            <span class="fx-tree-reorder">
                <button type="button" class="btn-tree-move-up" data-id="@node.IDGroup" title="Lên"><i class="fa fa-chevron-up"></i></button>
                <button type="button" class="btn-tree-move-down" data-id="@node.IDGroup" title="Xuống"><i class="fa fa-chevron-down"></i></button>
            </span>
        </div>
        @if (hasChildren)
        {
            <div class="fx-tree-children @(isExpanded ? "" : "is-collapsed")" data-children-of="@node.IDGroup">
                @foreach (var c in node.Children)
                {
                    @SidebarNode(c, currentGid, expandedSet)
                }
            </div>
        }
    </div>
}

<script type="text/javascript">
    (function () {
        var currentGid = @(currentGid.HasValue ? currentGid.Value.ToString() : "null");
        var currentSort = '@sortKey';
        var currentView = '@viewMode';

        function buildUrl(overrides) {
            var params = {
                search: jQuery('#txtsearch').val() || '',
                gid: currentGid,
                sort: currentSort,
                view: currentView
            };
            for (var k in overrides) params[k] = overrides[k];
            var q = [];
            for (var k in params) {
                if (params[k] === null || params[k] === undefined || params[k] === '') continue;
                q.push(encodeURIComponent(k) + '=' + encodeURIComponent(params[k]));
            }
            return '@Url.Action("Index", "Projects")' + (q.length ? '?' + q.join('&') : '');
        }

        // Search: Enter or button-less - submit on enter
        jQuery('#txtsearch').on('keypress', function (e) {
            if (e.which === 13) { window.location.href = buildUrl({ page: 1 }); }
        });
        // Sort change
        jQuery('#fx-sort').on('change', function () {
            window.location.href = buildUrl({ sort: jQuery(this).val(), page: 1 });
        });
        // View toggle
        jQuery('.fx-viewtoggle button').on('click', function () {
            window.location.href = buildUrl({ view: jQuery(this).attr('data-view'), page: 1 });
        });

        // Add project
        jQuery('#btn-add').click(function () {
            var url = jQuery('#myModal').data('url');
            // Pass current folder as default group
            if (currentGid !== null) url += '?gid=' + currentGid;
            jQuery.get(url, function (data) {
                jQuery("#myModal").html(data);
                jQuery("#ModalTitle").html("Thêm dự án");
                jQuery("#myModal").modal('show');
            });
        });
        // Add subfolder - reuse ProjectsGroup create with parentId
        jQuery('#btn-add-folder').click(function () {
            var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            var url = '@Url.Action("Create", "ProjectsGroup")?returnUrl=' + returnUrl;
            if (currentGid !== null) url += '&parentId=' + currentGid;
            jQuery.ajax({
                url: url,
                type: 'GET',
                dataType: 'html',
                success: function (data) {
                    // Detect server redirect tra ve trang Login (full HTML) - dau hieu permission deny
                    if (data && (data.indexOf('<title') !== -1 && data.toLowerCase().indexOf('login') !== -1)) {
                        alert('Bạn không có quyền tạo nhóm dự án. Liên hệ admin để cấp quyền "ProjectsGroup → ADD".');
                        return;
                    }
                    jQuery("#myModal").html(data);
                    jQuery("#ModalTitle").html("Thêm nhóm con");
                    jQuery("#myModal").modal('show');
                },
                error: function (xhr) {
                    alert('Không thể mở form tạo nhóm. ' +
                          'Status: ' + xhr.status + ' ' + xhr.statusText);
                }
            });
        });
        // Import
        jQuery('#btn-Import').click(function () {
            var url = jQuery('#myModalImport').data('url');
            jQuery.get(url, function (data) {
                jQuery("#myModal").html(data);
                jQuery("#ModalTitle").html("Upload");
                jQuery("#myModal").modal('show');
            });
        });
        // Export Excel - server tu mo rong subtree neu user dang trong 1 folder
        // (vd dang o HPDQ 2 -> export ca HPDQ 2 + Can 4 + Duc 4 + ...)
        jQuery('#btn-Export').click(function () {
            var search = jQuery('#txtsearch').val() || '';
            var url = '@Url.Action("ExportToExcel", "Projects")?search=' + encodeURIComponent(search);
            if (currentGid !== null) url += '&IDGroup=' + currentGid;
            window.location.href = url;
        });

        // ====================================================
        // Sidebar tree: reorder (up/down buttons)
        // ====================================================
        jQuery(document).on('click', '.btn-tree-move-up, .btn-tree-move-down', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = jQuery(this);
            var id = $btn.data('id');
            var up = $btn.hasClass('btn-tree-move-up');
            $btn.prop('disabled', true);
            var url = up ? '@Url.Action("MoveUp", "ProjectsGroup")' : '@Url.Action("MoveDown", "ProjectsGroup")';
            jQuery.post(url, { id: id })
                .done(function (data, status, xhr) {
                    if (xhr.status === 204) {
                        // 204 = da o bien (khong di chuyen duoc) -> flash do
                        $btn.css('color', '#dc2626');
                        setTimeout(function () { $btn.css('color', ''); $btn.prop('disabled', false); }, 500);
                        return;
                    }
                    // 200 = da doi cho ben server. Doi cho node ngay tren DOM (KHONG reload)
                    // de giu nguyen trang thai mo/dong cua tree (truoc day reload lam cay bi
                    // dong lai vi server chi auto-expand path toi folder hien tai).
                    var $item = $btn.closest('.fx-tree-item');
                    var $sibling = up ? $item.prev('.fx-tree-item') : $item.next('.fx-tree-item');
                    if ($sibling.length) {
                        if (up) { $item.insertBefore($sibling); }
                        else { $item.insertAfter($sibling); }
                    }
                    $btn.prop('disabled', false);
                })
                .fail(function (xhr) {
                    alert('Lỗi: ' + (xhr.responseText || xhr.statusText));
                    $btn.prop('disabled', false);
                });
        });

        // ====================================================
        // Sidebar tree: collapsible toggle
        // ====================================================
        jQuery(document).on('click', '.fx-tree-toggle:not(.is-leaf)', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var id = jQuery(this).attr('data-toggle-tree');
            var $children = jQuery('.fx-tree-children[data-children-of="' + id + '"]');
            var collapsed = $children.hasClass('is-collapsed');
            if (collapsed) {
                $children.removeClass('is-collapsed');
                jQuery(this).removeClass('is-collapsed');
            } else {
                $children.addClass('is-collapsed');
                jQuery(this).addClass('is-collapsed');
            }
        });

        // ====================================================
        // Right-click context menu
        // ====================================================
        var $ctx = jQuery('#fx-ctxmenu');
        var ctxTarget = null;

        function showCtx(x, y, target) {
            ctxTarget = target;
            var type = target.getAttribute('data-type');
            var name = target.getAttribute('data-name') || '';
            var hasChildren = target.getAttribute('data-has-children') === '1';
            var projCount = parseInt(target.getAttribute('data-project-count') || '0', 10);

            jQuery('#ctx-header').text((type === 'folder' ? '📁 ' : '📄 ') + name);

            // Disable Delete folder neu co children hoac co projects (server cung block, UI chi hint)
            var $del = jQuery('[data-ctx-action="delete"]', $ctx);
            if (type === 'folder' && (hasChildren || projCount > 0)) {
                $del.addClass('is-disabled').attr('title', 'Phải xóa hết nhóm con / dự án trước');
            } else {
                $del.removeClass('is-disabled').removeAttr('title');
            }

            // Position - clamp vao viewport
            $ctx.addClass('is-open').css({ left: x + 'px', top: y + 'px' });
            var rect = $ctx[0].getBoundingClientRect();
            if (rect.right > window.innerWidth) $ctx.css('left', (x - rect.width) + 'px');
            if (rect.bottom > window.innerHeight) $ctx.css('top', (y - rect.height) + 'px');
        }

        function hideCtx() { $ctx.removeClass('is-open'); ctxTarget = null; }

        jQuery(document).on('contextmenu', '.ctx-target', function (e) {
            e.preventDefault();
            e.stopPropagation();
            showCtx(e.clientX, e.clientY, this);
            return false;
        });

        // Action handler MUST fire before the "hide on click outside" handler.
        // Dat truoc + dung delegated click voi target check trong "hide" handler.
        jQuery(document).on('click', '.fx-ctxmenu__item', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (!ctxTarget) { hideCtx(); return; }
            if (jQuery(this).hasClass('is-disabled')) { hideCtx(); return; }
            var action = jQuery(this).attr('data-ctx-action');
            var type = ctxTarget.getAttribute('data-type');
            var id = ctxTarget.getAttribute('data-id');
            var name = ctxTarget.getAttribute('data-name') || '';
            var parent = ctxTarget.getAttribute('data-parent') || '';
            // Bao luu target truoc khi hide (vi action move dung async modal)
            var savedCtx = { type: type, id: id, name: name, parent: parent };
            hideCtx();
            // Re-route bang savedCtx
            type = savedCtx.type; id = savedCtx.id; name = savedCtx.name; parent = savedCtx.parent;

            if (action === 'open') {
                if (type === 'folder') {
                    window.location.href = '@Url.Action("Index", "Projects")?gid=' + id;
                } else {
                    // file: edit dialog
                    var url = '@Url.Action("Edit", "Projects")/' + id;
                    jQuery.get(url, function (data) {
                        jQuery("#myModal").html(data);
                        jQuery("#ModalTitle").html("Chi tiết dự án");
                        jQuery("#myModal").modal('show');
                    });
                }
            } else if (action === 'edit') {
                // returnUrl: sau khi sua xong, server redirect ve dung trang nay (giu UI moi)
                var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                var editUrl = (type === 'folder')
                    ? '@Url.Action("Edit", "ProjectsGroup")/' + id + '?returnUrl=' + returnUrl
                    : '@Url.Action("Edit", "Projects")/' + id;
                jQuery.get(editUrl, function (data) {
                    jQuery("#myModal").html(data);
                    jQuery("#ModalTitle").html(type === 'folder' ? "Đổi tên nhóm" : "Cập nhật dự án");
                    jQuery("#myModal").modal('show');
                });
            } else if (action === 'move') {
                openMoveModal(type, id, name, parent);
            } else if (action === 'delete') {
                if (!confirm('Xóa ' + (type === 'folder' ? 'nhóm' : 'dự án') + ': ' + name + ' ?')) return;
                var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                var delUrl = (type === 'folder')
                    ? '@Url.Action("Delete", "ProjectsGroup")?id=' + id + '&returnUrl=' + returnUrl
                    : '@Url.Action("Delete", "Projects")?id=' + id;
                window.location.href = delUrl;
            }
        });

        // Hide-on-click-outside (must be AFTER action handler so it doesn't pre-empt clicks on items)
        jQuery(document).on('click', function (e) {
            if (jQuery(e.target).closest('#fx-ctxmenu').length === 0) hideCtx();
        });
        jQuery(document).on('scroll wheel', function () { hideCtx(); });
        jQuery(document).on('keydown', function (e) { if (e.key === 'Escape') hideCtx(); });

        // ====================================================
        // Move modal
        // ====================================================
        var moveCtx = { type: null, id: null, name: null, currentParent: null };
        var moveTargetId = null;

        function openMoveModal(type, id, name, parent) {
            moveCtx = { type: type, id: id, name: name, currentParent: parent };
            moveTargetId = null;
            jQuery('#fx-move-source').text(name);
            jQuery('#fx-move-confirm').prop('disabled', true);
            jQuery('#fx-move-filter').val('');
            jQuery('.fx-move-node', '#fx-move-tree').removeClass('is-selected is-disabled').show();
            // Voi folder: disable chinh no + descendants (tranh chu trinh)
            if (type === 'folder') {
                // Server validate descendants. UI chi disable chinh no.
                jQuery('.fx-move-node[data-target-id="' + id + '"]').addClass('is-disabled');
            }
            // Highlight current parent
            var curParent = parent || '';
            jQuery('.fx-move-node[data-target-id="' + curParent + '"]').css('background', '#fef3c7');
            jQuery('#fx-move-modal').modal('show');
        }

        jQuery(document).on('click', '#fx-move-tree .fx-move-node', function () {
            if (jQuery(this).hasClass('is-disabled')) return;
            jQuery('.fx-move-node', '#fx-move-tree').removeClass('is-selected');
            jQuery(this).addClass('is-selected');
            moveTargetId = jQuery(this).attr('data-target-id') || '';
            jQuery('#fx-move-confirm').prop('disabled', false);
        });

        jQuery('#fx-move-filter').on('input', function () {
            var q = jQuery(this).val().toLowerCase();
            jQuery('#fx-move-tree .fx-move-node').each(function () {
                var t = (jQuery(this).attr('data-target-name') || '').toLowerCase();
                jQuery(this).toggle(q === '' || t.indexOf(q) >= 0);
            });
        });

        jQuery('#fx-move-confirm').on('click', function () {
            if (moveTargetId === null) return;
            var url = (moveCtx.type === 'folder')
                ? '@Url.Action("Move", "ProjectsGroup")'
                : '@Url.Action("Move", "Projects")';
            var token = jQuery('input[name="__RequestVerificationToken"]').val() || '';
            jQuery.post(url, {
                id: moveCtx.id,
                targetId: moveTargetId,
                __RequestVerificationToken: token
            }).done(function () {
                window.location.reload();
            }).fail(function (xhr) {
                alert('Di chuyển thất bại: ' + (xhr.responseText || xhr.statusText));
            });
        });
    })();
</script>

@* Anti-forgery token cho AJAX POST Move *@
@using (Html.BeginForm("Move", "Projects", FormMethod.Post, new { id = "fx-token-form", style = "display:none" }))
{
    @Html.AntiForgeryToken()
}
