                                    <div class="actions">
                                        <a id="btn-edit_@item.ID" href="#" class="fx-act" title="Sửa"><i class="fa fa-edit"></i></a>
                                        <div class="modal" id="myModaleEdit_@item.ID" role="dialog" data-url='@Url.Action("Edit", "Projects", new { id = item.ID })'></div>
                                        <a href="@Url.Action("Authorization", "Projects", new { id = item.ID })" class="fx-act" title="Phân quyền"><i class="fa-solid fa-user-plus"></i></a>
                                        <a href="@Url.Action("ExportToExceldetail", "Projects", new { id = item.ID })" class="fx-act" title="Xuất Excel"><i class="fa-solid fa-file-excel"></i></a>
                                        @if (item.FilePDF != null && item.FilePDF.Length > 0)
                                        {
                                            <a href="@Url.Content("~/UploadedFiles/" + System.IO.Path.GetFileName(item.FilePDF))" target="_blank" class="fx-act" title="Xem PDF"><i class="fa fa-file-pdf"></i></a>
                                        }
