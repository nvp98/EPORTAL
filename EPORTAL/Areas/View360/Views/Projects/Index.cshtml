                                           class="fx-act fx-act--danger" title="Xóa"><i class="fa fa-trash"></i></a>
                                    </div>
                                    <a href="@item.URL" target="_blank" class="fx-file__thumb" style="text-decoration:none">
                                        @if (!string.IsNullOrEmpty(item.Images))
                                        {
                                            <img src="@Url.Content("~/Images/" + System.IO.Path.GetFileName(item.Images))" alt="@item.Title" onerror="this.style.display='none';this.nextElementSibling && (this.nextElementSibling.style.display='flex')" />
                                            <div class="placeholder" style="display:none"><i class="fa fa-image"></i></div>
