@using EPORTAL.Common
@using EPORTAL.ModelsView360
@using PagedList.Mvc
@{
    ViewBag.Title = "Quản lý dự án";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tree = ViewBag.HierarchyTree as List<ProjectGroupNode> ?? new List<ProjectGroupNode>();
    var crumbs = ViewBag.Breadcrumb as List<ProjectGroupNode> ?? new List<ProjectGroupNode>();
    // Tree node tren sidebar mac dinh fold het. Auto-expand path tu root den current folder.
    var expandedSet = new HashSet<int>();
    foreach (var c in crumbs) { expandedSet.Add(c.IDGroup); }
    var subfolders = ViewBag.Subfolders as List<ProjectGroupNode> ?? new List<ProjectGroupNode>();
    var currentFolder = ViewBag.CurrentFolder as ProjectGroupNode;
    int? currentGid = ViewBag.CurrentGid as int?;
    var sortKey = (ViewBag.Sort as string) ?? "date-desc";
    var viewMode = (ViewBag.View as string) ?? "grid";
    var searchText = (ViewBag.search as string) ?? "";
    bool isSearching = !string.IsNullOrEmpty(searchText);
}
@model PagedList.IPagedList<ProjectValidation>

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />
<link href="~/Content/PagedList.css" rel="stylesheet" />

<style>
    /* ============================================================
       FILE EXPLORER — Folder/File metaphor cho admin Projects.
       Layout: sidebar tree + main (toolbar + folders + files).
       ============================================================ */
    .fx { font-size: 14px; color: #1f2937; }

    /* ---------- Top toolbar (breadcrumb + actions) ---------- */
    .fx-topbar {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px;
        background: #fff;
        border-radius: 10px 10px 0 0;
        border-bottom: 1px solid #eef1f5;
        flex-wrap: wrap;
    }
    .fx-crumbs {
        display: flex; align-items: center; flex-wrap: wrap;
        gap: 4px; flex: 1; min-width: 240px;
        font-size: 14px;
    }
    .fx-crumb {
        color: #4b5563; text-decoration: none;
        padding: 4px 8px; border-radius: 6px;
        transition: background .12s;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .fx-crumb:hover { background: #eef4ff; color: #2563eb; text-decoration: none; }
    .fx-crumb--current { color: #111827; font-weight: 600; pointer-events: none; }
    .fx-crumb-sep { color: #cdd5e0; font-size: 11px; padding: 0 2px; }

    .fx-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .fx-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 12px; border-radius: 6px;
        font-size: 13px; font-weight: 500;
        border: 1px solid #e2e8f0;
        background: #fff; color: #374151;
        cursor: pointer; text-decoration: none;
        transition: all .12s;
    }
    .fx-btn:hover { background: #f3f6fb; border-color: #c1cad6; color: #1f2937; text-decoration: none; }
    .fx-btn--primary { background: #2563eb; border-color: #2563eb; color: #fff; }
    .fx-btn--primary:hover { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .fx-btn--warning { background: #f59e0b; border-color: #f59e0b; color: #fff; }
    .fx-btn--warning:hover { background: #d97706; border-color: #d97706; color: #fff; }
    .fx-btn--ghost { background: transparent; border-color: transparent; }
    .fx-btn--ghost:hover { background: #f3f6fb; }

    /* ---------- Workspace: sidebar + main ---------- */
    .fx-workspace {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 0;
        background: #fff;
        border-radius: 0 0 10px 10px;
        overflow: hidden;
    }
    .fx-sidebar {
        background: #fafbfc;
        border-right: 1px solid #eef1f5;
        padding: 14px 8px;
        overflow-y: auto;
        max-height: calc(100vh - 200px);
    }
    .fx-sidebar__title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6b7c93;
        padding: 4px 10px 10px;
    }
    .fx-tree-item { position: relative; }
    .fx-tree-row {
        display: flex; align-items: center; gap: 2px;
        padding: 5px 8px;
        border-radius: 6px;
        transition: background .1s;
    }
    .fx-tree-row:hover { background: #eef4ff; }
    .fx-tree-row.is-active { background: #2563eb; }
    .fx-tree-row.is-active .fx-tree-node,
    .fx-tree-row.is-active .fx-tree-toggle { color: #fff; }
    .fx-tree-row.is-active .fx-tree-node .ic { color: #fff; }
    .fx-tree-toggle {
        width: 18px; height: 18px;
        display: inline-flex; align-items: center; justify-content: center;
        border: none; background: transparent;
        color: #9ca3af; cursor: pointer;
        border-radius: 4px;
        font-size: 10px;
        flex-shrink: 0;
        padding: 0;
        transition: transform .12s;
    }
    .fx-tree-toggle:hover { background: rgba(0,0,0,.06); color: #2563eb; }
    .fx-tree-toggle.is-leaf { visibility: hidden; }
    .fx-tree-toggle.is-collapsed i { transform: rotate(-90deg); }
    .fx-tree-node {
        display: flex; align-items: center; gap: 6px;
        padding: 2px 4px;
        color: #374151;
        text-decoration: none;
        font-size: 13px;
        cursor: pointer;
        flex: 1; min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .fx-tree-node:hover { color: #2563eb; text-decoration: none; }
    .fx-tree-row.is-active .fx-tree-node { font-weight: 600; }
    .fx-tree-node .ic { width: 16px; text-align: center; flex-shrink: 0; color: #2563eb; }
    .fx-tree-node .count {
        font-size: 10px; color: #9ca3af;
        background: rgba(0,0,0,.04); padding: 1px 6px;
        border-radius: 999px;
    }
    .fx-tree-row.is-active .fx-tree-node .count { background: rgba(255,255,255,.2); color: #fff; }
    .fx-tree-children.is-collapsed { display: none; }

    /* Reorder buttons - chi hien khi hover row */
    .fx-tree-reorder {
        display: flex; gap: 2px;
        opacity: 0;
        transition: opacity .12s;
        flex-shrink: 0;
    }
    .fx-tree-row:hover .fx-tree-reorder { opacity: 1; }
    .fx-tree-row.is-active .fx-tree-reorder { opacity: .8; }
    .fx-tree-reorder button {
        width: 18px; height: 18px;
        border: none; background: transparent;
        color: inherit; cursor: pointer;
        border-radius: 3px;
        font-size: 10px; padding: 0;
        opacity: .6;
    }
    .fx-tree-reorder button:hover { opacity: 1; background: rgba(0,0,0,.08); }
    .fx-tree-row.is-active .fx-tree-reorder button:hover { background: rgba(255,255,255,.2); }
    .fx-tree-reorder button:disabled { opacity: .25; cursor: not-allowed; }

    .fx-main {
        padding: 18px;
        min-height: 480px;
    }

    /* ---------- Sub-toolbar (search + sort + view) ---------- */
    .fx-subtoolbar {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 16px; flex-wrap: wrap;
    }
    .fx-search {
        flex: 1; min-width: 240px; max-width: 420px;
        position: relative;
    }
    .fx-search input {
        width: 100%; padding: 8px 12px 8px 36px;
        border: 1px solid #d1d5db; border-radius: 6px;
        font-size: 13px;
        background: #fff;
    }
    .fx-search input:focus {
        outline: none; border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }
    .fx-search i {
        position: absolute; left: 12px; top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }
    .fx-spacer { flex: 1; }
    .fx-sort, .fx-pgfilter {
        padding: 7px 10px;
        border: 1px solid #d1d5db; border-radius: 6px;
        background: #fff; font-size: 13px;
        cursor: pointer;
    }
    .fx-viewtoggle {
        display: inline-flex;
        border: 1px solid #d1d5db; border-radius: 6px;
        overflow: hidden; background: #fff;
    }
    .fx-viewtoggle button {
        padding: 7px 12px; border: none; background: transparent;
        color: #6b7c93; cursor: pointer; font-size: 13px;
    }
    .fx-viewtoggle button:hover { background: #f3f6fb; }
    .fx-viewtoggle button.is-active { background: #2563eb; color: #fff; }

    /* ---------- Section labels ---------- */
    .fx-section {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #6b7c93;
        margin: 18px 0 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f0f2f5;
        display: flex; align-items: center; gap: 8px;
    }
    .fx-section:first-child { margin-top: 0; }
    .fx-section .count { color: #9ca3af; font-weight: 500; }

    /* ---------- Folder grid ---------- */
    .fx-folders {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 10px;
    }
    .fx-folder {
        display: flex; align-items: center; gap: 10px;
        padding: 12px;
        border: 1px solid #eef1f5;
        border-radius: 8px;
        background: #fcfdff;
        text-decoration: none;
        color: #1f2937;
        transition: all .14s;
        cursor: pointer;
        position: relative;
    }
    .fx-folder:hover {
        border-color: #2563eb;
        background: #eff5ff;
        text-decoration: none; color: #1f2937;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, .08);
    }
    .fx-folder__icon { font-size: 28px; color: #2563eb; flex-shrink: 0; filter: drop-shadow(0 2px 4px rgba(37, 99, 235, 0.2)); }
    .fx-folder__body { min-width: 0; flex: 1; }
    .fx-folder__name {
        font-weight: 600; font-size: 13px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .fx-folder__meta { font-size: 11px; color: #6b7c93; margin-top: 2px; }

    /* ---------- Project cards (grid) ---------- */
    .fx-files {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 14px;
    }
    .fx-file {
        background: #fff;
        border: 1px solid #eef1f5;
        border-radius: 10px;
        overflow: hidden;
        transition: all .14s;
        position: relative;
        display: flex; flex-direction: column;
    }
    .fx-file:hover {
        border-color: #2563eb;
        box-shadow: 0 6px 20px rgba(37, 99, 235, .12);
        transform: translateY(-2px);
    }
    .fx-file__thumb {
        position: relative;
        aspect-ratio: 16 / 10;
        background: #f3f6fb;
        overflow: hidden;
    }
    .fx-file__thumb img {
        width: 100%; height: 100%; object-fit: cover;
        display: block;
    }
    .fx-file__thumb .placeholder {
        display: flex; align-items: center; justify-content: center;
        height: 100%; color: #cdd5e0; font-size: 32px;
    }
    .fx-file__body {
        padding: 10px 12px 12px;
        display: flex; flex-direction: column; gap: 4px;
        flex: 1;
    }
    .fx-file__title {
        font-size: 14px; font-weight: 600; color: #111827;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 38px;
    }
    .fx-file__meta {
        display: flex; gap: 6px; flex-wrap: wrap;
        font-size: 11px; color: #6b7c93;
        margin-top: auto;
    }
    .fx-file__chip {
        background: #eef2f7; padding: 2px 7px;
        border-radius: 999px; font-weight: 500;
    }
    .fx-file__actions {
        position: absolute; top: 8px; right: 8px;
        display: flex; gap: 4px;
        opacity: 0; transform: translateY(-4px);
        transition: all .15s;
    }
    .fx-file:hover .fx-file__actions { opacity: 1; transform: translateY(0); }
    .fx-act {
        width: 28px; height: 28px;
        background: rgba(255, 255, 255, .96);
        border: 1px solid rgba(0,0,0,.06);
        backdrop-filter: blur(6px);
        border-radius: 6px;
        display: inline-flex; align-items: center; justify-content: center;
        color: #374151; text-decoration: none;
        font-size: 12px;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,.06);
    }
    .fx-act:hover { background: #fff; color: #2563eb; text-decoration: none; }
    .fx-act--danger:hover { color: #dc2626; }

    /* ---------- List view (Windows-explorer style) ---------- */
    .fx-listview {
        background: #fff;
        border: 1px solid #eef1f5;
        border-radius: 8px;
        overflow: hidden;
    }
    .fx-listrow {
        display: grid;
        grid-template-columns: 60px 1fr 200px 160px 120px;
        gap: 12px; align-items: center;
        padding: 8px 14px;
        border-bottom: 1px solid #f0f2f5;
        font-size: 13px;
        transition: background .1s;
    }
    .fx-listrow:hover { background: #f6f9ff; }
    .fx-listrow--header {
        background: #fafbfc;
        font-weight: 600; font-size: 12px;
        text-transform: uppercase; letter-spacing: .04em;
        color: #6b7c93;
    }
    .fx-listrow--header:hover { background: #fafbfc; }
    .fx-listrow img {
        width: 50px; height: 36px; object-fit: cover;
        border-radius: 4px; background: #f3f6fb;
    }
    .fx-listrow .actions { display: flex; gap: 6px; justify-content: flex-end; }
    .fx-list-folder .ic { color: #2563eb; font-size: 20px; margin-right: 6px; }

    /* ---------- Empty state ---------- */
    .fx-empty {
        padding: 48px 24px; text-align: center; color: #6b7c93;
    }
    .fx-empty i { font-size: 56px; color: #d1d5db; display: block; margin-bottom: 14px; }
    .fx-empty h3 { font-size: 18px; color: #374151; margin: 0 0 6px; }
    .fx-empty p { margin: 0; font-size: 13px; }

    /* ---------- Pager ---------- */
    .fx-pager { margin-top: 18px; }
    .fx-pager .pageoff { color: #6b7c93; margin-left: 10px; font-size: 13px; }

    @@media (max-width: 992px) {
        .fx-workspace { grid-template-columns: 1fr; }
        .fx-sidebar { max-height: 200px; border-right: none; border-bottom: 1px solid #eef1f5; }
        .fx-listrow { grid-template-columns: 50px 1fr 100px; }
        .fx-listrow .col-group, .fx-listrow .col-pb { display: none; }
    }

    /* List view lazy: native CSS - browser skip rendering offscreen rows */
    .fx-listview .fx-listrow:not(.fx-listrow--header) {
        content-visibility: auto;
        contain-intrinsic-size: 0 56px;
    }
    .fx-files .fx-file {
        content-visibility: auto;
        contain-intrinsic-size: 0 320px;
    }

    /* Context menu - right-click on folder/file */
    .fx-ctxmenu {
        position: fixed;
        z-index: 9999;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .14);
        padding: 6px;
        min-width: 200px;
        display: none;
        font-size: 13px;
    }
    .fx-ctxmenu.is-open { display: block; }
    .fx-ctxmenu__item {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 12px;
        border-radius: 5px;
        color: #374151;
        cursor: pointer;
        text-decoration: none;
        transition: background .08s;
    }
    .fx-ctxmenu__item:hover { background: #f3f6fb; color: #2563eb; text-decoration: none; }
    .fx-ctxmenu__item.is-danger:hover { background: #fef2f2; color: #b91c1c; }
    .fx-ctxmenu__item.is-disabled { opacity: .4; pointer-events: none; }
    .fx-ctxmenu__item i { width: 16px; text-align: center; color: #6b7c93; }
    .fx-ctxmenu__item:hover i { color: inherit; }
    .fx-ctxmenu__sep { height: 1px; background: #eef1f5; margin: 4px 6px; }
    .fx-ctxmenu__header {
        padding: 8px 12px 6px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #9ca3af;
        font-weight: 600;
        max-width: 240px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Move modal - folder picker tree */
    .fx-move-tree {
        max-height: 360px;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 8px 4px;
        background: #fafbfc;
    }
    .fx-move-node {
        display: flex; align-items: center; gap: 6px;
        padding: 6px 10px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 13px;
    }
    .fx-move-node:hover { background: #eef4ff; color: #2563eb; }
    .fx-move-node.is-selected { background: #2563eb; color: #fff; font-weight: 600; }
    .fx-move-node.is-disabled { opacity: .35; cursor: not-allowed; }
    .fx-move-node .ic { width: 16px; text-align: center; color: #2563eb; }
    .fx-move-node.is-selected .ic { color: #fff; }

    /* Right-clickable cards: hint cursor on hover */
    .ctx-target { user-select: none; }
</style>

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title" style="background:transparent;border:0;padding-bottom:8px">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-portfolio icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Quản lý dự án
                        <div class="page-title-subheading">
                            Duyệt theo cấu trúc thư mục (nhóm dự án &rarr; dự án).
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fx" style="background:#fff;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.04)">

            @* ============================================================
               TOP TOOLBAR: Breadcrumb + actions (luon o top, sticky-able)
               ============================================================ *@
            <div class="fx-topbar">
                <div class="fx-crumbs">
                    @if (currentGid.HasValue && crumbs.Count > 0)
                    {
                        <a href="@Url.Action("Index", "Projects")" class="fx-btn fx-btn--ghost" title="Quay lại">
                            <i class="fa fa-arrow-left"></i>
                        </a>
                    }
                    <a href="@Url.Action("Index", "Projects")" class="fx-crumb @(currentGid.HasValue ? "" : "fx-crumb--current")">
                        <i class="fa fa-home"></i> Tất cả
                    </a>
                    @for (int i = 0; i < crumbs.Count; i++)
                    {
                        var c = crumbs[i];
                        var isLast = (i == crumbs.Count - 1);
                        <span class="fx-crumb-sep"><i class="fa fa-chevron-right"></i></span>
                        if (isLast)
                        {
                            <span class="fx-crumb fx-crumb--current"><i class="fa fa-folder-open"></i> @c.GroupName</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Projects", new { gid = c.IDGroup })" class="fx-crumb">
                                <i class="fa fa-folder"></i> @c.GroupName
                            </a>
                        }
                    }
                </div>
                <div class="fx-actions">
                    <button type="button" id="btn-add-folder" class="fx-btn">
                        <i class="fa fa-folder-plus"></i> Nhóm mới
                    </button>
                    <button type="button" id="btn-add" class="fx-btn fx-btn--primary">
                        <i class="fa fa-plus"></i> Dự án mới
                    </button>
                    <div class="modal" id="myModal" role="dialog" data-url='@Url.Action("Create","Projects")' style="margin-top:50px"></div>
                    <button type="button" id="btn-Import" class="fx-btn">
                        <i class="fa fa-upload"></i> Upload
                    </button>
                    <div class="modal" id="myModalImport" role="dialog" data-url='@Url.Action("ImportExcel","Projects")' style="margin-top:50px"></div>
                    <button type="button" id="btn-Export" class="fx-btn">
                        <i class="fa fa-download"></i> Excel
                    </button>
                    <a href="@Url.Action("Index", "Permission")" class="fx-btn fx-btn--primary" title="Cấp/thu hồi quyền truy cập">
                        <i class="fa fa-key"></i> Phân quyền
                    </a>
                </div>
            </div>

            @* ============================================================
               WORKSPACE: Sidebar tree + Main grid
               ============================================================ *@
            <div class="fx-workspace">

                <aside class="fx-sidebar">
                    <div class="fx-sidebar__title"><i class="fa fa-sitemap"></i>&nbsp; Cấu trúc</div>
                    <a href="@Url.Action("Index", "Projects")"
                       class="fx-tree-node @(currentGid.HasValue ? "" : "is-active")">
                        <span class="ic"><i class="fa fa-home"></i></span>
                        <span>Tất cả</span>
                    </a>
                    @foreach (var node in tree)
                    {
                        @SidebarNode(node, currentGid, expandedSet)
                    }
                </aside>

                <main class="fx-main">

                    @* ---------- Sub-toolbar: search + sort + view ---------- *@
                    <div class="fx-subtoolbar">
                        <div class="fx-search">
                            <i class="fa fa-search"></i>
                            <input type="text" id="txtsearch" placeholder="Tìm dự án theo tên..." value="@searchText" />
                        </div>
                        <select id="fx-sort" class="fx-sort">
                            <option value="date-desc" @(sortKey == "date-desc" ? "selected" : "")>Mới nhất trước</option>
                            <option value="date-asc" @(sortKey == "date-asc" ? "selected" : "")>Cũ nhất trước</option>
                            <option value="name-asc" @(sortKey == "name-asc" ? "selected" : "")>Tên A &rarr; Z</option>
                            <option value="name-desc" @(sortKey == "name-desc" ? "selected" : "")>Tên Z &rarr; A</option>
                        </select>
                        <div class="fx-spacer"></div>
                        <div class="fx-viewtoggle">
                            <button type="button" data-view="grid" class="@(viewMode == "grid" ? "is-active" : "")" title="Lưới">
                                <i class="fa fa-th"></i>
                            </button>
                            <button type="button" data-view="list" class="@(viewMode == "list" ? "is-active" : "")" title="Danh sách">
                                <i class="fa fa-list"></i>
                            </button>
                        </div>
                    </div>

                    @* ---------- Subfolders section ---------- *@
                    @if (subfolders.Count > 0 && !isSearching)
                    {
                        <div class="fx-section">
                            <i class="fa fa-folder"></i> Nhóm con
                            <span class="count">(@subfolders.Count)</span>
                        </div>
                        if (viewMode == "list")
                        {
                            <div class="fx-listview">
                                <div class="fx-listrow fx-listrow--header">
                                    <div></div>
                                    <div>Tên</div>
                                    <div></div>
                                    <div></div>
                                    <div style="text-align:right">Thao tác</div>
                                </div>
                                @foreach (var sf in subfolders)
                                {
                                    <a href="@Url.Action("Index", "Projects", new { gid = sf.IDGroup })" class="fx-listrow fx-list-folder ctx-target"
                                       style="text-decoration:none;color:inherit"
                                       data-type="folder" data-id="@sf.IDGroup" data-name="@sf.GroupName"
                                       data-parent="@(sf.ParentIDGroup.HasValue ? sf.ParentIDGroup.Value.ToString() : "")"
                                       data-has-children="@(sf.Children.Count > 0 ? "1" : "0")"
                                       data-project-count="@sf.ProjectCount">
                                        <div><i class="fa fa-folder ic"></i></div>
                                        <div style="font-weight:600">@sf.GroupName</div>
                                        <div class="col-group" style="color:#6b7c93">@sf.Children.Count nhóm con · @sf.ProjectCount dự án</div>
                                        <div></div>
                                        <div></div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="fx-folders">
                                @foreach (var sf in subfolders)
                                {
                                    <a href="@Url.Action("Index", "Projects", new { gid = sf.IDGroup })" class="fx-folder ctx-target"
                                       data-type="folder" data-id="@sf.IDGroup" data-name="@sf.GroupName"
                                       data-parent="@(sf.ParentIDGroup.HasValue ? sf.ParentIDGroup.Value.ToString() : "")"
                                       data-has-children="@(sf.Children.Count > 0 ? "1" : "0")"
