@model EPORTAL.ModelsView360.ProjectsGroupValidation
@{
    var parentOpts = ViewBag.ParentOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var currentParent = Model != null && Model.ParentIDGroup.HasValue ? Model.ParentIDGroup.Value.ToString() : "";
}

@using (Html.BeginForm("Edit", "ProjectsGroup", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.IDGroup)
    @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl as string))
    {
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    }
    <div class="modal-dialog" id="form">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="ModalTitle"></h5>
                <a href="#" class="close" data-dismiss="modal">&times;</a>
            </div>
            <div class="modal-body">
                <fieldset id="SubmitForm">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="small mb-1">Tên nhóm dự án <span style="color:#dc2626">*</span></label>
                                @Html.EditorFor(model => model.GroupName, new { htmlAttributes = new { @class = "form-control", placeholder = "", @id = "GroupName", @required = true } })
                                <span id="ErrorFullName" style="color: red; text-transform: none; font-weight: normal "></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="small mb-1">Nhóm cha <span style="color:#6b7c93;font-weight:normal">(để trống = nhóm gốc)</span></label>
                                <select name="ParentIDGroup" id="ParentIDGroup" class="form-control" style="font-family: Consolas, monospace">
                                    <option value="">— Không có (nhóm gốc) —</option>
                                    @foreach (var opt in parentOpts)
                                    {
                                        if (opt.Value == currentParent)
                                        {
                                            <option value="@opt.Value" selected="selected">@opt.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Value">@opt.Text</option>
                                        }
                                    }
                                </select>
                                <small style="color:#6b7c93;font-size:11px">Không thể chọn chính nhóm này hoặc nhóm con của nó (đã ẩn để tránh vòng lặp).</small>
                            </div>
                        </div>
                    </div>
                    <div class="btn-margin-top text-center">
                        <input type="submit" value="Xác nhận" class="btn btn-success button_submit" />
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
}
