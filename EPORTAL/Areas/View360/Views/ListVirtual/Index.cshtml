@{
    ViewBag.Title = "Virtual Tour 360°";
    Layout = "~/Views/Shared/_LayoutV360Showcase.cshtml";
    ViewBag.BodyClass = "v360-sc-fit";  // viewport-fit layout, pager fixed bottom
}
@using EPORTAL.ModelsView360
@model PagedList.IPagedList<VirtualValidation>
@using PagedList.Mvc
@using EPORTAL.Models;
@{
    var tabs = (List<TabGroupViewModel>)ViewBag.TabGroups ?? new List<TabGroupViewModel>();
    var search = (string)ViewBag.search ?? "";
    ViewBag.SearchPlaceholder = "Tìm tour 360° theo tên...";
    var fallbackImg = Url.Content("~/Content/assets/images/bg4.jpg");
    var activeTab = tabs.FirstOrDefault(t => t.Active);
    var newCutoff = DateTime.Now.Date.AddDays(-7);

    // Icon map cho VR tour tabs - theo keyword name
    Func<string, string> getTabIcon = name =>
    {
        var n = (name ?? "").ToLowerInvariant();
        if (n.Contains("klh") || n.Contains("hpdq")) return "fa-industry";
        if (n.Contains("kho"))                       return "fa-warehouse";
        if (n.Contains("cảng") || n.Contains("cang") || n.Contains("cth")) return "fa-anchor";
        if (n.Contains("camera"))                    return "fa-video";
        return "fa-vr-cardboard";
    };
}

<link href="~/Content/PagedList.css" rel="stylesheet" />

<div class="v360-sc-fit__head">

    @* Parent tabs - VirtualGroup hien tai flat, khong co sub-groups *@
    @if (tabs.Count > 0)
    {
        <div class="v360-tabs-wrap" data-v360-tabs data-visible="9">
            <button type="button" class="v360-tabs-arrow v360-tabs-arrow--prev" aria-label="Trước">
                <i class="fa fa-chevron-left"></i>
            </button>
            <nav class="v360-sc-tabs" aria-label="Nhóm tour 360">
                @foreach (var tab in tabs)
                {
                    <a class="v360-sc-tab @(tab.Active ? "active" : "")"
                       href="@Url.Action("Index", "ListVirtual", new { id = tab.IDGroup })"
                       title="@tab.GroupName">
                        <i class="fa @getTabIcon(tab.GroupName) v360-sc-tab__icon"></i>
                        @tab.GroupName
                    </a>
                }
            </nav>
            <button type="button" class="v360-tabs-arrow v360-tabs-arrow--next" aria-label="Sau">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    }

    @* Filter bar *@
    <div class="v360-sc-filterbar">
        <div class="v360-sc-filterbar__left">
            <span class="v360-sc-crumb__current">
                @(!string.IsNullOrEmpty(search) ? "Kết quả tìm kiếm" : (activeTab != null ? activeTab.GroupName : "Tất cả tour 360°"))
            </span>
            <span class="v360-sc-crumb__meta">· @Model.TotalItemCount tour</span>
            @if (!string.IsNullOrEmpty(search))
            {
                var clearSearchUrl = Url.Action("Index", "ListVirtual", new { id = activeTab != null ? (int?)activeTab.IDGroup : null });
                <a href="@clearSearchUrl" class="v360-sc-searchchip" title="Bỏ từ khoá tìm kiếm này">
                    <i class="fa fa-search v360-sc-searchchip__icon"></i>
                    <span>Tìm: <b>@search</b></span>
                    <span class="v360-sc-searchchip__close" aria-label="Xoá tìm kiếm">×</span>
                </a>
            }
        </div>
    </div>

</div>

<div class="v360-sc-fit__body">

@* ====================================================================
   CONTENT: pure card grid - giong ListProject
   ==================================================================== *@
@if (Model.Count == 0)
{
    <div class="v360-sc-empty">
        <i class="fa fa-vr-cardboard"></i>
        <h3>Chưa có tour 360°</h3>
        <p>
            @if (!string.IsNullOrEmpty(search))
            {
                <text>Không tìm thấy kết quả cho "@search". Thử từ khóa khác hoặc đổi nhóm.</text>
            }
            else
            {
                <text>Nhóm này chưa có tour 360° nào. Chọn nhóm khác trên thanh tab phía trên.</text>
            }
        </p>
    </div>
}
else
{
    <div class="v360-grid">
        @foreach (var item in Model)
        {
            var imgUrl = string.IsNullOrEmpty(item.Images)
                ? fallbackImg
                : Url.Content("~/Images/" + System.IO.Path.GetFileName(item.Images));
            var introUrl = Url.Action("Intro", "ListVirtual", new { id = item.ID });
            <a class="v360-card" href="@introUrl">
                <div class="v360-card__media">
                    <img src="@imgUrl" alt="@item.Title"
                         width="400" height="275"
                         loading="lazy" decoding="async" />
                    <span class="v360-card__badge"><i class="fa fa-vr-cardboard"></i>&nbsp;VR 360°</span>
                    <div class="v360-card__overlay">
                        <span class="v360-card__overlay-action">
                            Khám phá <i class="fa fa-arrow-right"></i>
                        </span>
                    </div>
                </div>
                <div class="v360-card__body">
                    <h3 class="v360-card__title">@item.Title</h3>
                    @{
                        var displayNote = (item.Note ?? "").Trim();
                        if (displayNote.Length < 2) { displayNote = ""; }
                    }
                    @if (!string.IsNullOrEmpty(displayNote))
                    {
                        <p class="v360-card__desc">@displayNote</p>
                    }
                    <div class="v360-card__meta">
                        <span><i class="fa fa-calendar"></i> @item.Date.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </a>
        }
    </div>
}

</div>

@if (Model.Count > 0 && Model.PageCount > 1)
{
    <div class="v360-sc-fit__pager v360-pagination">
        @Html.PagedListPager(Model,
            page => Url.Action("Index", "ListVirtual", new { area = "View360", page, id = ViewContext.RouteData.Values["id"], search }))
    </div>
}
