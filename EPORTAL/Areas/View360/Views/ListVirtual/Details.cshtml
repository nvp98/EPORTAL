        setTimeout(function () { setMinimapState('fullscreen'); }, 100);
    }

    // ===== Minimap resize via grip - rAF throttle, invalidateSize chi o mouseup =====
    var grip = document.getElementById('v360-minimap-grip');
    if (grip) {
        grip.addEventListener('mousedown', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var sx = e.clientX, sy = e.clientY;
            var sw = minimap.offsetWidth, sh = minimap.offsetHeight;
            var pendingW = sw, pendingH = sh;
            var rafPending = false;
            // Flag: ResizeObserver skip heavy Leaflet ops trong khi user keo
            window.__minimapDragActive = true;
            function applyFrame() {
                rafPending = false;
                minimap.style.width = pendingW + 'px';
                minimap.style.height = pendingH + 'px';
                // KHONG call invalidateSize trong frame - rat ton, doi mouseup
            }
            function onMove(ev) {
                var dx = ev.clientX - sx;
                var dy = ev.clientY - sy;
                pendingW = Math.max(220, Math.min(window.innerWidth * 0.9, sw - dx));
                pendingH = Math.max(160, Math.min(window.innerHeight * 0.9, sh - dy));
                if (!rafPending) {
                    rafPending = true;
                    requestAnimationFrame(applyFrame);
                }
            }
            function onUp() {
                document.removeEventListener('mousemove', onMove);
                document.removeEventListener('mouseup', onUp);
                window.__minimapDragActive = false;
                // 1 lan duy nhat cuoi drag - apply min zoom + recompute (truoc do bi block boi flag)
                if (window._v360ApplyMinZoomAndFit) window._v360ApplyMinZoomAndFit();
                else if (lmap) lmap.invalidateSize({ pan: false, animate: false });
                recenterOnCurrent();
                refreshKmzTilesDebounced();
            }
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
        });
    }
    // Browser resize: debounce de tranh nhieu invalidateSize lien tuc
    var winResizeTimer = null;
