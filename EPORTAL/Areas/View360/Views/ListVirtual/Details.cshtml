    var stage         = document.querySelector('.v360-viewer__stage');
    var autorotateOn  = false;
    var autorotTimer  = null;

    var kuulaFrame    = null;
    var currentPostId = null;   // Kuula iframe runtime id - dung de postMessage load(id)
    var currentPostKey = null;  // Uuid (tu cover URL) - khoa chung SCENE_GPS/OFFSET (match server)
    var allPosts      = [];
    var idToUuid      = {};     // map iframe id -> uuid (build tu frameloaded posts list)

    // ====== Leaflet map state ======
    var lmap          = null;       // L.Map instance
    var sceneMarkers  = {};         // postId -> L.Marker (pins for all scenes with GPS)
    var currentMarker = null;       // L.Marker for current scene (with rotating cone)
    var coneEl        = null;       // DOM <div> inside currentMarker icon (cho rotate)

    // ===== Helper: center map o vi tri scene hien tai (dieu kien co GPS) =====
    function recenterOnCurrent() {
        if (!lmap || !currentPostKey) return;
        var ll = SCENE_GPS[currentPostKey];
        if (ll) lmap.panTo(ll, { animate: false });
    }

    // ===== Minimap states: normal / fullscreen / minimized =====
    function setMinimapState(state) {
        minimap.classList.remove('is-fullscreen', 'is-minimized');
        if (state === 'fullscreen') minimap.classList.add('is-fullscreen');
        else if (state === 'minimized') minimap.classList.add('is-minimized');
        if (lmap) {
            // CSS transition khi switch state co the chiem 100-300ms. Setting nay danh
            // bao toan: compute applyMinZoomAndFit 2 lan - lan dau ngay (snap to state cu),
            // lan 2 sau 200ms (CSS xong, viewport size da chinh xac -> minZoom dung).
            // Tranh truong hop minZoom set theo viewport CU lam user bi khoa zoom.
            var apply = function () {
                if (window._v360ApplyMinZoomAndFit) window._v360ApplyMinZoomAndFit();
                else lmap.invalidateSize({ pan: false, animate: false });
                recenterOnCurrent();
                refreshKmzTilesDebounced();
            };
            setTimeout(apply, 30);
            setTimeout(apply, 220);  // sau CSS transition typical 200ms
        }
    }
    var miniFsBtn  = document.getElementById('v360-minimap-fs');
    var miniMinBtn = document.getElementById('v360-minimap-min');
    if (miniFsBtn) miniFsBtn.addEventListener('click', function () {
        setMinimapState(minimap.classList.contains('is-fullscreen') ? 'normal' : 'fullscreen');
    });
    if (miniMinBtn) miniMinBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        setMinimapState(minimap.classList.contains('is-minimized') ? 'normal' : 'minimized');
    });
    // Click vao minimap khi minimized -> mo lai
    minimap.addEventListener('click', function (e) {
        if (minimap.classList.contains('is-minimized')) {
            setMinimapState('normal');
        }
    });

    // Auto-fullscreen khi vao trang voi ?mapMode=full (tu nut "XEM BAN DO KLH" Intro page)
    if (/[?&]mapMode=full/.test(window.location.search)) {
