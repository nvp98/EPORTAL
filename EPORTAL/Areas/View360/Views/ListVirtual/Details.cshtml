@{
    ViewBag.Title = Model.Title ?? "Virtual Tour";

    // Admin mode (Calibrate / Featured admin) -> dung _Layout.cshtml chung de co
    //   sidebar + topbar admin (de quan ly), KHONG dung showcase.
    // User mode (xem 360 thong thuong) -> showcase fullwidth + viewer.
    bool _isAdmin = (ViewBag.AdminMode == true || ViewBag.FeaturedAdminMode == true || ViewBag.ChatbotAdminMode == true);
    if (Request.QueryString["nolayout"] == "1")
    {
        Layout = null;
    }
    else if (_isAdmin)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutV360Showcase.cshtml";
        ViewBag.BodyClass = "v360-sc-fullwidth v360-sc-viewer";
        ViewBag.HideSearch = true;
        ViewBag.BackLabel = "Trở lại Intro";
        ViewBag.BackHref  = Url.Action("Intro", "ListVirtual", new { area = "View360", id = Model.ID });
    }
}
@model EPORTAL.ModelsView360.VirtualValidation
@{
    var mapImg = string.IsNullOrEmpty(Model.Images)
        ? Url.Content("~/Content/assets/images/bg9.jpg")
        : Url.Content("~/Images/" + System.IO.Path.GetFileName(Model.Images));

    // Option B: chromeless Kuula + custom UI ngoai iframe.
    // Theo demo https://static.kuula.io/demo/basic.html
    //   - chromeless=1: tat UI Kuula
    //   - logo=-1 / thumbs=-1 / fs=-1 / info=-1: an cac element (Kuula dung -1, khong phai 0)
    //   - enablejs=1: bat JS API postMessage event (KHONG phai 'js-api=1')
    var iframeUrl = Model.URL ?? "";
    var isKuula = iframeUrl.IndexOf("kuula", StringComparison.OrdinalIgnoreCase) >= 0
                 || iframeUrl.IndexOf("viewin360", StringComparison.OrdinalIgnoreCase) >= 0;

    // Deep-link: server-side resolve uuid -> Kuula short Id. Neu co, rewrite iframe URL
    // tu .../share/collection/<colId> -> .../share/<sceneId>/collection/<colId> de Kuula
    // load THANG scene do, KHONG can postMessage switch (cach cu gay WebGL CONTEXT_LOST).
    var startSceneId = ViewBag.IframeStartSceneId as string;
    if (isKuula && !string.IsNullOrEmpty(startSceneId))
    {
        var collIndex = iframeUrl.IndexOf("/share/collection/", StringComparison.OrdinalIgnoreCase);
        if (collIndex > 0)
        {
            iframeUrl = iframeUrl.Substring(0, collIndex)
                      + "/share/" + startSceneId + "/collection/"
                      + iframeUrl.Substring(collIndex + "/share/collection/".Length);
        }
    }

    if (isKuula)
    {
        // Giu Kuula native chrome (audio + fullscreen buttons) nhung an cac element thua.
        //   enablejs=1     enable postMessage JS API (REQUIRED cho orientation events)
        //   cusdomwrap=1   custom wrapper protocol (REQUIRED cho postMessage)
        //   thumbs=-1      hide thumbnail strip / scene picker
        //   logo=-1        hide Kuula watermark logo
        //   info=-1        hide info / "Danh sách khu vực" / location panel
        //   card=-1        hide card popup overlays
        //   nav=-1         hide left/right nav arrows giua iframe
        //   gyro=-1        hide gyro/orientation toggle (mobile)
        //   vr=-1          hide VR mode toggle (Cardboard)
        //   floorplan=-1   hide built-in floor plan (custom minimap thay)
        //   autopvideo=0   khong autoplay video
        //   GIU LAI:
        //     fs            -> fullscreen button (Kuula default)
        //     audio control -> built-in audio play/mute
        var extra = "enablejs=1&cusdomwrap=1"
                  + "&thumbs=-1&logo=-1&info=-1&card=-1&nav=-1&gyro=-1&vr=-1&floorplan=-1"
                  + "&autopvideo=0";
        iframeUrl += (iframeUrl.Contains("?") ? "&" : "?") + extra;
    }
}

