@* Leaflet for real-GPS minimap with satellite tiles. Self-host (~/Content/leaflet) thay vi unpkg CDN
   de prod khong phu thuoc internet ben ngoai (corporate firewall co the chan unpkg). *@
<link rel="stylesheet" href="@Url.Content("~/Content/leaflet/leaflet.css")?v=1.9.4" />
<script src="@Url.Content("~/Content/leaflet/leaflet.js")?v=1.9.4"></script>

<div class="app-main__outer v360-app-outer">
    <div class="app-main__inner v360-app-inner" style="padding:0;">
        <div class="v360-area v360-area--viewer">
            <div class="v360-viewer v360-viewer--custom">

                <!-- Stage: iframe full bleed + minimap overlay (no header, no thumbs) -->
