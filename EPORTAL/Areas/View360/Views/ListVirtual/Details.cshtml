    // Getter pattern - idToUuid + allPosts bi REASSIGN trong buildPostsList.
    window.__v360GetIdToUuid    = function () { return idToUuid; };
    window.__v360GetAllPosts    = function () { return allPosts; };
    window.__v360CurrentScene   = function () {
        return {
