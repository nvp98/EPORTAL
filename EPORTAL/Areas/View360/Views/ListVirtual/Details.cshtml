                    <iframe id="v360-iframe"
                            class="v360-viewer__iframe"
                            src="@iframeUrl"
                            frameborder="0"
                            allowfullscreen
                            allow="xr-spatial-tracking; gyroscope; accelerometer; microphone; autoplay"
