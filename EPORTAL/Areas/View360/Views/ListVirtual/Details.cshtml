    console.log('[v360] MANUAL OVERRIDE:\n'
        + '  - Alt + scroll wheel tren minimap = xoay cone +/- 5°\n'
        + '  - Shift + Alt + wheel = +/- 1° (tinh chinh)\n'
        + '  - v360HideCone() = an cone cua scene hien tai (huong sai/khong tin)\n'
        + '  - v360HideCone(false) = bat lai cone\n'
        + '  - Tinh chinh nhanh: dung admin page /Calibrate/{id} (UI day du, luu DB).');

    // ===== Init Leaflet map (KMZ drone imagery overlays + Esri fallback) =====
    var KMZ_TILES = @Html.Raw(ViewBag.KmzManifestJson ?? "[]");
    var KMZ_BASE  = '@Url.Content("~/Content/view360-imagery/")';
    var kmzActive = {};   // href -> L.imageOverlay hien dang tren map

    // Max LOD letter cho moi zoom level - lod cao hon = chi tiet hon, tile nho hon.
    // Khi zoom out (xa) chi can a/b; zoom in (gan) moi can f (chi tiet nhat, ~0.3m/px).
    function maxLodForZoom(z) {
        if (z >= 18) return 'f';
        if (z >= 17) return 'e';
        if (z >= 16) return 'd';
        if (z >= 15) return 'c';
        if (z >= 14) return 'b';
        return 'a';
    }

    function refreshKmzTiles() {
        if (!lmap || !KMZ_TILES.length) return;
        var bounds = lmap.getBounds();
        var maxLod = maxLodForZoom(lmap.getZoom());
        var needed = {};
        KMZ_TILES.forEach(function (t) {
            if (t.lod > maxLod) return;
            var tb = L.latLngBounds([[t.south, t.west], [t.north, t.east]]);
            if (!bounds.intersects(tb)) return;
            needed[t.href] = t;
        });
        Object.keys(kmzActive).forEach(function (href) {
            if (!needed[href]) {
                lmap.removeLayer(kmzActive[href]);
                delete kmzActive[href];
            }
        });
        Object.keys(needed).forEach(function (href) {
            if (kmzActive[href]) return;
            var t = needed[href];
            kmzActive[href] = L.imageOverlay(KMZ_BASE + href,
                [[t.south, t.west], [t.north, t.east]],
                {
                    opacity: 1,
                    interactive: false,
                    pane: 'kmz-lod-' + t.lod,
                    className: 'v360-kmz-tile v360-kmz-tile--' + (t.lod || 'x')
                }
            ).addTo(lmap);
        });
    }
    // Debounce de tranh spam khi user resize/pan/zoom lien tuc (549 tiles iterate ton cpu)
    var kmzRefreshTimer = null;
    function refreshKmzTilesDebounced() {
        if (kmzRefreshTimer) clearTimeout(kmzRefreshTimer);
        kmzRefreshTimer = setTimeout(refreshKmzTiles, 180);
    }

    function initLeafletMap() {
        if (!window.L) { console.warn('[v360] Leaflet chua load'); return; }
        // 2 bounds: TIGHT cho fullscreen fit, WIDE cho small mode cover.
        // - Small (cover): WIDE = union all tiles -> khong bi zoom in qua sau
        // - Fullscreen (contain): TIGHT = P10-P90 percentile -> drop outliers, fit factory
        // Fallback LOD: f -> e -> d -> c
        // KMZ overlay extent = vung drone SCAN that su, tinh tu LOD f tile coverage.
        // LOD a/b/c bao roi nhung co transparent pixels outside scanned area - khong phai
        // visible KMZ. LOD f tiles chi co o vung drone da scan -> union LOD f = actual KMZ shape.
        var detailBounds = null;
        if (KMZ_TILES && KMZ_TILES.length) {
            var lodF = KMZ_TILES.filter(function (t) { return t.lod === 'f'; });
            var srcTiles = lodF.length > 0 ? lodF : KMZ_TILES; // fallback if no LOD f

            // Union of LOD f tile bboxes = visible KMZ rectangle (4 goc cua KMZ overlay).
            detailBounds = L.latLngBounds([]);
            srcTiles.forEach(function (t) {
                detailBounds.extend([[t.south, t.west], [t.north, t.east]]);
            });

            console.log('[v360] KMZ visible bounds (' + (lodF.length > 0 ? 'LOD f union' : 'all tiles fallback') + '): ' +
                ((detailBounds.getNorth() - detailBounds.getSouth()) * 111).toFixed(1) + 'km x ' +
                ((detailBounds.getEast() - detailBounds.getWest()) * 111).toFixed(1) + 'km ' +
                '[N=' + detailBounds.getNorth().toFixed(5) + ', S=' + detailBounds.getSouth().toFixed(5) +
                ', E=' + detailBounds.getEast().toFixed(5) + ', W=' + detailBounds.getWest().toFixed(5) + ']');
        }
        var detailBoundsWide = detailBounds; // single source of truth
        var initCenter = detailBounds ? detailBounds.getCenter() : MAP_CENTER;
        lmap = L.map('v360-leaflet-map', {
            center: initCenter,
            zoom: 15,
            maxZoom: 21,                       // cho phep zoom sau cho LOD f
            zoomControl: true,
            attributionControl: false,
            maxBounds: detailBounds || null,     // pan trong KMZ visible bounds only
            maxBoundsViscosity: 1.0,           // hard limit, khong cho keo ra
            zoomSnap: 0,                       // free fractional zoom - tranh round lam cover==contain
                                                // (gay tinh trang user khoa zoom o min level)
            zoomDelta: 0.5                     // user click +/- zoom 0.5 buoc
        });
        // Pane per LOD - z-index tang dan, LOD cao chi tiet hon nam tren cung
        ['a','b','c','d','e','f'].forEach(function (letter, idx) {
            lmap.createPane('kmz-lod-' + letter);
            lmap.getPane('kmz-lod-' + letter).style.zIndex = 410 + idx;
            lmap.getPane('kmz-lod-' + letter).style.pointerEvents = 'none';
        });
        // Map server bi chan/loi (firewall production) -> bao 1 lan, KHONG lam vo minimap:
        // pin + cone van hoat dong (chi mat anh nen ve tinh).
        function showMapOffline() {
            if (document.getElementById('v360-map-offline')) return;
            var host = document.getElementById('v360-minimap-body') || document.getElementById('v360-minimap');
            if (!host) return;
            var note = document.createElement('div');
            note.id = 'v360-map-offline';
            note.textContent = '⚠ Bản đồ nền không tải được';
            note.style.cssText = 'position:absolute;left:8px;bottom:8px;z-index:600;background:rgba(0,0,0,.62);color:#ffd66e;font-size:11px;padding:3px 8px;border-radius:5px;pointer-events:none';
            host.appendChild(note);
        }
        // Base: Esri (low-zoom backdrop ngoai vung KMZ)
        var esriLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            maxNativeZoom: 19,                 // beyond zoom 19, Leaflet upscale tile thay vi 404
            attribution: 'Esri'
        }).addTo(lmap);
        var _tileErrCount = 0;
        esriLayer.on('tileerror', function () {
            if (++_tileErrCount === 8) showMapOffline();   // nhieu tile loi -> coi nhu map server khong toi duoc
        });

        // Aspect ratio cua KLH bounds (mercator-aware: dx = dlng, dy = dlat / cos(lat))
        // Dung WIDE bounds (full KMZ extent) de fullscreen container fit khit KMZ overlay,
        // khong thay area beyond KLH o canh viewport.
        var aspectSrc = detailBoundsWide || detailBounds;
        if (aspectSrc) {
            var bw = aspectSrc.getEast() - aspectSrc.getWest();
            var bh = aspectSrc.getNorth() - aspectSrc.getSouth();
            var latC = (aspectSrc.getNorth() + aspectSrc.getSouth()) / 2;
            var klhAspect = (bw * Math.cos(latC * Math.PI / 180)) / bh;
            if (isFinite(klhAspect) && klhAspect > 0.1 && klhAspect < 10) {
                document.documentElement.style.setProperty('--v360-klh-aspect', klhAspect.toFixed(4));
            }
        }

        // KMZ dynamic loader - listen move/zoom
        if (detailBounds) {
            // Cover vs contain phu thuoc state minimap:
            //  - Normal/minimized (small): COVER (inside=true) - khong thay ocean/bien o canh
            //  - Fullscreen (big landscape viewport): CONTAIN (inside=false) - thay het KLH
            // Truoc khi compute zoom phai invalidateSize de Leaflet dung size hien tai (sau khi
            // CSS resize/fullscreen toggle, internal size cu, getBoundsZoom tra value sai)
            window._v360ApplyMinZoomAndFit = function () {
                if (!detailBounds || !lmap) return;
                // Wait 2 rAF for browser to fully complete layout + paint after CSS state change.
                // Vital sau setMinimapState transition - tranh invalidateSize/getBoundsZoom
                // do viewport stale (size cu cua state truoc) -> minZoom wrong -> user khoa zoom.
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        lmap.invalidateSize({ pan: false, animate: false });
                        var coverZoom = lmap.getBoundsZoom(detailBounds, true);
                        var containZoom = lmap.getBoundsZoom(detailBounds, false);
                        // Safety margin: minZoom = containZoom - 0.5. Khi viewport aspect khop bounds
                        // aspect, cover ≈ contain -> minZoom = current zoom -> user stuck. Margin
                        // 0.5 cho user 0.5 cap zoom out them (xem padding tu khoang khong KMZ).
                        var minZoom = Math.max(0, containZoom - 0.5);
                        console.log('[v360] applyMinZoom: viewport ' +
                            lmap.getSize().x + 'x' + lmap.getSize().y +
                            ', cover=' + coverZoom.toFixed(3) +
                            ', contain=' + containZoom.toFixed(3) +
                            ', minZoom=' + minZoom.toFixed(3) +
                            ', currentZoom=' + lmap.getZoom().toFixed(3));
                        lmap.setMinZoom(minZoom);
                        if (lmap.getZoom() < minZoom || lmap.getZoom() > 20) {
                            lmap.setView(detailBounds.getCenter(), coverZoom, { animate: false });
                        }
                    });
                });
            };
            window._v360ApplyMinZoomAndFit();
            lmap.on('moveend', refreshKmzTilesDebounced);
            lmap.on('zoomend', refreshKmzTilesDebounced);
            // Re-compute khi minimap doi size (resize grip / window resize).
            // Fullscreen toggle goi truc tiep tu setMinimapState - khong cho ResizeObserver
            // timing-race lam minZoom sai sau khi exit fullscreen.
            if (window.ResizeObserver && minimap) {
                var rzTimer = null;
                new ResizeObserver(function () {
                    // Bo qua khi user dang keo grip - tranh heavy Leaflet ops moi 80ms
                    // lam lag chuot. mouseup handler se goi 1 lan o cuoi.
                    if (window.__minimapDragActive) return;
                    if (rzTimer) clearTimeout(rzTimer);
                    rzTimer = setTimeout(window._v360ApplyMinZoomAndFit, 80);
                }).observe(minimap);
            }
            refreshKmzTiles();
            console.log('[v360] KMZ drone: ' + KMZ_TILES.length + ' tiles - cover (small) / contain (fullscreen)');
        } else {
            lmap.fitBounds([MAP_BOUNDS_SW, MAP_BOUNDS_NE]);
        }

        // ===== Shift+click = calibrate current scene =====
        lmap.on('click', function (e) {
            if (!e.originalEvent.shiftKey || !currentPostKey) return;
            var lat = +e.latlng.lat.toFixed(6);
            var lng = +e.latlng.lng.toFixed(6);
            SCENE_GPS[currentPostKey] = [lat, lng];
            console.log('[v360] CALIBRATED', currentPostKey, '→ [' + lat + ', ' + lng + ']');
            renderScenePins();
            moveCurrentMarker(currentPostKey);
        });

        // Hint cursor when holding Shift
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Shift' && lmap) lmap.getContainer().style.cursor = 'crosshair';
        });
        document.addEventListener('keyup', function (e) {
            if (e.key === 'Shift' && lmap) lmap.getContainer().style.cursor = '';
        });
    }

    // Trich uuid tu cover URL. Kuula CDN co the doi format theo thoi gian - thu nhieu pattern.
    function uuidFromCover(coverUrl) {
        if (!coverUrl) return null;
        // Pattern 1: files.kuula.io/<uuid>/...   (current)
        // Pattern 2: cdn.kuula.io/<uuid>/...     (alternative CDN)
        // Pattern 3: media.kuula.io/<uuid>/...   (media files)
        // Pattern 4: any *.kuula.* host with hex-dashed uuid segment
        var m = coverUrl.match(/(?:files|cdn|media)\.kuula\.[a-z]+\/([a-f0-9-]{8,})\//i)
             || coverUrl.match(/kuula\.[a-z]+\/[^/]*\/([a-f0-9-]{8,})\//i)
             || coverUrl.match(/([a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4})/i);  // bare uuid pattern
        return m ? m[1].toLowerCase() : null;
    }
    // Kuula dung Id khac giua share page (server fetch) va iframe runtime,
    // chi Uuid (extract tu cover URL) match duoc.
    function postKey(post) {
        return post._uuid || (post._uuid = uuidFromCover(post.cover)) || post.id;
    }

    // ===== Render pins for all scenes that have GPS =====
    function renderScenePins() {
        // Clear old pins
        Object.keys(sceneMarkers).forEach(function (id) {
            lmap.removeLayer(sceneMarkers[id]);
        });
        sceneMarkers = {};

        var withGps = 0;
        var pinSize = (TOUR_CONFIG && TOUR_CONFIG.PinSize) || 11;
        allPosts.forEach(function (post) {
            var key = postKey(post);
            var ll = SCENE_GPS[key];
            if (!ll) return;
            var hidden = !!SCENE_HIDE_PIN[key];
            // User thuong: an thuc su. Admin: van hien (dim + dashed) de tim lai duoc.
            if (hidden && !ADMIN_MODE) return;
            withGps++;
            var pinSizeFinal = hidden ? Math.max(pinSize, 14) : pinSize; // hidden pin to hon de de click
            var icon = L.divIcon({
                className: 'v360-leaf-pin'
                    + (key === currentPostKey ? ' is-current' : '')
                    + (hidden ? ' is-hidden' : ''),
                html: '',
                iconSize: [pinSizeFinal, pinSizeFinal],
                iconAnchor: [pinSizeFinal / 2, pinSizeFinal / 2]
            });
            var m = L.marker(ll, { icon: icon });
            var label = SCENE_CUSTOM_TITLE[key]
                     || (post.title && post.title.trim())
                     || post.id;
            m.bindTooltip(label, {
                direction: 'top',
                offset: [0, -4],
                className: 'v360-leaf-tooltip',
                opacity: 1
            });
            m.on('click', (function (pid) {
                return function () {
                    kuulaSend('load', { id: pid });
                    // Nguoi dung click pin tu mini map fullscreen -> shrink ve normal de tham quan
                    if (minimap.classList.contains('is-fullscreen')) setMinimapState('normal');
                };
            })(post.id));
            m.addTo(lmap);
            sceneMarkers[key] = m;
        });
        console.log('[v360] Rendered ' + withGps + '/' + allPosts.length + ' scene pins on Leaflet');

        // Auto-fit bounds if we have multiple pins
        if (withGps > 1) {
            var llArr = Object.values(SCENE_GPS).map(function (p) { return L.latLng(p[0], p[1]); });
            lmap.fitBounds(L.latLngBounds(llArr).pad(0.15));
        }
    }

    function moveCurrentMarker(postKey) {
        var ll = SCENE_GPS[postKey];
        if (!ll || !lmap) return;
        if (currentMarker) lmap.removeLayer(currentMarker);
        var icon = L.divIcon({
            className: 'v360-leaf-current',
            html: '<div class="v360-leaf-cone" id="v360-leaf-cone"></div>'
                + '<div class="v360-leaf-dot"></div>',
            iconSize: [60, 60],
            iconAnchor: [30, 30]
        });
        currentMarker = L.marker(ll, { icon: icon, interactive: false, zIndexOffset: 1000 });
        currentMarker.addTo(lmap);
        setTimeout(function () {
            coneEl = document.getElementById('v360-leaf-cone');
            snapConeRotation();
        }, 0);
        Object.keys(sceneMarkers).forEach(function (k) {
            var el = sceneMarkers[k].getElement();
            if (el) el.classList.toggle('is-current', k === postKey);
        });
    }

    // Init Leaflet after DOM ready (script load order)
    if (window.L) initLeafletMap();
    else window.addEventListener('load', initLeafletMap);

    // ===== Kuula iframe FS: KHONG intercept (chap nhan minimap an trong FS) =====
    // Theo Fullscreen API spec, khi 1 element vao FS chi rieng element do + descendants render
    // -> minimap (sibling cua iframe) bi browser an cung. Khong workaround duoc cross-origin.
    // Redirect (exit roi request stage) khong on dinh vi user activation expire khi promise resolve.
    // Lua chon: Kuula FS hoaạt dong native, user ESC de quay lai trang co minimap.

    // ===== Build Leaflet pins from posts list =====
    function buildPostsList(posts) {
        console.log('[v360] First post structure:', JSON.stringify(posts[0], null, 2));
        allPosts = posts.slice();
        // Build iframeId -> uuid map de postloaded (co the khong co cover) van resolve duoc
        idToUuid = {};
        posts.forEach(function (p) {
            var u = uuidFromCover(p.cover);
            if (u) { idToUuid[p.id] = u; p._uuid = u; }
        });
        console.log('[v360] idToUuid map: ' + Object.keys(idToUuid).length + ' / ' + posts.length + ' posts co cover URL');

        if (lmap) renderScenePins();

        var withGps = Object.keys(SCENE_GPS).filter(function (id) {
            return posts.some(function (p) { return p.id === id; });
        }).length;
        console.log('[v360] ' + posts.length + ' posts, ' + withGps + ' co GPS');
        if (withGps === 0) {
            console.warn('[v360] SCENE_GPS rong. Shift+click vao map de calibrate diem.');
        }
    }

    function moveMarkerToScene(postKey, postTitle) {
        if (lmap && SCENE_GPS[postKey]) {
            moveCurrentMarker(postKey);
            lmap.panTo(SCENE_GPS[postKey], { animate: true, duration: 0.5 });
        }
    }

@if (isKuula)
{
    <text>
    // ===== Manual postMessage protocol (bypass api.js strict src matching) =====
    // Kuula player tu append fid/cusdomwrap vao URL, lam api.js's
    // querySelector('iframe[src=...]') fail. Tu handle protocol thay vi dung api.js.
    //
    // Protocol (decode tu api.js source):
    //   FROM iframe: { kuula:true, cmd:'frameloaded'|'postloaded'|'orientation'|'hotspot',
    //                  uuid:'<fid>', src?:'...', data:{...} }
    //   TO iframe:   iframe.contentWindow.postMessage({ kuula:true, uuid:'<fid>',
    //                  cmd:'load'|'heading'|'pitch'|'zoom'|'autorotate'|'hotspotclick'|'closecard',
    //                  ... }, '*')

    function kuulaSend(cmd, extras) {
        if (!kuulaFrame || !iframe.contentWindow) return;
        var msg = extras || {};
        msg.kuula = true;
        msg.uuid = kuulaFrame;
        msg.cmd = cmd;
        iframe.contentWindow.postMessage(msg, '*');
    }

    function deriveTitle(description) {
        if (!description) return '';
        var first = description.split('\n')[0].replace(/\*/g, '');
        var i = first.indexOf('.');
        return i > -1 ? first.substring(0, i) : first;
    }

    window.addEventListener('message', function (ev) {
        var d = ev.data;
        if (!d || d.kuula !== true) return;

        switch (d.cmd) {
            case 'frameloaded':
                console.log('[v360] frameloaded', d);
                window.__v360FrameloadedFired = true;
                kuulaFrame = d.uuid;
                // Hide loading CHI KHI khong co deep-link pending - tranh user thay default
                // scene flash truoc khi switch sang target. Voi pending, loading screen stay
                // visible cho den khi target scene load xong (xu ly o postloaded ben duoi).
                if (loading && !PENDING_GO_SCENE) loading.classList.add('is-hidden');
                if (d.data && d.data.posts && d.data.posts.length) {
                    d.data.posts.forEach(function (p) { if (!p.title) p.title = deriveTitle(p.description); });
                    buildPostsList(d.data.posts);
                } else {
                    console.warn('[v360] frameloaded khong co posts array');
                }
                break;

            case 'postloaded':
                var p = d.data || {};
                if (!p.title) p.title = deriveTitle(p.description);
                currentPostId  = p.id;
                // Resolve uuid: uu tien cover URL trong event, fallback map tu frameloaded.
                currentPostKey = uuidFromCover(p.cover) || idToUuid[p.id] || p.id;
                console.log('[v360] postloaded: id=' + p.id + ' uuid=' + currentPostKey
                    + ' (mapHit=' + (idToUuid[p.id] ? 'Y' : 'N') + ') title=' + p.title);
                moveMarkerToScene(currentPostKey, p.title || p.id);
                var dg = SCENE_CALIB_DIAG[currentPostKey];
                if (dg) {
                    console.log('[v360]   calib: ' + dg.SampleCount + ' hotspots, sense=' + dg.Sense + ', offset=' + dg.Offset + '°');
                } else {
                    console.log('[v360]   calib: KHONG co (scene khong co GPS hoac khong match uuid)');
                }
                if (ADMIN_MODE && typeof window.__adminOnSceneChange === 'function') {
                    window.__adminOnSceneChange();
                }
                if (FEATURED_ADMIN_MODE && typeof window.__featOnSceneChange === 'function') {
                    window.__featOnSceneChange();
                }
                if (CHATBOT_ADMIN_MODE && typeof window.__chatbotOnSceneChange === 'function') {
                    window.__chatbotOnSceneChange();
                }
                // Deep-link dispatch: chi dispatch sau 'postloaded' dau tien (Kuula viewer
                // da stable). Neu dispatch som hon (vi du o frameloaded) thi viewer crash.
                // Loading screen LUON HIEN cho den target's postloaded - user khong thay
                // default scene flash.
                if (PENDING_GO_SCENE) {
                    var target = String(PENDING_GO_SCENE).toLowerCase();
                    var alreadyThere = String(currentPostKey || '').toLowerCase() === target;
                    if (alreadyThere) {
                        console.log('[v360] deep-link: da o scene ' + PENDING_GO_SCENE);
                        PENDING_GO_SCENE = null;
                        if (loading) loading.classList.add('is-hidden');
                    } else {
                        var targetId = null;
                        for (var pid in idToUuid) {
                            if (String(idToUuid[pid] || '').toLowerCase() === target) { targetId = pid; break; }
                        }
                        if (!targetId) {
                            for (var pid2 in idToUuid) {
                                if (String(pid2).toLowerCase() === target) { targetId = pid2; break; }
                            }
                        }
                        if (targetId) {
                            console.log('[v360] deep-link: load post ' + targetId + ' (uuid=' + PENDING_GO_SCENE + ')');
                            // Cap nhat loading text neu co - feedback ro rang dang switch
                            var subEl = document.querySelector('.v360-loading__sub');
                            if (subEl) subEl.textContent = 'Đang chuyển tới khu vực được chọn…';
                            var idToLoad = targetId;
                            // Move PENDING -> awaiting flag: target scene's postloaded se hide loading
                            window.__awaitingDeepLinkPost = target;
                            PENDING_GO_SCENE = null;
                            setTimeout(function () { kuulaSend('load', { id: idToLoad }); }, 250);
                        } else {
                            console.warn('[v360] deep-link: uuid ' + PENDING_GO_SCENE
                                + ' khong match post nao - ' + Object.keys(idToUuid).length + ' posts loaded');
                            PENDING_GO_SCENE = null;
                            if (loading) loading.classList.add('is-hidden');
                        }
                    }
                } else if (window.__awaitingDeepLinkPost) {
                    // Target scene's postloaded da fire - hide loading khi dung target reached
                    var awaiting = window.__awaitingDeepLinkPost;
                    if (String(currentPostKey || '').toLowerCase() === awaiting) {
                        window.__awaitingDeepLinkPost = null;
                        if (loading) loading.classList.add('is-hidden');
                        // Clean ?scene tu URL de refresh khong re-trigger deep-link
                        try {
                            var u = new URL(window.location.href);
                            if (u.searchParams.has('scene')) {
                                u.searchParams.delete('scene');
                                window.history.replaceState(null, '', u.toString());
                            }
                        } catch (e) { /* IE compat - bo qua */ }
                    }
                }
                break;

            case 'orientation':
                var o = d.data || {};
                if (typeof o.heading === 'number') {
                    lastHeading = o.heading;
                    applyConeRotation();
                    if (ADMIN_MODE) {
                        var hEl = document.getElementById('v360-admin-current-h');
                        if (hEl) hEl.textContent = Math.round(o.heading);
                    }
                }
                break;

            case 'hotspot':
                console.log('[v360] hotspot click:', d.data);
                break;

            case 'cardclosed':
                console.log('[v360] card closed');
                break;
        }
    });

    // ===== Autorotate cone sync =====
    // Kuula khong fire orientation event deu trong luc autorotate -> simulate local de cone tren minimap
    // van xoay theo. Kuula autorotate value 3 ≈ 3 RPM (~18°/s); tune AUTOROT_DEG_PER_SEC neu thay drift.
    var AUTOROT_DEG_PER_SEC = 18;
    function startAutoRotSim() {
        if (autorotTimer) return;
        var lastTick = (window.performance && performance.now) ? performance.now() : Date.now();
        autorotTimer = setInterval(function () {
            var now = (window.performance && performance.now) ? performance.now() : Date.now();
            var dt = (now - lastTick) / 1000;
            lastTick = now;
            lastHeading = (lastHeading + AUTOROT_DEG_PER_SEC * dt + 360) % 360;
            applyConeRotation();
        }, 50);
    }
    function stopAutoRotSim() {
        if (autorotTimer) { clearInterval(autorotTimer); autorotTimer = null; }
    }
    // Console helper: bat/tat autorotate
    window.v360AutoRotate = function (on, speed) {
        autorotateOn = !!on;
        if (typeof speed === 'number') AUTOROT_DEG_PER_SEC = speed;
        kuulaSend('autorotate', { value: autorotateOn ? 3 : 0 });
        if (autorotateOn) startAutoRotSim(); else stopAutoRotSim();
        console.log('[v360] AutoRotate ' + (autorotateOn ? 'ON @@ ' + AUTOROT_DEG_PER_SEC + '°/s' : 'OFF'));
    };

    // Shim KuulaPlayerAPI cho cac caller noi bo
    window.KuulaPlayerAPI = {
        load: function (frame, postId) { kuulaSend('load', { id: postId }); },
        setHeading: function (frame, v) { kuulaSend('heading', { value: v }); },
        setPitch: function (frame, v) { kuulaSend('pitch', { value: v }); },
        setZoom: function (frame, v) { kuulaSend('zoom', { value: v }); },
        setAutoRotate: function (frame, v) { kuulaSend('autorotate', { value: v }); },
        hotspotClick: function (frame, uid) { kuulaSend('hotspotclick', { uid: uid }); },
        closeCard: function (frame) { kuulaSend('closecard'); }
    };

    // Safety: phat hien Kuula iframe load HTTP 200 nhung khong fire 'frameloaded' (Kuula app bi
    // ket - co the do mang cham, viewport ki la, race condition...). Auto-retry 1 lan, neu van
    // fail -> hien nut "Tai lai" cho user thu thu cong.
    var iframeRetried = false;
    var reloadBtn = document.getElementById('v360-loading-reload');
    function reloadIframe() {
        if (!iframe) return;
        console.log('[v360] reload iframe...');
        if (reloadBtn) reloadBtn.style.display = 'none';
        if (loading) loading.classList.remove('is-hidden');
        var src = iframe.src;
        iframe.src = 'about:blank';
        window.__v360FrameloadedFired = false;
        setTimeout(function () { iframe.src = src; }, 150);
    }
    if (reloadBtn) reloadBtn.addEventListener('click', reloadIframe);

    setTimeout(function () {
        if (window.__v360FrameloadedFired) return;
        if (!iframeRetried) {
            iframeRetried = true;
            console.warn('[v360] frameloaded khong fire sau 8s - auto retry');
            reloadIframe();
            // Sau retry, doi them 10s, neu van khong fire -> hien nut manual reload
            setTimeout(function () {
                if (window.__v360FrameloadedFired) return;
                console.error('[v360] frameloaded VAN khong fire sau retry - hien nut manual reload');
                if (loading) {
                    loading.classList.remove('is-hidden');
                    var sub = loading.querySelector('.v360-loading__sub');
                    if (sub) sub.textContent = 'Tour 360° không tải được. Hãy thử tải lại.';
                }
                if (reloadBtn) reloadBtn.style.display = 'inline-flex';
            }, 10000);
        } else {
            if (loading) loading.classList.add('is-hidden');
        }
    }, 8000);
    </text>
}
else
{
    <text>
    iframe.addEventListener('load', function () { if (loading) loading.classList.add('is-hidden'); });
    </text>
}

@* Chatbot widget: expose state cho view360-chatbot.js (mount o duoi). Chi enable khi admin bat. *@
