    var lastHeading = 0;
    var currentDeg   = 0;   // rotation luy ke - unwrap khi wrap qua bien 0/360 de transition di duong ngan

    function getHeadingOffset() {
        if (currentPostKey && (currentPostKey in SCENE_HEADING_OFFSET)) {
            return SCENE_HEADING_OFFSET[currentPostKey];
        }
        return HEADING_OFFSET;
    }
    function logCalibration() {
        console.log('[v360] === CALIBRATION DATA ===\n'
            + 'SCENE_HEADING_OFFSET = ' + JSON.stringify(SCENE_HEADING_OFFSET, null, 2));
    }

    function shortestDelta(target, current) {
        // Tra ve delta trong [-180, 180] de transition luon di duong ngan
        return ((target - current) % 360 + 540) % 360 - 180;
    }

    function applyConeRotation() {
        if (!coneEl) return;
        var target = (HEADING_INVERT ? -lastHeading : lastHeading) + getHeadingOffset();
        currentDeg += shortestDelta(target, currentDeg);
        coneEl.style.transform = 'rotate(' + currentDeg + 'deg)';
    }
    function snapConeRotation() {
        if (!coneEl) return;
        var target = (HEADING_INVERT ? -lastHeading : lastHeading) + getHeadingOffset();
        currentDeg = target;
        coneEl.style.transition = 'none';
        coneEl.style.transform = 'rotate(' + currentDeg + 'deg)';
        void coneEl.offsetHeight;
        coneEl.style.transition = '';
    }

    var iframe        = document.getElementById('v360-iframe');
    var loading       = document.getElementById('v360-loading');
    var minimap       = document.getElementById('v360-minimap');
    @if (!_isAdmin)
    {
        <text>
    // Admin tat minimap cho tour -> an voi NGUOI XEM (admin van thay de cau hinh huong).
    if (minimap && TOUR_CONFIG && TOUR_CONFIG.ShowMinimap === false) minimap.style.display = 'none';
        </text>
