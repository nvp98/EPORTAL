<script>
(function () {
    // ====== SCENE_GPS: postId -> [lat, lng] tu Kuula share page (server-side fetch, cached 24h) ======
    // Khong can calibrate - data tu window.KUULA_COLLECTION.data trong HTML cua kuula.co
    // Backend: EPORTAL.Common.KuulaCollectionFetcher
    var SCENE_GPS = @Html.Raw(ViewBag.SceneGpsJson ?? "{}");
    console.log('[v360] SCENE_GPS loaded from server: ' + Object.keys(SCENE_GPS).length + ' scenes có GPS');

    // Shift+click vao Leaflet van work nhu calibration override (neu Kuula data sai).

    // KLH HPDQ bounds (lay tu Google Maps API trong iframe Kuula)
    var MAP_BOUNDS_SW = [15.239008, 108.609660];
    var MAP_BOUNDS_NE = [15.530438, 108.976299];
    var MAP_CENTER    = [(MAP_BOUNDS_SW[0] + MAP_BOUNDS_NE[0]) / 2,
                         (MAP_BOUNDS_SW[1] + MAP_BOUNDS_NE[1]) / 2];

    // Hieu chinh huong cua cone (Kuula heading != huong bac thuc te)
    // HEADING_INVERT=false: pan-trai (Kuula heading giam) => cone xoay counter-clockwise (trai) - dung sense.
    var HEADING_OFFSET = 0;
    var HEADING_INVERT = false;

    // Per-scene calibration:
    //   - SCENE_HEADING_OFFSET[postId] = offset deg
    //   - SCENE_HEADING_INVERT[postId] = bool dao chieu xoay
    // Auto-calibrated server-side tu hotspot bearings (KuulaCollectionFetcher) khi co du data;
    // manual override: nut flip header + Alt+wheel.
    var SCENE_HEADING_OFFSET = @Html.Raw(ViewBag.SceneHeadingOffsetJson ?? "{}");
    var SCENE_CALIB_DIAG     = @Html.Raw(ViewBag.SceneCalibDiagJson ?? "{}");
    // Admin mode: data DB-saved (uuid -> { Offset, Invert, HideCone }) + collection id
    var ADMIN_MODE      = @(((bool?)ViewBag.AdminMode == true) ? "true" : "false");
    var FEATURED_ADMIN_MODE = @(((bool?)ViewBag.FeaturedAdminMode == true) ? "true" : "false");
    var CHATBOT_ADMIN_MODE = @(((bool?)ViewBag.ChatbotAdminMode == true) ? "true" : "false");
    var CHATBOT_SCENE_INFO = @Html.Raw(ViewBag.ChatbotSceneInfoJson ?? "{}");
    var COLLECTION_ID   = '@(ViewBag.CollectionId ?? "")';
    var SCENE_DB_CALIB  = @Html.Raw(ViewBag.SceneDbCalibJson ?? "{}");
    var SCENE_HIDE_PIN  = @Html.Raw(ViewBag.SceneHidePinJson ?? "{}");
    var SCENE_CUSTOM_TITLE = @Html.Raw(ViewBag.SceneCustomTitleJson ?? "{}");
    var TOUR_CONFIG     = @Html.Raw(ViewBag.TourConfigJson ?? "{}");
    var FEATURED_LIST   = @Html.Raw(ViewBag.FeaturedListJson ?? "[]");
    // Pending scene uuid de jump sau khi iframe ban 'frameloaded' (tu ?scene=<uuid> trong URL,
    // thuong la Intro card click). One-shot - clear sau khi dispatch.
    // PENDING_GO_SCENE giu nguyen tu URL. JS deep-link code se check "alreadyThere":
    //   - Iframe da load dung scene (server resolve shortId thanh cong) -> no-op
    //   - Iframe load default scene (server khong resolve duoc) -> fallback postMessage switch
    var PENDING_GO_SCENE = @Html.Raw(EPORTAL.Common.JsonForHtml.Serialize(ViewBag.SceneHash ?? ""));

    // Apply tour visual config (CSS vars) - mau, kich thuoc pin/cone
    function hexToRgba(hex, alpha) {
        if (!hex) return null;
        hex = hex.replace('#', '');
        if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
        var r = parseInt(hex.slice(0,2),16), g = parseInt(hex.slice(2,4),16), b = parseInt(hex.slice(4,6),16);
        return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
    }
    function applyTourConfig(cfg) {
        var root = document.documentElement;
        if (!cfg) cfg = {};
        if (cfg.PinSize) root.style.setProperty('--v360-pin-size', cfg.PinSize + 'px');
        if (cfg.PinColor) root.style.setProperty('--v360-pin-color', cfg.PinColor);
        if (cfg.SelectedColor) root.style.setProperty('--v360-selected-color', cfg.SelectedColor);
        if (cfg.ConeColor) {
            root.style.setProperty('--v360-cone-color', cfg.ConeColor);
            root.style.setProperty('--v360-cone-gradient',
                'linear-gradient(to bottom, ' + hexToRgba(cfg.ConeColor, 0.85) + ' 0%, '
                + hexToRgba(cfg.ConeColor, 0.05) + ' 100%)');
            root.style.setProperty('--v360-cone-shadow', hexToRgba(cfg.ConeColor, 0.55));
        }
        // Cone geometry: width = 2*radius*tan(fanDeg/2), height = radius
        var fan = cfg.ConeFanDeg || 60, r = cfg.ConeRadius || 40;
        var w = 2 * r * Math.tan(fan * Math.PI / 360);
        root.style.setProperty('--v360-cone-w', w + 'px');
        root.style.setProperty('--v360-cone-h', r + 'px');
        root.style.setProperty('--v360-cone-half-w', (-w/2) + 'px');
    }
    applyTourConfig(TOUR_CONFIG);
    console.log('[v360] AUTO calibration: '
        + Object.keys(SCENE_HEADING_OFFSET).length + ' offsets loaded (tu DB + auto)');

    // Diagnostic helper - go vao console de dump samples cua scene hien tai
    window.v360Diag = function (postKey) {
        var id = postKey || currentPostKey;
        if (!id) { console.warn('[v360] Chua co scene de diag'); return; }
        var diag = SCENE_CALIB_DIAG[id];
        if (!diag) {
            console.log('[v360] DIAG ' + id + ': KHONG co data (0 hotspot voi GPS) - dung default global');
            return;
        }
        console.log('[v360] DIAG ' + id + ':\n'
            + '  samples = ' + diag.SampleCount + '\n'
            + '  sense   = ' + diag.Sense + (diag.Sense === -1 ? ' (INVERTED)' : ' (normal)') + '\n'
            + '  offset  = ' + diag.Offset + '°\n'
            + '  current_offset=' + (id in SCENE_HEADING_OFFSET ? SCENE_HEADING_OFFSET[id] : '(default)') + '\n'
            + '  lastHeading=' + lastHeading.toFixed(1) + ', currentDeg=' + currentDeg.toFixed(1));
        console.table(diag.Samples.map(function (s, i) {
            // expected_bearing tu cone: sense * yaw + c (where c = offset + 180)
            var c = diag.Offset + 180;
            var predicted = ((diag.Sense * s.Yaw + c) % 360 + 360) % 360;
            return {
                idx: i,
                target: s.TargetId,
                yaw_kuula: s.Yaw,
                bearing_real: s.Bearing,
                predicted_by_fit: Math.round(predicted * 10) / 10,
                residual: Math.round(shortestDelta(s.Bearing, predicted) * 10) / 10
            };
        }));
    };
    console.log('[v360] DIAGNOSTIC: go `v360Diag()` trong console de xem samples + residual cua scene hien tai');

    // ============================================================
    //  ADMIN PANEL - cau hinh offset/invert/hideCone, save vao DB
    // ============================================================
    if (ADMIN_MODE) {
        var aSceneName  = document.getElementById('v360-admin-scene-name');
        var aSceneUuid  = document.getElementById('v360-admin-scene-uuid');
        var aOffset     = document.getElementById('v360-admin-offset');
        var aHidePin    = document.getElementById('v360-admin-hidepin');
        var aTitle      = document.getElementById('v360-admin-title');
        var aAuto       = document.getElementById('v360-admin-auto-offset');
        var aSaved      = document.getElementById('v360-admin-saved');
        var aMsg        = document.getElementById('v360-admin-msg');
        var aBtnSave    = document.getElementById('v360-admin-save');
        var aBtnReset   = document.getElementById('v360-admin-reset');
        var aDeltaBtns  = document.querySelectorAll('[data-delta]');
        var autoOffsetCache = {};
        for (var k in SCENE_HEADING_OFFSET) autoOffsetCache[k] = SCENE_HEADING_OFFSET[k];

        function adminUpdateSavedCount() {
            aSaved.textContent = Object.keys(SCENE_DB_CALIB).length;
        }
        adminUpdateSavedCount();

        function adminSetMsg(text, color) {
            aMsg.textContent = text || '';
            aMsg.style.color = color || '';
            if (text) setTimeout(function () { aMsg.textContent = ''; }, 3000);
        }

        window.__adminOnSceneChange = function () {
            if (!currentPostKey) return;
            // Get post object de show title goc
            var post = null;
            for (var i = 0; i < allPosts.length; i++) {
                if (postKey(allPosts[i]) === currentPostKey) { post = allPosts[i]; break; }
            }
            aSceneName.textContent = (post && post.title) || '(no title)';
            aSceneUuid.textContent = currentPostKey;
            var curOffset = (currentPostKey in SCENE_HEADING_OFFSET) ? SCENE_HEADING_OFFSET[currentPostKey] : 0;
            aOffset.value = curOffset.toFixed(1);
            aHidePin.checked = !!SCENE_HIDE_PIN[currentPostKey];
            aTitle.value     = SCENE_CUSTOM_TITLE[currentPostKey] || '';
            aAuto.textContent = (autoOffsetCache[currentPostKey] !== undefined)
                ? autoOffsetCache[currentPostKey].toFixed(1) : '—';
        };

        function adminApplyAndRedraw() {
            var off = parseFloat(aOffset.value);
            if (!isFinite(off)) off = 0;
            SCENE_HEADING_OFFSET[currentPostKey] = off;
            if (aHidePin.checked) SCENE_HIDE_PIN[currentPostKey] = true;
            else delete SCENE_HIDE_PIN[currentPostKey];
            if (aTitle.value.trim()) SCENE_CUSTOM_TITLE[currentPostKey] = aTitle.value.trim();
            else delete SCENE_CUSTOM_TITLE[currentPostKey];
            moveCurrentMarker(currentPostKey);
            renderScenePins();
        }

        aDeltaBtns.forEach(function (b) {
            b.addEventListener('click', function () {
                var d = parseFloat(b.getAttribute('data-delta')) || 0;
                aOffset.value = (parseFloat(aOffset.value) + d).toFixed(1);
                adminApplyAndRedraw();
            });
        });
        aOffset.addEventListener('input', adminApplyAndRedraw);
        aHidePin.addEventListener('change', adminApplyAndRedraw);
        aTitle.addEventListener('input', adminApplyAndRedraw);

        function adminPost(url, payload, onOk, msgEl) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var fd = new FormData();
            for (var k in payload) {
                if (payload[k] !== null && payload[k] !== undefined) fd.append(k, payload[k]);
            }
            if (token) fd.append('__RequestVerificationToken', token.value);
            return fetch(url, { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(function (r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(function (j) {
                    var target = msgEl || aMsg;
                    if (j && j.ok) { onOk && onOk(); }
                    else {
                        target.style.color = '#ff8888';
                        target.textContent = 'Lỗi lưu: ' + ((j && j.error) || 'unknown');
                        console.error('[v360] Save failed:', j);
                    }
                })
                .catch(function (e) {
                    var target = msgEl || aMsg;
                    target.style.color = '#ff8888';
                    target.textContent = 'Network/Server error: ' + e.message;
                    console.error('[v360] Save network err:', e);
                });
        }

        aBtnSave.addEventListener('click', function () {
            if (!currentPostKey) { adminSetMsg('Chưa chọn scene', '#ffaa55'); return; }
            var off = parseFloat(aOffset.value); if (!isFinite(off)) off = 0;
            var ct = aTitle.value.trim();
            adminPost('@Url.Action("SaveCalibration", "ListVirtual", new { area = "View360" })', {
                collectionId: COLLECTION_ID,
                uuid: currentPostKey,
                offset: off,
                hidePin: aHidePin.checked,
                customTitle: ct
            }, function () {
                SCENE_DB_CALIB[currentPostKey] = {
                    Offset: off, HidePin: aHidePin.checked, CustomTitle: ct
                };
                adminUpdateSavedCount();
                adminSetMsg('Đã lưu ✓', '#5fdc7c');
            });
        });

        aBtnReset.addEventListener('click', function () {
            if (!currentPostKey) return;
            adminPost('@Url.Action("SaveCalibration", "ListVirtual", new { area = "View360" })', {
                collectionId: COLLECTION_ID, uuid: currentPostKey,
                offset: '', hidePin: false, customTitle: ''
            }, function () {
                delete SCENE_DB_CALIB[currentPostKey];
                if (autoOffsetCache[currentPostKey] !== undefined) {
                    SCENE_HEADING_OFFSET[currentPostKey] = autoOffsetCache[currentPostKey];
                } else { delete SCENE_HEADING_OFFSET[currentPostKey]; }
                delete SCENE_HIDE_PIN[currentPostKey];
                delete SCENE_CUSTOM_TITLE[currentPostKey];
                moveCurrentMarker(currentPostKey);
                renderScenePins();
                window.__adminOnSceneChange();
                adminUpdateSavedCount();
                adminSetMsg('Đã reset về auto', '#5fdc7c');
            });
        });

        // === Global tour config (visual) ===
        var cfgPinSize   = document.getElementById('v360-cfg-pinsize');
        var cfgPinColor  = document.getElementById('v360-cfg-pincolor');
        var cfgSelColor  = document.getElementById('v360-cfg-selcolor');
        var cfgConeColor = document.getElementById('v360-cfg-conecolor');
        var cfgFan       = document.getElementById('v360-cfg-fan');
        var cfgFanVal    = document.getElementById('v360-cfg-fan-val');
        var cfgRadius    = document.getElementById('v360-cfg-radius');
        var cfgRadiusVal = document.getElementById('v360-cfg-radius-val');
        var cfgMinimap   = document.getElementById('v360-cfg-minimap');
        var cfgBtnSave   = document.getElementById('v360-cfg-save');
        var cfgBtnReset  = document.getElementById('v360-cfg-reset');
        var cfgMsg       = document.getElementById('v360-cfg-msg');
        var CFG_DEFAULTS = { PinSize: 11, PinColor: '#f5b400', SelectedColor: '#2cc1e8',
            ConeColor: '#2cc1e8', ConeFanDeg: 60, ConeRadius: 40 };

        function cfgPopulate(c) {
            c = c || {};
            cfgPinSize.value   = c.PinSize       || CFG_DEFAULTS.PinSize;
            cfgPinColor.value  = c.PinColor      || CFG_DEFAULTS.PinColor;
            cfgSelColor.value  = c.SelectedColor || CFG_DEFAULTS.SelectedColor;
            cfgConeColor.value = c.ConeColor     || CFG_DEFAULTS.ConeColor;
            cfgFan.value       = c.ConeFanDeg    || CFG_DEFAULTS.ConeFanDeg;
            cfgRadius.value    = c.ConeRadius    || CFG_DEFAULTS.ConeRadius;
            if (cfgMinimap) cfgMinimap.checked = (c.ShowMinimap !== false);   // default = hien
            cfgFanVal.textContent    = cfgFan.value;
            cfgRadiusVal.textContent = cfgRadius.value;
        }
        cfgPopulate(TOUR_CONFIG);

        function cfgCurrent() {
            return {
                PinSize: parseInt(cfgPinSize.value, 10) || CFG_DEFAULTS.PinSize,
                PinColor: cfgPinColor.value,
                SelectedColor: cfgSelColor.value,
                ConeColor: cfgConeColor.value,
                ConeFanDeg: parseFloat(cfgFan.value),
                ConeRadius: parseInt(cfgRadius.value, 10),
                ShowMinimap: cfgMinimap ? cfgMinimap.checked : true
            };
        }
        function cfgApplyLive() {
            cfgFanVal.textContent = cfgFan.value;
            cfgRadiusVal.textContent = cfgRadius.value;
            var c = cfgCurrent();
            TOUR_CONFIG = c;
            applyTourConfig(c);
            renderScenePins();   // pin size co the doi
            if (currentPostKey) moveCurrentMarker(currentPostKey);
        }
        [cfgPinSize, cfgPinColor, cfgSelColor, cfgConeColor, cfgFan, cfgRadius].forEach(function (el) {
            el.addEventListener('input', cfgApplyLive);
        });
        if (cfgMinimap) cfgMinimap.addEventListener('change', function () { TOUR_CONFIG = cfgCurrent(); });
        cfgBtnSave.addEventListener('click', function () {
            var c = cfgCurrent();
            adminPost('@Url.Action("SaveTourConfig", "ListVirtual", new { area = "View360" })', {
                collectionId: COLLECTION_ID,
                pinSize: c.PinSize, pinColor: c.PinColor, selectedColor: c.SelectedColor,
                coneColor: c.ConeColor, coneFanDeg: c.ConeFanDeg, coneRadius: c.ConeRadius,
                showMinimap: c.ShowMinimap
            }, function () { cfgMsg.style.color = '#5fdc7c'; cfgMsg.textContent = 'Đã lưu ✓'; setTimeout(function() { cfgMsg.textContent = ''; }, 2500); }, cfgMsg);
        });
        cfgBtnReset.addEventListener('click', function () {
            adminPost('@Url.Action("SaveTourConfig", "ListVirtual", new { area = "View360" })', {
                collectionId: COLLECTION_ID,
                pinSize: '', pinColor: '', selectedColor: '',
                coneColor: '', coneFanDeg: '', coneRadius: ''
            }, function () {
                TOUR_CONFIG = {};
                cfgPopulate({});
                applyTourConfig({});
                renderScenePins();
                if (currentPostKey) moveCurrentMarker(currentPostKey);
                cfgMsg.style.color = '#5fdc7c'; cfgMsg.textContent = 'Đã reset';
                setTimeout(function() { cfgMsg.textContent = ''; }, 2500);
            }, cfgMsg);
        });

        console.log('[v360] ADMIN MODE ON - panel cau hinh hien thi');
    }

    // ============================================================
    //  FEATURED ADMIN PANEL - cau hinh khu vuc tham quan chinh
    // ============================================================
    if (FEATURED_ADMIN_MODE) {
        var fSceneName  = document.getElementById('v360-feat-scene-name');
        var fSceneUuid  = document.getElementById('v360-feat-scene-uuid');
        var fTitle      = document.getElementById('v360-feat-title');
        var fImgInput   = document.getElementById('v360-feat-img-input');
        var fImgPrev    = document.getElementById('v360-feat-img-preview');
        var fImgStat    = document.getElementById('v360-feat-img-status');
        var fToggle     = document.getElementById('v360-feat-toggle');
        var fToggleText = document.getElementById('v360-feat-toggle-text');
        var fStatusPill = document.getElementById('v360-feat-status-pill');
        var fMsg        = document.getElementById('v360-feat-msg');
        var fListEl     = document.getElementById('v360-feat-list');
        var fCount      = document.getElementById('v360-feat-count');
        var fTotal      = document.getElementById('v360-feat-total');
        var fBtnSave    = document.getElementById('v360-feat-save-all');

        // State: copy cua server-side featured list. Tat ca thao tac modify state, save commit toan bo.
        var featState = (FEATURED_LIST || []).map(function (f) {
            return {
                SceneUuid: f.SceneUuid,
                HasImage: !!f.HasImage,
                ImageUrl: f.ImageUrl || ''
            };
        });

        function setMsg(text, color) {
            fMsg.textContent = text || '';
            fMsg.style.color = color || '';
            if (text) setTimeout(function () { fMsg.textContent = ''; }, 3000);
        }
        function findIdx(uuid) {
            for (var i = 0; i < featState.length; i++)
                if (featState[i].SceneUuid === uuid) return i;
            return -1;
        }
        function getSceneTitle(uuid) {
            // Reuse calibration title resolver - priority: DB CustomTitle -> Kuula post.title
            if (uuid in SCENE_CUSTOM_TITLE && SCENE_CUSTOM_TITLE[uuid]) return SCENE_CUSTOM_TITLE[uuid];
            // Kuula scene metadata not directly available here - fall back to "Khu vuc"
            // (calibration store always has titles for featured scenes since admin sets them)
            return '';
        }

        function escHtml(s) { return String(s || '').replace(/[<>&"]/g, function (c) {
            return { '<':'&lt;', '>':'&gt;', '&':'&amp;', '"':'&quot;' }[c];
        }); }
        function renderList() {
            fCount.textContent = featState.length;
            if (fTotal) fTotal.textContent = Object.keys(SCENE_GPS).length;
            if (featState.length === 0) {
                fListEl.innerHTML = '<div class="v360-feat-list__empty">Chưa có khu vực nào.<br/>Bấm "Thêm vào danh sách".</div>';
                return;
            }
            var html = '';
            featState.forEach(function (it, idx) {
                var title = getSceneTitle(it.SceneUuid) || '(chưa có tên)';
                var img = it.ImageUrl || '';
                var isCurrent = (currentPostKey === it.SceneUuid);
                html +=
                    '<div class="v360-feat-list__item' + (isCurrent ? ' is-current' : '') + '" data-idx="' + idx + '" title="' + escHtml(it.SceneUuid) + '">' +
                        '<div class="v360-feat-list__num">' + String(idx + 1).padStart(2, '0') + '</div>' +
                        '<div class="v360-feat-list__thumb">' +
                            (img ? '<img src="' + img + '" alt="" />' : '<i class="fa fa-image"></i>') +
                        '</div>' +
                        '<div class="v360-feat-list__title">' + escHtml(title) + '</div>' +
                        '<div class="v360-feat-list__ctrl">' +
                            '<button type="button" data-act="up"   title="Lên" ' + (idx === 0 ? 'disabled' : '') + '><i class="fa fa-chevron-up"></i></button>' +
                            '<button type="button" data-act="down" title="Xuống" ' + (idx === featState.length - 1 ? 'disabled' : '') + '><i class="fa fa-chevron-down"></i></button>' +
                            '<button type="button" data-act="del"  title="Xóa khỏi danh sách"><i class="fa fa-times"></i></button>' +
                        '</div>' +
                    '</div>';
            });
            fListEl.innerHTML = html;
        }

        function setImgPreview(imgUrl) {
            // Lay div empty + overlay co san; chi inject/remove <img> de tranh re-render layout
            var existingImg = fImgPrev.querySelector('img.v360-feat-img__photo');
            if (imgUrl) {
                if (existingImg) {
                    existingImg.src = imgUrl;
                } else {
                    var img = document.createElement('img');
                    img.className = 'v360-feat-img__photo';
                    img.alt = '';
                    img.src = imgUrl;
                    fImgPrev.insertBefore(img, fImgPrev.firstChild);
                }
                fImgPrev.classList.add('has-image');
            } else {
                if (existingImg) existingImg.remove();
                fImgPrev.classList.remove('has-image');
            }
        }
        function refreshCurrentScenePanel() {
            if (!currentPostKey) {
                fSceneName.textContent = '— chưa chọn scene —';
                fSceneUuid.textContent = '—';
                fTitle.value = '';
                setImgPreview('');
                fImgStat.textContent = '';
                fToggle.disabled = true;
                fStatusPill.textContent = 'Chưa chọn';
                fStatusPill.setAttribute('data-state', 'none');
                fToggleText.textContent = 'Thêm vào danh sách';
                fToggle.classList.remove('v360-admin__danger');
                fToggle.classList.add('v360-admin__primary');
                return;
            }
            fToggle.disabled = false;
            fSceneUuid.textContent = currentPostKey;
            fTitle.value = SCENE_CUSTOM_TITLE[currentPostKey] || '';
            var displayName = SCENE_CUSTOM_TITLE[currentPostKey] || '(chưa đặt tên)';
            fSceneName.textContent = displayName;

            var idx = findIdx(currentPostKey);
            if (idx >= 0) {
                fStatusPill.textContent = 'Đã thêm';
                fStatusPill.setAttribute('data-state', 'added');
                fToggleText.textContent = 'Xóa khỏi danh sách';
                fToggle.querySelector('i').className = 'fa fa-times';
                fToggle.classList.remove('v360-admin__primary');
                fToggle.classList.add('v360-admin__danger');
                var img = featState[idx].ImageUrl || '';
                setImgPreview(img);
                fImgStat.textContent = featState[idx].HasImage ? 'Đã có ảnh — bấm để đổi' : 'Bấm vào khung trên để chọn ảnh';
                fImgPrev.style.pointerEvents = '';
                fImgPrev.style.opacity = '';
            } else {
                fStatusPill.textContent = 'Chưa thêm';
                fStatusPill.setAttribute('data-state', 'none');
                fToggleText.textContent = 'Thêm vào danh sách';
                fToggle.querySelector('i').className = 'fa fa-plus';
                fToggle.classList.add('v360-admin__primary');
                fToggle.classList.remove('v360-admin__danger');
                setImgPreview('');
                fImgStat.textContent = 'Thêm điểm vào danh sách trước, sau đó upload ảnh';
                fImgPrev.style.pointerEvents = 'none';
                fImgPrev.style.opacity = '0.5';
            }
            renderList();
        }
        window.__featOnSceneChange = refreshCurrentScenePanel;

        // Toggle add/remove
        fToggle.addEventListener('click', function () {
            if (!currentPostKey) return;
            var idx = findIdx(currentPostKey);
            if (idx >= 0) { featState.splice(idx, 1); }
            else          { featState.push({ SceneUuid: currentPostKey, HasImage: false, ImageUrl: '' }); }
            refreshCurrentScenePanel();
        });

        // Title input -> save to V360_SceneCalibration.CustomTitle (single source of truth)
        var titleSaveTimer = null;
        fTitle.addEventListener('input', function () {
            if (!currentPostKey) return;
            var newTitle = fTitle.value;
            if (titleSaveTimer) clearTimeout(titleSaveTimer);
            titleSaveTimer = setTimeout(function () {
                var fd = new FormData();
                fd.append('collectionId', COLLECTION_ID);
                fd.append('uuid', currentPostKey);
                fd.append('customTitle', newTitle);
                // Preserve existing calibration values - offset + hidePin
                var existing = SCENE_DB_CALIB[currentPostKey] || {};
                if (existing.Offset != null) fd.append('offset', existing.Offset);
                fd.append('hidePin', existing.HidePin ? 'true' : 'false');
                fd.append('__RequestVerificationToken', document.querySelector('input[name=__RequestVerificationToken]').value);
                fetch('@Url.Action("SaveCalibration", "ListVirtual", new { area = "View360" })',
                      { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (j) {
                        if (j.ok) {
                            SCENE_CUSTOM_TITLE[currentPostKey] = newTitle || '';
                            if (newTitle) { SCENE_DB_CALIB[currentPostKey] = SCENE_DB_CALIB[currentPostKey] || {}; SCENE_DB_CALIB[currentPostKey].CustomTitle = newTitle; }
                            fSceneName.textContent = newTitle || '(chưa có tên — dùng Kuula default)';
                            renderList();
                            // Cap nhat tooltip pin tren minimap
                            if (typeof window.__refreshPinTooltip === 'function')
                                window.__refreshPinTooltip(currentPostKey);
                            setMsg('Đã lưu tên', '#5fdc7c');
                        } else {
                            setMsg('Lưu tên lỗi: ' + (j.error || ''), '#ff8a80');
                        }
                    })
                    .catch(function (e) { setMsg('Lỗi: ' + e.message, '#ff8a80'); });
            }, 600);
        });

        // Image upload
        fImgInput.addEventListener('change', function () {
            if (!currentPostKey) return;
            var idx = findIdx(currentPostKey);
            if (idx < 0) { setMsg('Thêm vào danh sách trước khi upload ảnh', '#ff8a80'); fImgInput.value = ''; return; }
            var file = fImgInput.files && fImgInput.files[0];
            if (!file) return;
            fImgStat.textContent = 'Đang upload...';
            var fd = new FormData();
            fd.append('collectionId', COLLECTION_ID);
            fd.append('sceneUuid', currentPostKey);
            fd.append('file', file);
            fd.append('__RequestVerificationToken', document.querySelector('input[name=__RequestVerificationToken]').value);
            fetch('@Url.Action("UploadFeaturedImage", "ListVirtual", new { area = "View360" })',
                  { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (j) {
                    if (j.ok) {
                        featState[idx].HasImage = true;
                        featState[idx].ImageUrl = j.url;
                        setImgPreview(j.url);
