    // ===== Calibrate heading offset: Alt+wheel (capture phase de an truoc Leaflet zoom) =====
    minimap.addEventListener('wheel', function (e) {
        if (!e.altKey) return;
        if (!currentPostKey) { console.warn('[v360] Chua co scene de calibrate'); return; }
        e.preventDefault();
        e.stopPropagation();
        var cur = SCENE_HEADING_OFFSET[currentPostKey] || 0;
        var step = e.shiftKey ? 1 : 5;
        var delta = e.deltaY > 0 ? -step : step;
        SCENE_HEADING_OFFSET[currentPostKey] = cur + delta;
        applyConeRotation();
        console.log('[v360] OFFSET[' + currentPostKey + '] = ' + SCENE_HEADING_OFFSET[currentPostKey] + '°');
