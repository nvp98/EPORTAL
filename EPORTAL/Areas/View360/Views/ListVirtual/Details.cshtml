            if (act) {
                var a = act.dataset.act;
                if (a === 'del') { featState.splice(idx, 1); refreshCurrentScenePanel(); }
                else if (a === 'up' && idx > 0) { var t = featState[idx-1]; featState[idx-1] = featState[idx]; featState[idx] = t; refreshCurrentScenePanel(); }
                else if (a === 'down' && idx < featState.length - 1) { var t2 = featState[idx+1]; featState[idx+1] = featState[idx]; featState[idx] = t2; refreshCurrentScenePanel(); }
                return;
            }
            // Click vao item body (khong phai button) -> jump iframe sang scene do.
            // Reverse lookup: tim post.id co idToUuid[postId] === uuid.
            var uuid = featState[idx] && featState[idx].SceneUuid;
            if (!uuid) return;
            var target = String(uuid).toLowerCase();
            var targetId = null;
            for (var pid in idToUuid) {
                if (String(idToUuid[pid] || '').toLowerCase() === target) { targetId = pid; break; }
