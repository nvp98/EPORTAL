@model List<EPORTAL.ModelsView360.VirtualValidation>
@{
    ViewBag.Title = "Cấu hình hướng 360°";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var savedCounts = ViewBag.SavedCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<link href="~/Content/view360-modern.css" rel="stylesheet" />

<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="v360-list-wrap">
            <div class="v360-list-header">
                <div class="v360-list-title">
                    <h1><i class="fa-solid fa-compass" style="color: var(--v360-accent);"></i> Cấu hình hướng 360°</h1>
                    <p>Chọn tour để cấu hình hướng nhìn (heading) chính xác cho từng điểm trên minimap.</p>
                </div>
            </div>

            @if (Model.Count == 0)
            {
                <div class="v360-empty">
                    <i class="fa fa-inbox"></i>
                    <h3>Không có tour nào</h3>
                    <p>Tạo tour Virtual 360° trước khi cấu hình hướng.</p>
                </div>
            }
            else
            {
                <div class="v360-grid">
                    @foreach (var t in Model)
                    {
                        var saved = savedCounts.ContainsKey(t.ID) ? savedCounts[t.ID] : 0;
                        var img = string.IsNullOrEmpty(t.Images)
                            ? Url.Content("~/Content/assets/images/bg9.jpg")
                            : Url.Content("~/Images/" + System.IO.Path.GetFileName(t.Images));
                        <a class="v360-card" href="@Url.Action("Calibrate", "ListVirtual", new { area = "View360", id = t.ID })">
                            <div class="v360-card__media">
                                <img src="@img" alt="@t.Title" />
                                <div class="v360-card__badge">
                                    <i class="fa-solid fa-compass"></i> @saved scene đã lưu
                                </div>
                                <div class="v360-card__overlay">
                                    <span class="v360-card__overlay-action">
                                        <i class="fa fa-edit"></i> Cấu hình hướng
                                    </span>
                                </div>
                            </div>
                            <div class="v360-card__body">
                                <h3 class="v360-card__title">@t.Title</h3>
                                <div class="v360-card__meta">
                                    <span><i class="fa fa-calendar"></i> @t.Date.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
