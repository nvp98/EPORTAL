    // Self-check truoc khi tai widget: bao truoc neu migration chua chay,
    // thay vi de tung widget loi 500 mot cach mo ho.
    function runDiagnostic() {
        return safeFetch(base + 'Diagnostic')
            .then(function (d) {
                var $diag = document.getElementById('v360db-diag');
                if (!d.accessLogExists) {
                    $diag.style.display = 'block';
                    $diag.innerHTML = '<div class="v360db-warn">' +
                        '<strong>⚠ Migration chưa chạy.</strong> ' +
                        'Bảng <code>View360_AccessLog</code> chưa tồn tại. ' +
                        'Hãy chạy file <code>App_Data/migrations/v360-all.sql</code> trên DB EPORTAL. ' +
                        'Các widget liên quan lượt xem sẽ trống cho đến khi có tracking data.</div>';
                }
                // Cảnh báo phụ: NhanVien chưa có IDPhongBan -> chart dept rỗng
                if (d.nhanVienWithDept != null && d.nhanVienCount != null
                    && d.nhanVienCount > 0 && d.nhanVienWithDept === 0) {
                    $diag.style.display = 'block';
                    $diag.innerHTML += '<div class="v360db-warn">' +
                        '<strong>⚠ NhanVien chưa gán PhongBan.</strong> ' +
                        'Toàn bộ ' + d.nhanVienCount + ' nhân viên có IDPhongBan = NULL. ' +
                        'Chart "Phòng ban" sẽ trống.</div>';
                }
                return d;
            })
            .catch(function (err) {
                var $diag = document.getElementById('v360db-diag');
                $diag.style.display = 'block';
                $diag.innerHTML = '<div class="v360db-error">⚠ Diagnostic lỗi: ' +
                    escapeHtml(err.message) + '</div>';
            });
    }

    function reload() {
        var p = $period.value;
        loadInventory();
        loadKpi(p);
        loadTrend(p);
        loadDeptUsage(p);
        loadHourly(p);
        loadGroup(p);
        loadUnused();
        loadExplorer();
        loadStale();
    }

    // ===== Wire up explorer controls =====
    // Tabs
    document.querySelectorAll('.v360db-tab').forEach(function (b) {
        b.addEventListener('click', function () { switchExplorerTab(b.dataset.mode); });
    });

    // Debounced live search (300ms)
    var $search = document.getElementById('v360db-exp-search');
    var $searchClear = document.getElementById('v360db-exp-search-clear');
    var debouncedSearch = debounce(function () {
        explorerState.search = $search.value.trim();
        explorerState.page = 1;
        loadExplorer();
    }, 300);
    $search.addEventListener('input', function () {
        $searchClear.style.display = $search.value ? 'block' : 'none';
        debouncedSearch();
    });
    $searchClear.addEventListener('click', function () {
        $search.value = '';
        $searchClear.style.display = 'none';
        explorerState.search = '';
        explorerState.page = 1;
        loadExplorer();
        $search.focus();
    });

    // Segmented type filter (instant)
    document.querySelectorAll('.v360db-seg__btn').forEach(function (b) {
        b.addEventListener('click', function () {
            document.querySelectorAll('.v360db-seg__btn').forEach(function (x) { x.classList.remove('active'); });
            b.classList.add('active');
            explorerState.type = b.dataset.type;
            explorerState.page = 1;
            loadExplorer();
        });
    });

    // Page size selector
    document.getElementById('v360db-exp-pagesize').addEventListener('change', function (e) {
        explorerState.pageSize = parseInt(e.target.value, 10);
        explorerState.page = 1;
        if (explorerState.mode === 'time') loadExplorerTime($period.value);
    });

    // Reset all filters (including per-column filters/sorts)
    document.getElementById('v360db-exp-clear').addEventListener('click', function () {
        $search.value = '';
        $searchClear.style.display = 'none';
        document.querySelectorAll('.v360db-seg__btn').forEach(function (b) {
            b.classList.toggle('active', b.dataset.type === '');
        });
        // Clear per-column filter states
        Object.keys(tableStates).forEach(function (k) { tableStates[k] = { filters: {}, sort: null }; });
        document.querySelectorAll('table[data-coltable]').forEach(updateColumnIndicators);
        document.querySelectorAll('[id^="v360db-colhint-"]').forEach(function (el) { el.remove(); });
        explorerState.search = '';
        explorerState.type = '';
        explorerState.userFilter = null;
        explorerState.contentFilter = null;
        explorerState.page = 1;
        renderActiveFilterChip();
        loadExplorer();
    });

    // ESC clears focus + search
    $search.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { $searchClear.click(); $search.blur(); }
    });

    $period.addEventListener('change', reload);
    runDiagnostic().then(reload);
})();
</script>
