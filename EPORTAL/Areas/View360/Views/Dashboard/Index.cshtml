                if (hourlyChart && hourlyChart.destroy) hourlyChart.destroy();
                document.getElementById('v360db-hourly').innerHTML = '';
                var labels = [];
                for (var i = 0; i < 24; i++) labels.push(('0' + i).slice(-2) + 'h');
                hourlyChart = Highcharts.chart('v360db-hourly', {
                    chart: { type: 'column' },
                    title: { text: '' },
                    credits: { enabled: false },
                    exporting: { enabled: false },
                    xAxis: { categories: labels, title: { text: null } },
                    yAxis: { min: 0, title: { text: 'Lượt truy cập' }, allowDecimals: false },
                    legend: { enabled: false },
                    series: [{ name: 'Lượt', data: d.counts, color: '#16a34a' }]
