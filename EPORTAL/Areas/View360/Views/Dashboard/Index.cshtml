    function loadExplorerCounts() {
        var extra = {};
        if (explorerState.userFilter) extra.userId = explorerState.userFilter.id;
        if (explorerState.contentFilter) {
            extra.contentType = explorerState.contentFilter.type;
            extra.contentId   = explorerState.contentFilter.id;
        }
        return safeFetch(base + 'ExplorerCounts?' + buildQuery($period.value, extra))
            .then(function (d) {
                document.getElementById('v360db-tab-count-time').textContent    = fmt(d.time || 0);
                document.getElementById('v360db-tab-count-user').textContent    = fmt(d.user || 0);
                document.getElementById('v360db-tab-count-content').textContent = fmt(d.content || 0);
            })
            .catch(function () {
                document.getElementById('v360db-tab-count-time').textContent    = '!';
                document.getElementById('v360db-tab-count-user').textContent    = '!';
                document.getElementById('v360db-tab-count-content').textContent = '!';
            });
    }

    function loadExplorer() {
        var p = $period.value;
        // Refresh badges TRUOC (rat nhanh, 1 query), roi load data tab hien tai
        loadExplorerCounts();
        if (explorerState.mode === 'time') return loadExplorerTime(p);
        if (explorerState.mode === 'user') return loadExplorerByUser(p);
        if (explorerState.mode === 'content') return loadExplorerByContent(p);
    }

    var deptUsageChart = null;

    function loadDeptUsage(period) {
        return safeFetch(base + 'DeptUsage?period=' + encodeURIComponent(period))
            .then(function (d) {
                var $shown = document.getElementById('v360db-dept-shown');
                if (!d.labels || d.labels.length === 0) {
                    document.getElementById('v360db-dept-usage').innerHTML =
                        '<div class="v360db-empty">Chưa có dữ liệu phân quyền.</div>';
                    if ($shown) $shown.textContent = '';
                    return;
                }
                if ($shown) {
                    $shown.textContent = '· Hiển thị ' + d.shown + ' / ' + d.totalDeptWithGrants + ' phòng ban';
                }
                if (deptUsageChart && deptUsageChart.destroy) deptUsageChart.destroy();
                document.getElementById('v360db-dept-usage').innerHTML = '';

                // Bullet chart: 2 series cung 1 row, overlap (grouping:false).
                // Bar lon (Granted) la nen, bar nho (Active) la overlay.
                deptUsageChart = Highcharts.chart('v360db-dept-usage', {
                    chart: { type: 'bar' },
                    title: { text: '' },
                    credits: { enabled: false },
                    exporting: { enabled: false },
                    xAxis: {
                        categories: d.labels,
                        title: { text: null },
                        labels: { style: { fontSize: '11px' } }
                    },
                    yAxis: {
                        min: 0,
                        title: { text: 'Số user' },
                        allowDecimals: false,
                        gridLineColor: '#f1f5f9'
                    },
                    legend: { align: 'left', verticalAlign: 'top' },
                    tooltip: {
                        shared: true,
                        useHTML: true,
                        formatter: function () {
                            var idx = this.points && this.points[0] ? this.points[0].point.index : -1;
                            if (idx < 0) return '';
                            var g = d.granted[idx], a = d.active[idx], v = d.views[idx];
                            var util = g > 0 ? Math.round(a / g * 100) : 0;
                            return '<div style="font-weight:600;margin-bottom:6px;">' +
                                escapeHtml(d.labels[idx]) + '</div>' +
                                '<table style="font-size:12px;line-height:1.5;">' +
                                '<tr><td style="color:#64748b;padding-right:14px;">Cấp quyền</td><td><b>' + fmt(g) + ' user</b></td></tr>' +
                                '<tr><td style="color:#64748b;">Đã active</td><td><b style="color:#2563eb;">' + fmt(a) + ' user</b> (' + util + '%)</td></tr>' +
                                '<tr><td style="color:#64748b;">Lượt xem</td><td><b>' + fmt(v) + '</b></td></tr>' +
                                '</table>';
                        }
                    },
                    plotOptions: {
                        series: {
                            grouping: false,    // <-- key: overlap thay vi side-by-side
                            borderWidth: 0,
                            states: { hover: { brightness: -.05 } }
                        }
                    },
                    series: [
                        // Background bar (Granted) - day, mau nhat
                        { name: 'Cấp quyền',  data: d.granted, color: '#cbd5e1', pointPadding: 0.05 },
                        // Overlay bar (Active) - mong hon, mau dam, chong len giua
                        { name: 'Đã active', data: d.active,  color: '#2563eb', pointPadding: 0.22 }
                    ]
                });
            })
            .catch(function (err) { showError('v360db-dept-usage', err); });
    }

    function loadHourly(period) {
