    function attachExplorerLinkHandlers(tbody) {
        tbody.querySelectorAll('button[data-user-id]').forEach(function (b) {
            b.onclick = function () {
                explorerState.userFilter = { id: parseInt(b.dataset.userId, 10), hoTen: b.dataset.userName };
                explorerState.contentFilter = null;
                explorerState.page = 1;
                renderActiveFilterChip();
                switchExplorerTab('time');
            };
        });
        tbody.querySelectorAll('button[data-content-id]').forEach(function (b) {
            b.onclick = function () {
                explorerState.contentFilter = {
                    type: parseInt(b.dataset.contentType, 10),
                    id: parseInt(b.dataset.contentId, 10),
                    title: b.dataset.contentTitle
                };
                explorerState.userFilter = null;
                explorerState.page = 1;
                renderActiveFilterChip();
                switchExplorerTab('time');
            };
        });
