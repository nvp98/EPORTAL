@model System.Collections.Generic.List<EPORTAL.Common.KnowledgeStore.KnowledgeRow>
@{
    Layout = null;
    var fStatus = (string)ViewBag.FilterStatus;
    var fColl = (string)ViewBag.FilterCollection;
    var fQ = (string)ViewBag.FilterQ;
    Func<string, string> statusBadge = s =>
        s == "active" ? "#16a34a" : s == "pending" ? "#d97706" : s == "stale" ? "#6b7280" : "#dc2626";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Knowledge Cache - V360 Chatbot</title>
    <link href="~/Content/fontawesome-free-6.0.0-web/css/all.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'Segoe UI', Roboto, Arial, sans-serif; background: #0f172a; color: #e2e8f0; font-size: 14px; }
        .wrap { max-width: 1500px; margin: 0 auto; padding: 18px 18px 110px; }
        h1 { font-size: 20px; margin: 0 0 4px; }
        .sub { color: #94a3b8; margin-bottom: 16px; }
        .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
        .filters input, .filters select { background: #1e293b; border: 1px solid #334155; color: #e2e8f0; padding: 7px 10px; border-radius: 6px; }
        .btn { cursor: pointer; border: 0; border-radius: 6px; padding: 7px 12px; font-size: 13px; color: #fff; background: #2563eb; }
        .btn.gray { background: #475569; } .btn.red { background: #dc2626; } .btn.green { background: #16a34a; } .btn.amber { background: #d97706; }
        .btn:disabled { opacity: .5; cursor: default; }
        table { width: 100%; border-collapse: collapse; background: #1e293b; border-radius: 8px; overflow: hidden; }
        th, td { padding: 9px 10px; text-align: left; border-bottom: 1px solid #334155; vertical-align: top; }
        th { background: #0b1220; color: #93c5fd; font-weight: 600; position: sticky; top: 0; }
        td.q { max-width: 280px; font-weight: 600; }
        td.a { max-width: 420px; color: #cbd5e1; }
        .muted { color: #64748b; font-size: 12px; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; color: #fff; }
        .pill { display: inline-block; padding: 1px 7px; border-radius: 8px; font-size: 11px; background: #334155; color: #cbd5e1; }
        .acts { white-space: nowrap; }
        .acts .btn { padding: 5px 8px; margin: 1px; }
        .empty { padding: 40px; text-align: center; color: #64748b; }
        /* modal */
        .modal-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 50; }
        .modal { position: fixed; inset: 5% 50% auto auto; transform: translateX(50%); width: min(720px, 92vw); max-height: 90vh; overflow: auto;
                 background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 18px; z-index: 51; }
        .modal h3 { margin: 0 0 12px; }
        .modal label { display: block; margin: 10px 0 4px; color: #94a3b8; font-size: 12px; }
        .modal textarea, .modal input { width: 100%; background: #0f172a; border: 1px solid #334155; color: #e2e8f0; border-radius: 6px; padding: 8px; font-family: inherit; }
        .modal .row2 { display: flex; gap: 10px; }
        .modal-foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
        /* player bar */
        .player { position: fixed; left: 0; right: 0; bottom: 0; background: #0b1220; border-top: 1px solid #334155;
                  padding: 10px 16px; z-index: 60; gap: 12px; align-items: center; display: none; box-shadow: 0 -4px 14px rgba(0,0,0,.4); }
        .player.show { display: flex; }
        .player audio { width: 100%; height: 36px; margin-top: 6px; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="wrap">
        <h1><i class="fa fa-database"></i> Knowledge Cache — câu trả lời chatbot đã học</h1>
        <div class="sub">Câu hỏi/đáp được LLM Curator duyệt (≥85 điểm) và lưu lại để phục vụ tức thì, bỏ qua OpenAI. Tổng: @Model.Count dòng.</div>

        <form class="filters" method="get">
            <input type="text" name="collectionId" value="@fColl" placeholder="CollectionId (để trống = tất cả)" style="width:230px" />
            <select name="status">
                @foreach (var s in new[] { "active", "pending", "stale", "disabled", "" })
                {
                    <option value="@s" selected="@(fStatus == s)">@(s == "" ? "(mọi trạng thái)" : s)</option>
                }
            </select>
            <input type="text" name="q" value="@fQ" placeholder="Tìm trong câu hỏi/trả lời" style="width:240px" />
            <button class="btn" type="submit"><i class="fa fa-search"></i> Lọc</button>
            <a class="btn gray" href="@Url.Action("KnowledgeBase")">Xóa lọc</a>
        </form>

        @if (Model.Count == 0)
        {
            <div class="empty">Chưa có câu trả lời nào được cache (hoặc không khớp bộ lọc).</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Câu hỏi</th><th>Câu trả lời</th><th>Scope</th><th>Loại</th>
                        <th>Điểm</th><th>Trạng thái</th><th>Hits</th><th>Cập nhật</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var ans = r.AnswerText ?? "";
                        var ansShort = ans.Length > 160 ? ans.Substring(0, 160) + "…" : ans;
                        <tr data-id="@r.Id" data-coll="@r.CollectionId" data-sugg="@r.Suggestions">
                            <td class="q">
                                @r.CanonicalQuestion
                                <div class="muted">@r.CollectionId</div>
                            </td>
                            <td class="a" title="@ans">
                                @ansShort
                                @if (r.ActionType == "navigate")
                                {
                                    <div class="muted"><i class="fa fa-location-arrow"></i> điều hướng → @r.ActionTarget</div>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(r.SceneScope) ? "tour" : "scene")</td>
                            <td><span class="pill">@(r.Intent ?? "info")</span>@(string.IsNullOrEmpty(r.Category) ? "" : " " + r.Category)</td>
                            <td>@r.QualityScore</td>
                            <td><span class="badge" style="background:@statusBadge(r.Status)">@r.Status</span><div class="muted">@r.Source</div></td>
                            <td>@r.HitCount<div class="muted">@("x" + r.Confirmations)</div></td>
                            <td class="muted">@r.UpdatedAt.ToString("dd/MM HH:mm")</td>
                            <td class="acts">
                                <button class="btn gray" onclick="kbPlay(this)" title="Nghe audio"><i class="fa fa-play"></i></button>
                                <button class="btn amber" onclick="kbClearAudio(this)" title="Xóa audio (để cache lại)"><i class="fa fa-eraser"></i></button>
                                <button class="btn" onclick="kbEdit(this)" title="Sửa"><i class="fa fa-pen"></i></button>
                                @if (r.Status == "active")
                                {
                                    <button class="btn amber" onclick="kbStatus(this,'disabled')" title="Tắt"><i class="fa fa-ban"></i></button>
                                }
                                else
                                {
                                    <button class="btn green" onclick="kbStatus(this,'active')" title="Bật"><i class="fa fa-check"></i></button>
                                }
                                <button class="btn red" onclick="kbDelete(this)" title="Xóa câu"><i class="fa fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Edit modal -->
    <div class="modal-bg" id="mbg" onclick="if(event.target===this)kbClose()"></div>
    <div class="modal" id="modal" style="display:none">
        <h3>Sửa câu trả lời</h3>
        <input type="hidden" id="m_id" /><input type="hidden" id="m_coll" />
        <label>Câu hỏi chuẩn</label>
        <input type="text" id="m_q" />
        <label>Câu trả lời</label>
        <textarea id="m_a" rows="6"></textarea>
        <div class="row2">
            <div style="flex:1"><label>Gợi ý (ngăn bởi |)</label><input type="text" id="m_sugg" /></div>
            <div style="width:120px"><label>Điểm (0-100)</label><input type="number" id="m_score" min="0" max="100" /></div>
        </div>
        <div class="modal-foot">
            <button class="btn gray" onclick="kbClose()">Hủy</button>
            <button class="btn green" onclick="kbSave()"><i class="fa fa-save"></i> Lưu</button>
        </div>
    </div>

    <div class="player" id="player">
        <i class="fa fa-headphones" style="color:#60a5fa;font-size:18px"></i>
        <div style="flex:1;min-width:0">
            <div id="pl_q" style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></div>
            <div id="pl_status" class="muted" style="margin:2px 0"></div>
            <audio id="kbAudio" controls preload="none"></audio>
        </div>
        <button class="btn gray" onclick="kbPlayerClose()" title="Đóng"><i class="fa fa-xmark"></i></button>
    </div>

    <script>
        var TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;
        function post(url, data) {
            var body = new URLSearchParams();
            body.append('__RequestVerificationToken', TOKEN);
            for (var k in data) body.append(k, data[k] == null ? '' : data[k]);
            return fetch(url, { method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() })
                .then(function (r) { return r.json().catch(function () { return { ok: r.ok, error: 'HTTP ' + r.status }; }); });
        }
        function rowOf(btn) { return btn.closest('tr'); }
        function kbStatus(btn, status) {
            var tr = rowOf(btn);
            post('@Url.Action("KbSetStatus")', { id: tr.dataset.id, collectionId: tr.dataset.coll, status: status })
                .then(function (j) { if (j.ok) location.reload(); else alert('Lỗi: ' + (j.error || '')); });
        }
        function kbDelete(btn) {
            if (!confirm('Xóa hẳn câu trả lời cache này?')) return;
            var tr = rowOf(btn);
            post('@Url.Action("KbDelete")', { id: tr.dataset.id, collectionId: tr.dataset.coll })
                .then(function (j) { if (j.ok) tr.remove(); else alert('Lỗi: ' + (j.error || '')); });
        }
        function kbEdit(btn) {
            var tr = rowOf(btn);
            document.getElementById('m_id').value = tr.dataset.id;
            document.getElementById('m_coll').value = tr.dataset.coll;
            document.getElementById('m_q').value = tr.querySelector('td.q').childNodes[0].textContent.trim();
            document.getElementById('m_a').value = tr.querySelector('td.a').getAttribute('title') || '';
            document.getElementById('m_score').value = tr.children[4].textContent.trim();
            document.getElementById('m_sugg').value = tr.dataset.sugg || '';
            document.getElementById('mbg').style.display = 'block';
            document.getElementById('modal').style.display = 'block';
        }
        function kbClose() { document.getElementById('mbg').style.display = 'none'; document.getElementById('modal').style.display = 'none'; }
        function kbSave() {
            post('@Url.Action("KbEdit")', {
                id: document.getElementById('m_id').value,
                collectionId: document.getElementById('m_coll').value,
                canonicalQuestion: document.getElementById('m_q').value,
                answerText: document.getElementById('m_a').value,
                qualityScore: document.getElementById('m_score').value || '85',
                suggestions: document.getElementById('m_sugg').value
            }).then(function (j) { if (j.ok) location.reload(); else alert('Lỗi: ' + (j.error || '')); });
        }
        function kbPlay(btn) {
            var tr = rowOf(btn);
            var q = tr.querySelector('td.q').childNodes[0].textContent.trim();
            document.getElementById('player').classList.add('show');
            document.getElementById('pl_q').textContent = q;
            var st = document.getElementById('pl_status');
            var a = document.getElementById('kbAudio');
            st.textContent = 'Đang tải audio…'; st.style.color = '#94a3b8';
            a.style.display = 'none';
            a.onerror = function () {
                st.innerHTML = '<i class="fa fa-triangle-exclamation"></i> Chưa có audio. Mở chế độ <b>Đọc</b> và hỏi câu này 1 lần để tạo.';
                st.style.color = '#f59e0b'; a.style.display = 'none';
            };
            a.oncanplay = function () { st.textContent = ''; a.style.display = 'block'; };
            a.src = '@Url.Action("KbAudio")?id=' + tr.dataset.id + '&_=' + Date.now();
            a.load();
            a.play().catch(function () { });
        }
        function kbPlayerClose() {
            var a = document.getElementById('kbAudio');
            try { a.pause(); } catch (e) { }
            a.removeAttribute('src'); a.load();
            document.getElementById('player').classList.remove('show');
        }
        function kbClearAudio(btn) {
            if (!confirm('Xóa audio đã cache của câu này? Lần sau ở chế độ Đọc sẽ tạo lại bằng VBee.')) return;
            var tr = rowOf(btn);
            post('@Url.Action("KbClearAudio")', { id: tr.dataset.id })
                .then(function (j) { if (j.ok) alert('Đã xóa ' + (j.deleted || 0) + ' đoạn audio.'); else alert('Lỗi: ' + (j.error || '')); });
        }
    </script>
</body>
</html>
