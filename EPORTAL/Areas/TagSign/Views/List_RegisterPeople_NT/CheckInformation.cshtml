                                            </td>
                                            <td class="text-center">
                                                @Html.DropDownListFor(model => model.CBNV8, ViewBag.VP1C_List as SelectList, "----- Chọn CBNV trình ký -----", new { @id = "C8", @class = "form-control" })
                                            </td>
                                            <td class="text-center">
                                                <span class="text-center" style="margin-top: 8px"> Ghi chú: Tổ cấp phát thẻ P. An toàn môi trường <span style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="btn-margin-top" style="padding: 2%;">

                            <input type="submit" value="Trình ký" class="btn btn-success button_submit" />
                            <a class="" title="Trở về" href="@Url.Action("Index", "List_RegisterPeople_NT")">
                                <span class="btn-transition btn btn-warning" style="width:120px;">Hủy trình ký</span>
                            </a>
                        </div>
                    }
                </div>

            </div>
        </div>

