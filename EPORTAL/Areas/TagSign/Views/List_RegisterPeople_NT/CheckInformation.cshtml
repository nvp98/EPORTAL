                                            </td>
                                        </tr>*@

                                        @*<tr>
                                            <td>
                                                Kỹ thuật viên<span style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> :
                                            </td>
                                            <td class="text-center">
                                                @Html.DropDownListFor(model => model.CBNV6, ViewBag.KTV_LQ_CTH_List as SelectList, "----- Chọn CBNV trình ký -----", new { @id = "C6", @class = "form-control" })
                                            </td>
                                            <td class="text-center">
                                                <span class="text-center" style="margin-top: 8px">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ghi chú: Kỹ thuật viên ký nháy Cảng tổng hợp - Bộ phận liên quan <span style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                <span class="text-center" style="margin-top: 8px"> Tr/P Bộ phận<span style="color:red;">(*)</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: </span>
                                            </td>
                                            <td class="text-center">
                                                @Html.DropDownListFor(model => model.CBNV7, ViewBag.TP_QL_CTH_List as SelectList, "----- Chọn CBNV trình ký -----", new { @id = "C7", @class = "form-control" })
                                            </td>
                                            <td class="text-center">
                                                <span class="text-center" style="margin-top: 8px"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ghi chú: Trưởng phó ký chính Cảng tổng hợp - Bộ phận liên quan <span style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span>
                                            </td>
                                        </tr>*@
                                    </tbody>
                                </table>
                                <button id="addBPLQ" type="button" class="btn btn-primary mb-1">Thêm BP liên quan</button>

                                <script>
                                    let index = 0;
                                    $("#addBPLQ").click(function () {
                                        const html = `
                                               <tr>
                                                    <td>
                                                        <select class="form-control" name="BPLienQuanEXT[${index}].IDPhongBan" class="department-select">
                                                            <option>Đang tải...</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-control" name="BPLienQuanEXT[${index}].NhanVienIDKTV" >
                                                            <option value="">----- Chọn CBNV trình ký -----</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-control" name="BPLienQuanEXT[${index}].NhanVienTPBP" >
                                                            <option value="">----- Chọn CBNV trình ký -----</option>
                                                        </select>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="text-center" style="margin-top: 8px"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Ghi chú: Nhân viên ký nháy, T/PBP ký chính. <span style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span>
                                                    </td>
                                                </tr>`;
                                        $("#tableBPLQ tbody").append(html);
                                        loadDepartmentsToSelect($(`select[name='BPLienQuanEXT[${index}].IDPhongBan']`));
                                        index++;
                                    });
                                    function loadDepartmentsToSelect($selectElement) {
                                        $.ajax({
                                            url: '/TagSign/List_RegisterPeople_NT/GetListBP', // API trả về danh sách bộ phận
                                            method: 'GET',
                                            success: function (data) {
                                                $selectElement.empty();
                                                $selectElement.append(`<option value="">-- Chọn bộ phận --</option>`);
                                                data.forEach(item => {
                                                    $selectElement.append(`<option value="${item.IDPhongBan}">${item.TenPhongBan}</option>`);
                                                });
                                                // Apply lại Chosen sau khi load xong
                                                $selectElement.chosen({ width: '100%' });
                                            },
                                            error: function () {
                                                $selectElement.html('<option>Lỗi tải</option>');
                                            }
                                        });
                                    }
                                    // onchange 
                                    $(document).on('change', 'select[name$="IDPhongBan"]', function () {
                                        const $deptSelect = $(this);
                                        const deptId = $deptSelect.val();

                                        // Tìm select nhân viên cùng dòng
                                        const $row = $deptSelect.closest('tr');
                                        const $employeeSelectKTV = $row.find('select[name$="NhanVienIDKTV"]');
                                        const $NhanVienTPBP = $row.find('select[name$="NhanVienTPBP"]');

                                        if (!deptId) {
                                            $employeeSelectKTV.html('<option value="">-- Chọn nhân viên --</option>');
                                            $NhanVienTPBP.html('<option value="">-- Chọn nhân viên --</option>');
                                            return;
                                        }

                                        // Gọi AJAX lấy danh sách nhân viên
                                        $.ajax({
                                            url: '/TagSign/List_RegisterPeople_NT/GetListKyDuyet',
                                            method: 'GET',
                                            data: { IDPhongBan: deptId },
                                            success: function (data) {
                                                $employeeSelectKTV.empty().append('<option value="">-- Chọn nhân viên --</option>');
                                                $NhanVienTPBP.empty().append('<option value="">-- Chọn nhân viên --</option>');
                                                $.each(data, function (i, nv) {
                                                    if (nv.IDLKD == 2) {
                                                        $employeeSelectKTV.append(`<option value="${nv.IDNhanVien}">${nv.HoTen}</option>`);
                                                    }
                                                    else if (nv.IDLKD == 1) {
                                                        $NhanVienTPBP.append(`<option value="${nv.IDNhanVien}">${nv.HoTen}</option>`);
                                                    }
                                                   
                                                });
                                            },
                                            error: function () {
                                                $employeeSelectKTV.html('<option value="">-- Lỗi tải dữ liệu --</option>');
                                                $NhanVienTPBP.html('<option value="">-- Lỗi tải dữ liệu --</option>');
                                            }
                                        });
                                    });
                                </script>

                                <div class="col-md-12 col-lg-12" style=" text-align: left;">
                                    <h6 class="text-uppercase"><b>Tổ CPT (P.ATMT)<span style="color:red;">(*)</span></b></h6>
                                </div>
                                <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                    <thead>
