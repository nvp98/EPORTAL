                                            </td>
                                            <td class="text-center">
                                                @Html.DropDownListFor(model => model.CBNV5, ViewBag.TP_QL_CD_List as SelectList, "----- Chọn CBNV trình ký -----", new { @id = "C5", @class = "form-control" })
                                            </td>
