

@{
    ViewBag.Title = "HPDQ_Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model PagedList.IPagedList<EPORTAL.ModelsTagSign.TheXeCoDongVM.DonDangKyViewModel>
@using PagedList.Mvc
@using EPORTAL.ModelsView360;
@using EPORTAL.ModelsTagSign;
@using EPORTAL.ModelsPartner;
<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

@{
    EPORTALEntities db = new EPORTALEntities();
    EPORTAL_REGISTEREntities db_dk = new EPORTAL_REGISTEREntities();
    EPORTAL_NTEntities db_nt = new EPORTAL_NTEntities();
    //   var nd = db.AuthorizationContractors.Where(x => x.IDNhanVien == MyAuthentication.ID).SingleOrDefault();
}
<link href="~/Content/PagedList.css" rel="stylesheet" />
<div id="importOverlay" style="display: none; position: fixed; z-index: 9999; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: white; font-size: 1.5rem;">
        <i class="fa fa-spinner fa-spin fa-2x"></i> Đang tải dữ liệu, vui lòng chờ...
    </div>
</div>
<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-portfolio icon-gradient bg-grow-early">
                        </i>
                    </div>
                    <div>
                        ĐƠN ĐỀ NGHỊ CẤP THẺ DÀI NGÀY - DÀNH CHO XE CƠ ĐỘNG
                        <div class="page-title-subheading">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="tab-content">
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <div class="row" style="width:100%">
                            <div class="col-md-10 col-lg-10">
                                <div class="row">
                                    <span class="text-center" style="margin-top: 8px">Từ ngày :</span>
                                    <div class="col-md-2">
                                        @Html.TextBox("begind", null, new { @id = "begind", @type = "date", @class = "form-control" })
                                    </div>
                                    <span class="text-center" style="margin-top: 8px">Đến ngày :</span>
                                    <div class="col-md-2">
                                        @Html.TextBox("endd", null, new { @id = "endd", @type = "date", @class = "form-control" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.TextBox("maPhieu", ViewBag.MaPhieu as string, new { @class = "form-control", placeholder = "Nhập mã phiếu" })
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-primary" id="btn-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                    </div>
                                </div>
                            </div>
                            @*<div class="col-md-2">

                                    <button type="button" id="btn-add" class="btn btn-primary " style="margin-left:10px;float:right"><i class="fa fa-plus">&nbsp;</i>&nbsp;Thêm mới </button>
                                    <div class="modal" id="myModal" role="dialog" data-url='@Url.Action("Create","TheXeCoDong_NT",new {area="TagSign"})' style="margin-top:50px"></div>
                                </div>*@
                            @*<div class="col-md-2">
                                    <a href="@Url.Action("Create", "TheXeCoDong_NT", new { area = "TagSign" })"
                                       class="btn btn-primary"
                                       style="margin-left:10px;float:right">
                                        <i class="fa fa-plus"></i> Thêm mới
                                    </a>
                                </div>*@

                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                    <thead>
                                        <tr>
                                            <th width="30px" class="text-center">STT</th>
                                            <th class="text-center" width="100px" style="vertical-align:middle">Thao tác</th>
                                            <th class="text-center" width="200px" style="vertical-align:middle">Mã đơn</th>
                                            <th class="text-center" width="200px" style="vertical-align:middle">Nội dung</th>
                                            @*<th class="text-center" width="150px" style="vertical-align:middle">Loại Nhà thầu</th>*@
                                            <th class="text-center" width="150px" style="vertical-align:middle">Nhân viên NT</th>
                                            <th class="text-center" width="200px" style="vertical-align:middle">BP Quản lý</th>
                                            <th class="text-center" width="200px" style="vertical-align:middle">Nhà thầu</th>
                                            <th class="text-center" width="150px" style="vertical-align:middle">Hợp đồng</th>
                                            <th class="text-center" width="150px" style="vertical-align:middle">Ngày trình ký</th>
                                            <th class="text-center" width="150px" style="vertical-align:middle">File đính kèm</th>
                                            <th class="text-center" width="100px" style="vertical-align:middle">Tình trạng</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int stt = (ViewBag.Page - 1) * ViewBag.PageSize + 1;
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td class="text-center">@stt</td>
                                                    <td>
                                                        @if (item.TinhTrang_ID == 5) // 5 = nháp
                                                        {
                                                            <a title="Xóa" href="javascript:void(0);" class="btn-action" onclick="xoaDon('@item.Ma_Don', '@item.NoiDung')">
                                                                <i class="fa fa-trash" aria-hidden="true"></i>
                                                            </a>
                                                            }
                                                            @if (item.TinhTrang_ID == 2)
                                                            {
                                                                <!-- Nếu đã duyệt thì cho phép tải PDF -->
                                                                <a href="@Url.Action("ExportDonDangKyPdf", "TheXeCoDong_NT", new { maDon = item.Ma_Don })">
                                                                    <i class="fa fa-download text-success"></i>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <!-- Nếu chưa duyệt hoặc từ chối thì hiển thị icon cấm -->
                                                                <i class="fa-solid fa-ban text-primary" title="Đơn chưa được duyệt, không thể tải PDF"></i>
                                                            }
                                                           
                                                            <a class="btn-action"
                                                               title="Chi tiết danh sách"
                                                               href="@Url.Action("HPDQ_Detail", "TheXeCoDong_NT", new { maDon = item.Ma_Don })">
                                                                <i class="fa-solid fa-bars"></i>
                                                            </a>
                                                        </td>
                                                    <td>@item.Ma_Don</td>
                                                    <td>@item.NoiDung</td>
                                                    <td>@item.TenNhanVienNT</td>
                                                    <td>@item.TenBPQL</td>
                                                    <td>@item.TenNhaThau</td>
                                                    <td>@item.HopDong</td>
                                                    <td>@(item.NgayTrinhKy.HasValue ? item.NgayTrinhKy.Value.ToString("dd/MM/yyyy") : "")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(item.FileHoSoXe))
                                                        {
                                                            <a href="@Url.Content("~/UploadedFiles/" + item.FileHoSoXe)" target="_blank" title="Xem hồ sơ">
                                                                <i class="fa-solid fa-eye mr-1"></i> @item.FileHoSoXe
                                                            </a>
                                                        }
                                                    </td>
                                                    <td>
                                                            @{
                                                                string btnClass;
                                                                switch (item.TinhTrang_ID)
                                                                {
                                                                    case 1:
                                                                        btnClass = "btn-warning";
                                                                        break;
                                                                    case 2:
                                                                        btnClass = "btn-info";
                                                                        break;
                                                                    case 3:
                                                                        btnClass = "btn-success";
                                                                        break;
                                                                    case 4:
                                                                        btnClass = "btn-danger";
                                                                        break;
                                                                    default:
                                                                        btnClass = "btn-secondary";
                                                                        break;
                                                                }
                                                            }
                                                            <a href="@Url.Action("HPDQ_LuongTrinhKy", "TheXeCoDong_NT", new { Ma_Don = item.Ma_Don })" style="text-decoration:none;">
                                                                <span class="btn @btnClass" style="width:120px;">@item.TenTinhTrang</span>
                                                            </a>
                                                        </td>
                                                   
                                                </tr>
                                                stt++;
                                            }
                                        }
                                    </tbody>
                                </table>
                                <div class="pager">
                                    @Html.PagedListPager(Model, page => Url.Action("Index_Test", "TheXeCoDong_NT", new { area = "TagSign", page }))
                                    <span class="pageoff">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">

            </div>
        </div>
    </div>


</div>

<script type="text/javascript">
    //$('#btn-add').click(function () {
    //    var url = $('#myModal').data('url');
    //    $.get(url, function (data) {
    //        $("#myModal").html(data);
    //        $("#ModalTitle").html("Thêm tiêu đề");
    //        $("#myModal").modal('show');
    //    });
    //});
    $('#btn-Import').click(function () {
        var url = $('#myModalImport').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Add Permission");
            $("#myModal").modal('show');
        });
    });
    $("#btn-search").on('click', function () {
    var begind = $('#begind').val();
    var endd = $('#endd').val();
    var maPhieu = $('#maPhieu').val();
        $("#importOverlay").show();
        window.location.href = '@Url.Action("HPDQ_Index", "TheXeCoDong_NT")?begind=' + encodeURIComponent(begind) + '&endd=' + encodeURIComponent(endd) + '&maPhieu=' + encodeURIComponent(maPhieu);

    });
    $(document).ready(function () {
        var dateNewFormat, onlyDate, today = new Date();

        var prevMonthLastDate = new Date(today.getFullYear(), today.getMonth(), 1);

        dateLastDate = prevMonthLastDate.getFullYear() + '-';
        if (prevMonthLastDate.getMonth() >= 9) {

            dateLastDate += (prevMonthLastDate.getMonth() + 1);
        }
        else {
            dateLastDate += '0' + (prevMonthLastDate.getMonth() + 1);
        }

        onlyLastDate = prevMonthLastDate.getDate();

        if (onlyLastDate.toString().length == 2) {

            dateLastDate += "-" + onlyLastDate;
        }
        else {
            dateLastDate += '-0' + onlyLastDate;
        }



        dateNewFormat = today.getFullYear() + '-';
        if (today.getMonth() >= 9) {

            dateNewFormat += (today.getMonth() + 1);
        }
        else {
            dateNewFormat += '0' + (today.getMonth() + 1);
        }

        onlyDate = today.getDate();
        if (onlyDate.toString().length == 2) {

            dateNewFormat += "-" + onlyDate;
        }
        else {
            dateNewFormat += '-0' + onlyDate;
        }
        if ($('#begind').val() == '') {
            $('#begind').val(dateLastDate);
        }
        if ($('#endd').val() == '') {
            $('#endd').val(dateNewFormat);
        }
    });
    function xoaDon(maDon, noiDung) {
        if (!confirm("Bạn muốn xóa Thông tin: " + noiDung)) return;

        $.ajax({
            url: '/TheXeCoDong_NT/Delete',
            type: 'POST',
            data: { maDon: maDon },
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert("Không thể xóa: " + res.message);
                }
            },
            error: function () {
                alert("Có lỗi khi gửi yêu cầu xóa.");
            }
        });
    }
    $(document).on('click', '.btn-trinhky', function () {
        var maDon = $(this).data('madon');
        var noiDung = $(this).data('noidung');

        if (!confirm("Bạn có chắc muốn trình ký đơn: " + maDon + " không?")) return;

        $.ajax({
            url: '/TheXeCoDong_NT/TrinhKyNhaThau',
            type: 'POST',
            data: { MaDon: maDon },
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert("Lỗi: " + res.message);
                }
            },
            error: function () {
                alert("Có lỗi xảy ra khi trình ký đơn.");
            }
        });
    });
</script>








