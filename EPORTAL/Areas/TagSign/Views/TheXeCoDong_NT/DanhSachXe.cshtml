    $("#fileImportExcel").change(function () {
    var file = this.files[0];
    if (!file) return;
    var formData = new FormData();
    formData.append("file", file);

    // Hiện overlay/loading
    $("#importOverlay").show();

    $.ajax({
        url: '@Url.Action("ImportExcelXe", "TheXeCoDong_NT")',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (res) {
            // Ẩn overlay/loading
            $("#importOverlay").hide();

            if (res.success) {
                alert("Import thành công!");
                location.reload();
            } else {
                alert("Lỗi import: " + res.message);
            }
        },
        error: function () {
            // Ẩn overlay/loading
            $("#importOverlay").hide();
            alert("Có lỗi khi import file Excel.");
        }
    });
});
    $('#btn-download-template').click(function() {
            window.location.href = '@Url.Action("DownloadFile", "TheXeCoDong_NT")';
        });
    $(document).on('click', '.btn-delete-xe', function (e) {
      e.preventDefault();
      var btn = $(this);
      var id = btn.data('id');

      if (!id) {
          alert('ID không hợp lệ.');
          return;
      }

      if (!confirm('Bạn có chắc muốn xóa xe này?')) return;

      $.ajax({
          url: '@Url.Action("XoaXe")', // nếu action ở controller khác: '@Url.Action("XoaXe","YourController")'
          type: 'POST',
          data: {
              id: id
          },
          success: function (res) {
              if (res && res.success) {
                  alert(res.message);
                  // reload lại trang để cập nhật paging / filter
                  location.reload();
              } else {
                  alert(res && res.message ? res.message : 'Xóa không thành công.');
              }
          },
          error: function (xhr) {
              alert('Có lỗi phía server: ' + xhr.statusText);
          }
      });
  });
  $(document).on('click', '.btn-edit-xe', function (e) {
  e.preventDefault();
  var id = $(this).data('id');
  if (!id) { alert('ID không hợp lệ'); return; }

  // gọi GetXe (phải đúng route)
  $.get('@Url.Action("GetXe", "TheXeCoDong_NT", new { area = "TagSign" })', { id: id })
    .done(function (res) {
      if (!res || !res.success) {
        alert(res && res.message ? res.message : 'Không lấy được dữ liệu.');
        return;
      }
      var d = res.data || {};

      // gán giá trị vào form trong modal
      $('#edit-ID').val(d.ID || '');
      $('#edit-BienSoXe').val(d.BienSoXe || '');
      $('#edit-TuNgay').val(d.TuNgay || '');
      $('#edit-DenNgay').val(d.DenNgay || '');
      $('#edit-ID_LoaiPhuongTien').val(d.ID_LoaiPhuongTien || '');
      $('#edit-TTHD').val(d.TTHD || '');

      // bây giờ mở modal (nếu bạn đã dùng data-toggle/modal thì bootstrap có thể đã mở nó;
      // gọi lại .modal('show') an toàn)
      $('#modalEdit').modal('show');
    })
    .fail(function (xhr, status, err) {
      console.error('GetXe failed', status, err);
      alert('Lỗi khi lấy dữ liệu từ server.');
    });
});

// Submit form cập nhật
$('#form-edit').submit(function (e) {
  e.preventDefault();
  var data = {
    ID: $('#edit-ID').val(),
    BienSoXe: $('#edit-BienSoXe').val(),
    TuNgay: $('#edit-TuNgay').val() || null,
    DenNgay: $('#edit-DenNgay').val() || null,
    ID_LoaiPhuongTien: $('#edit-ID_LoaiPhuongTien').val() || null,
    TTHD: $('#edit-TTHD').val() || null
  };

  $.post('@Url.Action("CapNhatXe", "TheXeCoDong_NT", new { area = "TagSign" })', data)
    .done(function (res) {
      if (!res) { alert('Phản hồi rỗng từ server.'); return; }
      if (res.success) {
        // cập nhật DOM theo response nếu cần
        var d = res.data;
        var row = $('#row-' + d.ID);
        if (row.length) {
          row.find('.col-biensoxe').text(d.BienSoXe || '');
          row.find('.col-thoihan').text((d.TuNgay || '') + ' – ' + (d.DenNgay || ''));
          if (d.LoaiPhuongTien !== undefined) row.find('.col-loaipt').text(d.LoaiPhuongTien || '');
          var t = parseInt(d.TTHD || 0, 10);
          var text = t === 1 ? 'Hoạt động' : t === 2 ? 'Hết hạn' : t === 3 ? 'Đã khóa' : '';
          var cls = t === 1 ? 'badge badge-success' : t === 2 ? 'badge badge-warning' : t === 3 ? 'badge badge-secondary' : 'badge badge-light';
          row.find('.col-tinhtrang').html('<span class="' + cls + '">' + text + '</span>');
        }

        $('#modalEdit').modal('hide');
        // nếu muốn reload toàn trang thay vì cập nhật DOM, dùng: location.reload();
          alert(res.message);
          location.reload();
      } else {
        alert(res.message || 'Cập nhật thất bại.');
      }
    })
    .fail(function (xhr) {
      alert('Có lỗi phía server: ' + xhr.statusText);
    });
});
</script>








