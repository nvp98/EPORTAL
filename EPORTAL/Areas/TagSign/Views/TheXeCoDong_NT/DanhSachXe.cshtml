

@{
    ViewBag.Title = "HPDQ_Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model PagedList.IPagedList<EPORTAL.ModelsTagSign.TheXeCoDongVM.XeCoDongModel>
@using PagedList.Mvc
@using EPORTAL.ModelsView360;
@using EPORTAL.ModelsTagSign;
@using EPORTAL.ModelsPartner;
<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

@{
    EPORTALEntities db = new EPORTALEntities();
    EPORTAL_REGISTEREntities db_dk = new EPORTAL_REGISTEREntities();
    EPORTAL_NTEntities db_nt = new EPORTAL_NTEntities();
    //   var nd = db.AuthorizationContractors.Where(x => x.IDNhanVien == MyAuthentication.ID).SingleOrDefault();
}
<link href="~/Content/PagedList.css" rel="stylesheet" />
<div id="importOverlay" style="display: none; position: fixed; z-index: 9999; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: white; font-size: 1.5rem;">
        <i class="fa fa-spinner fa-spin fa-2x"></i> Đang tải dữ liệu, vui lòng chờ...
    </div>
</div>
<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="app-page-title">
            <div class="page-title-wrapper d-flex justify-content-between align-items-center">
                <div class="page-title-heading d-flex align-items-center">
                    <div class="page-title-icon">
                        <i class="pe-7s-portfolio icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Danh sách xe cơ động
                        <div class="page-title-subheading"></div>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-success mr-2" id="btn-import-excel">
                        <i class="fa fa-upload"></i> Import Excel
                    </button>
                    <button type="button" class="btn btn-info" id="btn-download-template">
                        <i class="fa fa-download"></i> Tải biểu mẫu
                    </button>
                    <input type="file" id="fileImportExcel" style="display:none;" accept=".xlsx,.xls" />
                </div>
            </div>
        </div>


        <div class="tab-content">
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center" style="width:100%">
                            <div class="col-lg-12">
                                <form class="form-row" autocomplete="off" id="searchForm">
                                    <div class="form-group col-md-1,5">
                                        <label for="begind">Từ ngày</label>
                                        @Html.TextBox("begind", null, new { @id = "begind", @type = "date", @class = "form-control" })
                                    </div>
                                    <div class="form-group col-md-1,5">
                                        <label for="endd">Đến ngày</label>
                                        @Html.TextBox("endd", null, new { @id = "endd", @type = "date", @class = "form-control" })
                                    </div>
                                    <div class="form-group col-md-2">
                                        <label for="search">Biển số</label>
                                        @Html.TextBox("search", ViewBag.Search as string, new { @id = "search", @class = "form-control", @placeholder = "Tìm kiếm..." })
                                    </div>
                                    <div class="form-group col-md-2">
                                        <label for="nhaThauId">Nhà thầu</label>
                                        @Html.DropDownList("nhaThauId", (SelectList)ViewBag.ListNhaThau, "Chọn nhà thầu", new { @class = "form-control chosen-select", @id = "nhaThauId", @style = "width:100%;" })
                                    </div>
                                    <div class="form-group col-md-2">
                                        <label for="loaiPhuongTien">Loại phương tiện</label>
                                        @Html.DropDownList("loaiPhuongTien", (SelectList)ViewBag.ListLoaiPhuongTien, "Chọn loại phương tiện", new { @class = "form-control chosen-select", @id = "loaiPhuongTien", @style = "width:100%;" })
                                    </div>
                                    <div class="form-group col-md-2">
                                        <label for="TrangThai">Trạng Thái</label>
                                        @Html.DropDownList("TrangThai", new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "Hoạt động", Value = "1" },
                                            new SelectListItem { Text = "Hết hạn", Value = "2" },
                                            new SelectListItem { Text = "Đã khóa", Value = "3" }
                                        }, "Chọn trạng thái", new { @class = "form-control chosen-select", @id = "TrangThai", style = "width:70%;" })
                                    </div>

                                    <div class="form-group col-md-1 d-flex align-items-end">
                                        <button type="button" class="btn btn-primary mr-2" id="btn-search">
                                            <i class="fa fa-search"></i> Tìm kiếm
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                    <thead>
                                        <tr>
                                            <th class="text-center" width="100px">Hành động</th>
                                            <th class="text-center" width="10px">TT</th>
                                            <th class="text-center" width="200px">Nhà thầu</th>
                                            <th class="text-center" width="150px">Loại phương tiện</th>
                                            <th class="text-center" width="150px">Biển số</th>
                                            <th class="text-center" width="150px">Thời hạn</th>
                                            <th class="text-center" width="150px">Tình Trạng</th>
                                            <th class="text-center" width="150px">Người chỉnh sửa</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int stt = (ViewBag.Page - 1) * ViewBag.PageSize + 1;
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        <!-- Nút Xóa -->
                                                        <button type="button" class="btn btn-sm btn-danger btn-delete-xe" data-id="@item.ID">
                                                            <i class="fa fa-trash"></i> Xóa
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-sm btn-primary btn-edit-xe"
                                                                data-id="@item.ID"
                                                                data-toggle="modal"
                                                                data-target="#modalEdit">
                                                            <i class="fa fa-edit"></i> Sửa
                                                        </button>
                                                    </td>
                                                    <td class="text-center">@stt</td>
                                                    <td class="text-center">@item.TenNhaThau</td>
                                                    <td class="text-center">@item.LoaiPhuongTien</td>
                                                    <td class="text-center">@item.BienSoXe</td>
                                                    <td class="text-center">
                                                        @(item.TuNgay.HasValue ? item.TuNgay.Value.ToString("dd/MM/yyyy") : "")
                                                        –
                                                        @(item.DenNgay.HasValue ? item.DenNgay.Value.ToString("dd/MM/yyyy") : "")
                                                    </td>
                                                    <td class="text-center">
                                                        @{
                                                            var t = item.TTHD ?? 0;
                                                            var text = t == 1 ? "Hoạt động" : t == 2 ? "Hết hạn" : t == 3 ? "Đã khóa" : "";
                                                            var cls = t == 1 ? "badge badge-success"
                                                                     : t == 2 ? "badge badge-warning"
                                                                     : t == 3 ? "badge badge-secondary"
                                                                     : "badge badge-light";
                                                        }
                                                        <span class="@cls">@text</span>
                                                    </td>
                                                    <td class="text-center"> @item.HoVaTenUser_Edit</td>
                                                </tr>
                                                stt++;
                                            }
                                        }
                                    </tbody>
                                </table>
                                <div class="pager">
                                    @Html.PagedListPager(Model, page => Url.Action("DanhSachXe", "TheXeCoDong_NT", new
                                       {
                                           area = "TagSign",
                                           page,
                                           begind = ViewBag.BeginDate,
                                           endd = ViewBag.EndDate,
                                           search = ViewBag.Search,
                                           nhaThauId = ViewBag.NhaThauId,
                                           loaiPhuongTien = ViewBag.LoaiPhuongTien,
                                           TrangThai = ViewBag.TrangThai

                                       }))
                                    <span class="pageoff">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner">

            </div>
        </div>
    </div>


</div>
<!-- Modal sửa xe (id = modalEdit) -->
<div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <form id="form-edit">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalEditLabel">Cập nhật thông tin xe</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="edit-ID" name="ID" />

                    <div class="form-group">
                        <label>Biển số</label>
                        <input type="text" id="edit-BienSoXe" name="BienSoXe" class="form-control" />
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Từ ngày</label>
                            <input type="date" id="edit-TuNgay" name="TuNgay" class="form-control" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Đến ngày</label>
                            <input type="date" id="edit-DenNgay" name="DenNgay" class="form-control" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Loại phương tiện</label>
                            <select id="edit-ID_LoaiPhuongTien" name="ID_LoaiPhuongTien" class="form-control">
                                <option value="">-- Chọn --</option>
                                <option value="1">XE MÁY</option>
                                <option value="2">XE BA GÁC</option>
                                <option value="3">XE Ô TÔ</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Trạng thái hoạt động</label>
                            <select id="edit-TTHD" name="TTHD" class="form-control">
                                <option value="">-- Chọn --</option>
                                <option value="1">Hoạt động</option>
                                <option value="2">Hết hạn</option>
                                <option value="3">Đã khóa</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="text/javascript">
    //$('#btn-add').click(function () {
    //    var url = $('#myModal').data('url');
    //    $.get(url, function (data) {
    //        $("#myModal").html(data);
    //        $("#ModalTitle").html("Thêm tiêu đề");
    //        $("#myModal").modal('show');
    //    });
    //});
    $(function () {
        $(".chosen-select").chosen({
            width: "100%",
            no_results_text: "Không tìm thấy nhà thầu!"
        });
    });
    $('#btn-Import').click(function () {
        var url = $('#myModalImport').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Add Permission");
            $("#myModal").modal('show');
        });
    });

    $("#btn-search").on('click', function () {
    var begind = $('#begind').val();
    var endd = $('#endd').val();
    var search = $('#search').val();
    var nhaThauId = $('#nhaThauId').val();
    var loaiPhuongTien = $('#loaiPhuongTien').val();
    var trangThai = $('#TrangThai').val() || '';
    // Hiện overlay loading
        $("#importOverlay").show();

    window.location.href = '@Url.Action("DanhSachXe", "TheXeCoDong_NT")'
        + '?begind=' + encodeURIComponent(begind)
        + '&endd=' + encodeURIComponent(endd)
        + '&search=' + encodeURIComponent(search)
        + '&nhaThauId=' + encodeURIComponent(nhaThauId)
        + '&loaiPhuongTien=' + encodeURIComponent(loaiPhuongTien)
        + '&TrangThai=' + encodeURIComponent(trangThai);
    });
    $("#btn-import-excel").click(function () {
        $("#fileImportExcel").click();
    });

