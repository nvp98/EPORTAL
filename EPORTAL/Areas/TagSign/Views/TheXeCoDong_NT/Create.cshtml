}
<script type="text/javascript">
    //$("#NhaThau_ID").chosen({
    //    width: "100%",
    //});
    $("#IDTK").chosen({
        width: "100%"
    });
    $("#IDLTK").chosen({
        width: "100%"
    });

    $("#PhongBan_ID").chosen({
        width: "100%"
    });
    $('#btn-add-ds').click(function () {
        var url = $('#myModal_add').data('url');
        $.get(url, function (data) {
            $("#myModal_add").html(data);
            $("#ModalTitle").html("Thêm Dự án");
            $("#myModal_add").modal('show');
        });
    });
    $('#btn-Download').click(function () {
        var url = $('#myModal_Download').data('url');
        $.get(url, function (data) {
            $("#myModal_Download").html(data);
        });
    });

     function submitImport() {
        const fileInput = document.getElementById("FileImportExcel");
        const file = fileInput.files[0];

        if (!file) {
            alert("Vui lòng chọn file Excel.");
            return;
        }

        const formData = new FormData();
        formData.append("FileANH", file);

        $.ajax({
            url: '@Url.Action("ImportExcel", "TheXeCoDong_NT")',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    danhSachData = res.data;
                    renderDanhSach(res.data);
                } else {
                    alert("Lỗi import: " + res.message);
                }
            },
            error: function () {
                alert("Có lỗi xảy ra khi import.");
            }
        });
    }

    let danhSachData = [];
    function renderDanhSach(data) {

        let html = "";
     // console.log('data', data)
        data.forEach((item, i) => {
            console.log("DenNgay render:", item.DenNgay); 
            html += `
            <tr>
                <td>${i + 1}</td>
                 <td>
                    <input type="checkbox" class="cb-loai" data-group="${i}" style="width: 100%;" ${item.ID_LoaiPhuongTien === 1 ? "checked" : ""} />
                </td>
                <td>
                    <input type="checkbox" class="cb-loai" data-group="${i}" style="width: 100%;" ${item.ID_LoaiPhuongTien === 2 ? "checked" : ""} />
                </td>
                <td>
                    <input type="checkbox" class="cb-loai" data-group="${i}" style="width: 100%;" ${item.ID_LoaiPhuongTien === 3 ? "checked" : ""} />
                </td>
                <td><input type="text" name="Items[${i}].BienSoXe"  style=" width: 100%" value="${item.BienSoXe}" class="form-control" /></td>
                <td><input type="checkbox" class="cb-cap" data-group="${i}" name="Items[${i}].CapMoi"  style=" width: 100%" value="true" ${item.CapMoi ? "checked" : ""} /></td>
                <td><input type="checkbox" class="cb-cap" data-group="${i}" name="Items[${i}].CapLai"  style=" width: 100%" value="true" ${item.CapLai ? "checked" : ""} /></td>
                <td><input type="checkbox" class="cb-cap" data-group="${i}" name="Items[${i}].GiaHan"  style=" width: 100%" value="true" ${item.GiaHan ? "checked" : ""} /></td>
                <td>                  
                   <input type="date" name="Items[${i}].DenNgay" 
                   value="${item.DenNgay ? item.DenNgay.split('T')[0] : ''}" 
                   class="form-control" />
                </td>
                <td><input type="text" name="Items[${i}].GhiChu" value="${item.GhiChu}" class="form-control" /></td>
                 <td class="text-center">
                <button type="button" class="btn btn-danger btn-sm btnRemoveRow" data-index="${i}">X</button>
                 </td>
            </tr>`;
        });

        $("#tbodyImportExcel").html(html);
        setupSingleSelectCheckboxes("cb-loai");
        setupSingleSelectCheckboxes("cb-cap");
    }
    $("#btnAddRow").on("click", function () {
        const newItem = {
            ID_LoaiPhuongTien: null,
            BienSoXe: "",
            CapMoi: false,
            CapLai: false,
            GiaHan: false,
            TuNgay: "",
            DenNgay: "",
            GhiChu: ""
        };
        danhSachData.push(newItem);  // danhSachData là mảng dữ liệu hiện có
        renderDanhSach(danhSachData); // Gọi lại render để vẽ dòng mới
    });
    $("#tbodyImportExcel").on("click", ".btnRemoveRow", function () {
        const index = $(this).data("index");
        if (index !== undefined) {
            danhSachData.splice(index, 1);
            renderDanhSach(danhSachData);
        }
    });
 function setupSingleSelectCheckboxes(className) {
    $("." + className).off("change").on("change", function () {
        const group = $(this).data("group");
        $("." + className + "[data-group='" + group + "']").not(this).prop("checked", false);
    });
}
    // submit form
    function submitForm(event) {
        event.preventDefault();

        // Lấy thông tin chung
        var formData = new FormData();
        formData.append("NoiDung", $("#NoiDung").val());
        formData.append("NhaThau_ID", $("#NhaThau_ID").val());
        formData.append("PhongBan_ID", $("#PhongBan_ID").val());
        console.log(formData)
        // File hồ sơ xe
        var fileHoSoXE = $("#FileHoSoXE")[0].files[0];
        if (fileHoSoXE) {
            formData.append("FileHoSoXE", fileHoSoXE);
        }
        formData.append("KTV_ID", $("#KTV_QL").val());
        formData.append("TP_ID", $("#TP_QL").val());
        formData.append("VP1C_ID", $("#VP1C").val());
        // Lấy danh sách xe từ bảng
        var listXe = [];
        $("#tbodyImportExcel tr").each(function () {
            var row = $(this);
            var xe = {
                ID_LoaiPhuongTien: row.find("input[type=checkbox]").eq(0).is(":checked") ? 1 :
                                   row.find("input[type=checkbox]").eq(1).is(":checked") ? 2 :
                                   row.find("input[type=checkbox]").eq(2).is(":checked") ? 3 : 0,
                BienSoXe: row.find("input[name*='BienSoXe']").val(),
                CapMoi: row.find("input[name*='CapMoi']").is(":checked"),
                CapLai: row.find("input[name*='CapLai']").is(":checked"),
                GiaHan: row.find("input[name*='GiaHan']").is(":checked"),
                TuNgay: null,
                DenNgay: row.find("input[type=date]").val(),
                GhiChu: row.find("input[name*='GhiChu']").val()
            };
            listXe.push(xe);
        });

        formData.append("JsonDanhSachXe", JSON.stringify(listXe));
        //console.log('formData', formData)
        $.ajax({
            url: '@Url.Action("Create", "TheXeCoDong_NT")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.success) {
                    alert("Thêm thành công! Mã đơn: " + res.maDon);
                     window.location.href = '@Url.Action("Index_Test", "TheXeCoDong_NT")';
                } else {
                    alert("Lỗi: " + res.message);
                }
            },
            error: function () {
                alert("Có lỗi khi gọi server.");
            }
        });
}
    $("#btnSave").click(function (e) {
        e.preventDefault();

        // Lấy danh sách xe từ bảng hiện tại
        var listXe = [];
        $("#tbodyImportExcel tr").each(function () {
            var row = $(this);
            var xe = {
                ID_LoaiPhuongTien: row.find("input[type=checkbox]").eq(0).is(":checked") ? 1 :
                    row.find("input[type=checkbox]").eq(1).is(":checked") ? 2 :
                        row.find("input[type=checkbox]").eq(2).is(":checked") ? 3 : 0,
                CapMoi: row.find("input[name*='CapMoi']").is(":checked")
            };
            listXe.push(xe);
        });

        // Đếm số xe máy mới, xe 3 gác mới
        var soXeMayMoi = listXe.filter(x => x.ID_LoaiPhuongTien === 1 && x.CapMoi).length;
        var soXe3GacMoi = listXe.filter(x => x.ID_LoaiPhuongTien === 3 && x.CapMoi).length;

        // Kiểm tra vượt định biên
        if (dinhBienPhuongTien) {
            if (soXeMayMoi > dinhBienPhuongTien.XeMay_ConLai || soXe3GacMoi > dinhBienPhuongTien.Xe3Gac_ConLai) {
                alert(`Vượt định biên: Xe máy (còn lại ${dinhBienPhuongTien.XeMay_ConLai}, đăng ký ${soXeMayMoi}), `
                    + `Xe 3 gác (còn lại ${dinhBienPhuongTien.Xe3Gac_ConLai}, đăng ký ${soXe3GacMoi})`);
                return; // KHÔNG gọi submitForm!
            }
        }

        // Nếu hợp lệ, gọi submitForm như cũ
        submitForm(e);
    });
    let dinhBienPhuongTien = null;
    $(document).ready(function () {
        $.ajax({
            url: '@Url.Action("GetDinhBienPhuongTien", "TheXeCoDong_NT")',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res.success) {
                    dinhBienPhuongTien = res.data;
                    //console.log(dinhBienPhuongTien)
                    const data = res.data;

                    const html = `
                                <div style="display: flex; gap: 20px;">
                                    <div style="flex: 1;">
                                        <div><b>Xe máy đã cấp:</b> ${data.XeMay_DaCap}</div>
                                        <div><b>Định biên xe máy tối đa:</b> ${data.XeMay_ToiDa}</div>
                                        <div><b>Định biên xe máy còn lại:</b> ${data.XeMay_ConLai}</div>
                                    </div>
                                    <div style="flex: 1;">
                                        <div><b>Xe 3 gác đã cấp:</b> ${data.Xe3Gac_DaCap}</div>
                                        <div><b>Định biên xe 3 gác tối đa:</b> ${data.Xe3Gac_ToiDa}</div>
                                        <div><b>Định biên xe 3 gác còn lại:</b> ${data.Xe3Gac_ConLai}</div>
                                    </div>
                                </div>
                            `;


                    $('#tdDinhBienPhuongTien').html(html);
                } else {
                    $('#tdDinhBienPhuongTien').html(`<span style="color:red;">${res.message}</span>`);
                }
            },
            error: function () {
                $('#tdDinhBienPhuongTien').html('<span style="color:red;">Lỗi khi tải dữ liệu.</span>');
            }
        });
    });
    $(document).ready(function () {
            $("#PhongBan_ID").change(function () {
                var idPhongBan = $(this).val();
                if (idPhongBan) {
                    $.ajax({
                        url: '@Url.Action("GetNguoiKyTheoPhongBan", "TheXeCoDong_NT")', // thay TenController bằng tên thực tế
                        type: 'GET',
                        data: { idPhongBan: idPhongBan },
                        success: function (data) {
                            if (data.success) {
                                // Gán danh sách KTV
                                var ktvSelect = $("#KTV_QL");
                                ktvSelect.empty().append('<option value="">--Chọn KTV--</option>');
                                $.each(data.ktvList, function (i, item) {
                                    ktvSelect.append($('<option>', {
                                        value: item.ID,
                                        text: item.HoTen
                                    }));
                                });

                                // Gán danh sách TP
                                var tpSelect = $("#TP_QL");
                                tpSelect.empty().append('<option value="">--Chọn Trưởng/Phó--</option>');
                                $.each(data.tpList, function (i, item) {
                                    tpSelect.append($('<option>', {
                                        value: item.ID,
                                        text: item.HoTen
                                    }));
                                });
                            }
                        },
                        error: function () {
                            alert("Lỗi khi tải danh sách người ký");
                        }
                    });
                }
            });
        });
</script>







