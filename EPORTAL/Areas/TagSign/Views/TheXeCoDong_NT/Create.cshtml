                                <thead>
                                    <tr style="background-color: #f8f9fa;">
                                        <th class="text-center" rowspan="2" width="10px" rowspan="2" style="vertical-align:middle">TT</th>
                                        <th class="text-center" colspan="3" width="100px" style="vertical-align:middle">Đánh dấu "X" vào những ô cần chọn</th>
                                        <th class="text-center" rowspan="2" width="60px" style="vertical-align:middle">Biển số xe</th>
                                        <th class="text-center" colspan="3" width="100px" style="vertical-align:middle">Đánh dấu "X" vào những ô cần chọn</th>
                                        <th class="text-center" rowspan="2" width="50px" style="vertical-align:middle">Thời hạn thẻ xe cơ động</th>
