# Copy file nay thanh `EPORTAL/.env` (cung thu muc voi Global.asax/Web.config)
# va dien gia tri thuc. Tren production, dat file trong physical path cua IIS app.
# File `.env` da gitignore - khong commit secret len repo.
# Load tu Global.asax.cs (Application_Start) -> Environment.SetEnvironmentVariable.

# OpenAI API key - cho LLM (gpt-4.1-mini text generation) + Realtime voice (optional)
OPENAI_API_KEY=sk-proj-xxxxx

# VBee.vn - TTS tieng Viet native + STT realtime
# Tao app + token o: https://studio.vbee.vn/apps -> "API Integration" -> Create Application
VBEE_API_TOKEN=vbee_xxxxxxxxxxxxxx
VBEE_ID_APP=xxxxxxxxxxxx

# Chatbot TTS (VBee) - giong doc to cau tra loi.
#   - Khong set -> fallback giong NU 'hn_female_ngochuyen_full_48k-fhg' (sync, gioi han 300 ky tu => cau dai bi cat).
#   - Suffix '-phg' (vd hn_male_manhdung_news_48k-phg) => duong async, toi da ~4000 ky tu, khong bi ngat.
CHATBOT_VBEE_VOICE=hn_male_manhdung_news_48k-phg
CHATBOT_VBEE_SPEED=1.0
# Gioi han ky tu giong async (mac dinh 4000, toi da 10000)
CHATBOT_VBEE_ASYNC_MAX_CHARS=4000
# So giay toi da poll VBee async cho 1 cau (mac dinh 60, kep 15..120)
CHATBOT_VBEE_ASYNC_POLL_SECONDS=60

# === Chatbot - BAO VE response tu dich vu ngoai (ExternalContentGuard) ===
# Allowlist host cho audioLink VBee tra ve (csv suffix, vd "vbee.vn,vbee.ai").
# KHONG set -> chi ap guard chung: bat buoc HTTPS + chan link tro ve IP noi bo (SSRF).
# Set khi muon siet chat (luu y: neu VBee phat audio qua CDN khac domain thi phai them vao day).
#CHATBOT_VBEE_AUDIO_HOSTS=vbee.vn
# Kich thuoc audio TTS toi da chap nhan tu VBee (bytes, mac dinh 20MB)
#CHATBOT_TTS_MAX_AUDIO_BYTES=20971520

# === Chatbot - MODEL OpenAI ===
# Khong set -> default trong code (gpt-4.1-mini cho stream). Set de prod chot 1 model + max tokens.
CHATBOT_MODEL=gpt-4.1-mini
CHATBOT_MAX_TOKENS=800

# === Chatbot - GIOI HAN SU DUNG / QUOTA (chong dot tien) ===
# Tat ca optional: khong set -> dung default trong code. Set <=0 (hoac 0) o cho ghi chu = TAT gioi han do.
# -- OpenAI (chat) --
CHATBOT_RATE_LIMIT_PER_HOUR=60          # so cau hoi / gio / user
CHATBOT_DAILY_TOKENS_PER_USER=1000000   # tran token (TokensIn+Out) / ngay / user; <=0 = tat
CHATBOT_DAILY_TOKENS_GLOBAL=0           # tran token / ngay toan he thong; 0 = tat
# -- VBee TTS (doc) -- bill theo ky tu
CHATBOT_TTS_CALLS_PER_HOUR=600          # so call doc / gio / user
CHATBOT_DAILY_TTS_CALLS_PER_USER=3000   # so call doc / ngay / user; <=0 = tat
# -- VBee STT (nhan giong) -- bill theo giay
CHATBOT_STT_CALLS_PER_HOUR=60           # so call nhan giong / gio / user
CHATBOT_DAILY_STT_CALLS_PER_USER=300    # so call nhan giong / ngay / user; <=0 = tat
# -- OpenAI Realtime voice (dat tien, hien dormant) --
CHATBOT_REALTIME_SESSIONS_PER_HOUR=10   # so phien thoai realtime / gio / user
# CHATBOT_REALTIME_MODEL=gpt-realtime-2
# CHATBOT_REALTIME_VOICE=nova
# CHATBOT_REALTIME_VAD=semantic_vad

# === Chatbot - KNOWLEDGE CACHE (bo nho tu hoc: cache cau tra loi + audio, LLM Curator duyet) ===
# Hit -> tra loi tu DB, bo qua OpenAI/VBee. Can chay migration v360-all.sql (bang V360_ChatbotKnowledge/AudioCache).
CHATBOT_KB_ENABLED=true                  # bat/tat knowledge cache (false = luon goi OpenAI nhu cu)
CHATBOT_KB_SIM_THRESHOLD=0.92            # nguong cosine de coi la "trung cau hoi" (semantic). Cao = chat hon
CHATBOT_KB_MIN_SCORE=85                  # diem Curator toi thieu de cache + de phuc vu tu cache
CHATBOT_EMBED_MODEL=text-embedding-3-small
CHATBOT_CURATOR_MODEL=gpt-4.1-mini

# === DB Clone credentials (scripts\db-clone.ps1) ===
# SHARED-DEV mat khau (read-only export source). Hoi devops/team lead.
EPORTAL_SRC_PWD=
# LOCAL SQL Server sa password (import target).
EPORTAL_DST_PWD=
